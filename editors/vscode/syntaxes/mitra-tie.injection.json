{
  "scopeName": "mitra.tie.injection",
  "injectionSelector": "L:source.rust comment.line.double-slash",
  "patterns": [
    {
      "match": "(mitra:)\\s+(implements|evidence for)\\s+([A-Za-z_][A-Za-z0-9_:]*)(.*)$",
      "captures": {
        "1": { "name": "keyword.control.mitra.tie" },
        "2": { "name": "keyword.other.mitra.tie" },
        "3": { "name": "entity.name.function.mitra.tie" },
        "4": { "patterns": [{ "include": "source.mitra" }] }
      }
    }
  ]
}
