{
  "name": "mitra",
  "displayName": "Mitra",
  "description": "Syntax highlighting for Mitra models (.mitra) and for `// mitra:` tie comments in Rust.",
  "version": "0.1.0",
  "publisher": "mitra",
  "license": "MIT",
  "engines": { "vscode": "^1.60.0" },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [
      {
        "id": "mitra",
        "aliases": ["Mitra", "mitra"],
        "extensions": [".mitra"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mitra",
        "scopeName": "source.mitra",
        "path": "./syntaxes/mitra.tmLanguage.json"
      },
      {
        "scopeName": "mitra.tie.injection",
        "path": "./syntaxes/mitra-tie.injection.json",
        "injectTo": ["source.rust"]
      }
    ]
  }
}
