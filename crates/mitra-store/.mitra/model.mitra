// mitra-store as Mitra sees it. Start here.
//
// mitra-store is everything Mitra keeps on a disk. mitra-lang reads no
// file: this crate finds the files of a model, reads them, and hands
// them over as named texts. It also keeps the ledger file.
//
//   disk.mitra     the boundary: what the file system is taken to do
//   model.mitra    reading model files and what they import (this file)
//   store.mitra    the `.mitra/` folder of a project
//   ledger.mitra   the ledger file: what is true of it today, and what
//                  was agreed in outline and is not built
//
// The types of mitra-lang (`Modules`) are named here and tied in
// mitra-lang's own model: a record does not cross stores.

import std::rust::{Option, Result};

// The files of one model as named texts: mitra-lang's, stated there.
record Modules;

subject files {
    require disk_reads = disk::reads_what_was_written;

    ensure handed_unchanged = "A model file is handed to mitra-lang under its path, with its text unchanged.";
    ensure imports_beside = "`import a::b::x;` is answered by the file `a/b.mitra` beside the first model file, and by what that file imports in turn.";
    ensure missing_is_said_at_the_import = "A file that can't be read for an import does not stop the reading: why is handed over, and said at the line of the import.";

    // The text of a file, or why it can't be read, with its path.
    fn read(path: String) -> Result<String, String>
        uses disk::read_to_string;

    // One model file, with what it imports.
    fn file(path: String) -> Result<Modules, String>
        uses disk::read_to_string;
}
