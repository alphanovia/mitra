// The file system, as Mitra takes it to behave (std::fs, std::env).
//
// A boundary: nothing here is Mitra's to fix. Each `ensure` is a promise
// of the world that mitra-store leans on; each `assume` says it
// formally.

import std::rust::{Option, Result};

boundary disk {
    ensure reads_what_was_written = "Reading a file gives the whole text last written to it.";
    ensure lists_what_is_there = "Listing a folder gives every file in it.";
    ensure appends_at_the_end = "Appending to a file leaves what was there untouched and adds the text after it.";
    ensure ledger_is_left_alone = "Between two commands nobody rewrites the ledger file. It is a plain text file: nothing stops a person, an editor or a merge from changing it, so this is an assumption and no more.";

    fn read_to_string(path: String) -> Result<String, String>;
    fn read_dir(path: String) -> Result<Vec<String>, String>;
    fn append(path: String, text: String) -> Result<(), String>;
    fn write(path: String, text: String) -> Result<(), String>;
    fn current_dir() -> Result<String, String>;

    // Two reads with no write between them give the same text.
    assume read_is_stable(path: String) {
        read_to_string(path) == read_to_string(path)
    }
}
