// The ledger file of a store, `model/evidence.mitra` (src/store.rs).
//
// What an entry means is mitra-lang's (its ledger.mitra). Here: how the
// file is kept.

import std::core::{Option, Result};

// What main does today.
subject ledger {
    require reads = disk::reads_what_was_written;
    require appends = disk::appends_at_the_end;
    require left_alone = disk::ledger_is_left_alone;

    ensure reads_back = "Reading the ledger gives exactly what was written to it.";
    ensure keeps_who_and_when = "An entry is written with who said it and on which revision, as they were given with it.";
    ensure sound_or_untouched = "Evidence is added only when the store with it still reads and evaluates: on an error nothing is written.";

    impl Store {
        // Evidence blocks, stamped with who says so and on which revision.
        // Gives how many pieces were added.
        fn add(&self, text: String, source: Option<String>, rev: Option<String>) -> Result<Nat, String>
            uses Store::append;
        // Checks the store with the new evidence, then writes it.
        fn append(&self, new: String) -> Result<(), String>
            uses disk::read_to_string, disk::append;
    }
}

// How the ledger is kept over time. Agreed in outline with the user on
// 2026-11-19; the details are choices to review (review increment 70).
//
// The ledger is not append-only. What a machine observed is a snapshot:
// its next run writes it again. What a person said stays, even when its
// piece is gone or reads otherwise (mitra-lang then sets it aside and
// every report shows it), until `mitra remove` takes it out.

subject keeping {
    require ledger_reads = ledger::reads_back;
    require left_alone = disk::ledger_is_left_alone;

    ensure nothing_leaves_unshown = "Nothing leaves the ledger without being shown: every entry taken out is given back as it was written.";
    ensure machine_is_a_snapshot = "Evidence observed by a machine (ties, test results, samples) is a snapshot of one revision: each run of that machine takes out what it wrote before and writes again, and says what it replaced.";
    ensure human_is_never_dropped_silently = "Evidence said by a person (a vouch, a review, a bug report) is never taken out by a run of a machine: when its piece is gone or was reworded it stays in the ledger, where it is listed as orphaned or stale and counts for nothing, and waits for a decision.";
    ensure removal_is_explicit = "Removing what a person said is an act of its own, `mitra remove`, which lists what goes.";
    ensure sound_or_untouched = "The ledger is rewritten only when the store with it still reads and evaluates: on an error it is left as it was.";

    // What a run of a machine put in place of its earlier evidence.
    record Replaced {
        // How many entries of that machine left, and their revisions.
        before: Nat,
        revs: List<String>,
        written: Nat,
        // Those with nothing written in their place, as written.
        gone: List<String>,
    }

    // The entries `mitra remove` takes out.
    enum Which {
        Orphaned,
        Stale(piece: Option<String>),
        Source(who: String),
        Piece(name: String)
    }

    impl Store {
        // Every entry whose source starts with `prefix` leaves, `new` is
        // written in its place.
        fn replace(&self, prefix: String, new: String) -> Result<Replaced, String>
            uses disk::read_to_string, disk::write;
        // The entries picked leave; they are given back as written.
        fn remove(&self, which: Which) -> Result<List<String>, String>
            uses disk::read_to_string, disk::write;
    }
}
