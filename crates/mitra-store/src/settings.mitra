// The dogfood model of `src/settings.rs`: core2 modelled in its own
// language, beside the code it models (the parts it uses are read by
// `use … from`). The whole model: `mitra check src/bin/mitra.mitra`.

subject settings {
    use agree from "agree";
    use blame from "blame";
    use explain from "explain";
    use numbers from "numbers";
    use parse from "parse";
    // The settings of every layer, each its part's: as Rust has them.
    subject record Settings at "crates/mitra-store/src/settings.rs/Settings" {
        parse: parse::Settings, agree: agree::Settings, explain: explain::Settings, numbers: numbers::Settings, blame: blame::Settings, test: Test, search: Search, arithmetic: Arithmetic
    }
    // `mitra mc` and `mitra search`'s (dry run): the symbolic run's and
    // the budget not modelled yet.
    subject record Search at "crates/mitra-lang/src/search.rs/Settings" { shown: integer, steps: integer, reach: integer, .. }
    // `[model]`: what the model's arithmetic does (dry run).
    subject enum Overflow at "crates/mitra-lang/src/simulation.rs/Overflow" { Fail, Wrap, Clamp }
    subject enum Division at "crates/mitra-lang/src/simulation.rs/Division" { TowardZero, Floor }
    subject record Arithmetic at "crates/mitra-lang/src/simulation.rs/Arithmetic" { overflow: Overflow, division: Division }
    // The program run, and its arguments.
    subject record Test at "crates/mitra-store/src/settings.rs/Test" { command: [[~char]] }
    fn read(text: [~char]) -> s: Settings at "crates/mitra-store/src/settings.rs/read";
    ensure sections: "mitra.toml gives each layer's settings a section by the code's names, one `[budget]` for agree and explain, parse's depth twice budget's when not said, `[test] command` what explain runs with no report; an empty file changes nothing";
    ensure nothing_unread: "a section, a key or a value Mitra does not take is P015 where it is: a count a whole number, a weight written with its point, no number made another";
}
