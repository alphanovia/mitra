// The tests of the code. Each one is the `fn` of the same name in the
// Rust file named above it, and what its pass stands for.

// src/report.rs

test t_short_path {
    for report::short
    given path = "tests::t_small"
    gives "t_small"
}

test t_short_plain {
    for report::short
    given path = "t_small"
    gives "t_small"
}

test t_short_should_panic {
    for report::short
    given path = "t_panics - should panic"
    gives "t_panics"
}

test t_short_panics_once {
    for report::short
    given path = "t_panics"
    gives "t_panics"
}

test t_libtest_ok {
    for report::libtest
    given text = "test tests::t_small ... ok"
    gives [Outcome("t_small", true)]
}

test t_libtest_failed {
    for report::libtest
    given text = "test t_big ... FAILED"
    gives [Outcome("t_big", false)]
}

test t_libtest_timed {
    for report::libtest
    given text = "test t_timed ... ok <0.001s>"
    gives [Outcome("t_timed", true)]
}

test t_libtest_ignored {
    for report::libtest
    given text = "test tests::slow ... ignored"
    gives []
}

test t_libtest_other_lines {
    for report::libtest
    given text = "running 3 tests\ntest result: FAILED. 1 passed; 1 failed"
    gives []
}

test t_libtest_two {
    for report::libtest
    given text = "test a ... ok\ntest b ... FAILED"
    gives [Outcome("a", true), Outcome("b", false)]
}

test t_attr_double {
    for report::attr
    given tag = "<testcase name=\"t\""
    given attr = "name"
    gives Some("t")
}

test t_attr_single {
    for report::attr
    given tag = "<testcase name='t'"
    given attr = "name"
    gives Some("t")
}

test t_attr_missing {
    for report::attr
    given tag = "<testcase time=\"1\""
    given attr = "name"
    gives None
}

test t_attr_inside_another {
    for report::attr
    given tag = "<testcase\tclassname=\"name=x\" name = \"t\""
    given attr = "name"
    gives Some("t")
}

test t_attr_entities {
    for report::attr
    given tag = "<a name=\"a &lt; b &amp;lt;\""
    given attr = "name"
    gives Some("a < b &lt;")
}

test t_strip_one {
    for report::strip
    given text = "a<x>b</x>c"
    given open = "<x>"
    given close = "</x>"
    gives "ac"
}

test t_strip_unclosed {
    for report::strip
    given text = "a<x>b"
    given open = "<x>"
    given close = "</x>"
    gives "a"
}

test t_strip_nothing {
    for report::strip
    given text = "abc"
    given open = "<x>"
    given close = "</x>"
    gives "abc"
}

test t_junit_passed {
    for report::junit
    given xml = "<testcase classname=\"add\" name=\"t\"/>"
    gives [Outcome("t", true)]
}

test t_junit_failure {
    for report::junit
    given xml = "<testcase name=\"t\"><failure message=\"boom\"/></testcase>"
    gives [Outcome("t", false)]
}

test t_junit_error {
    for report::junit
    given xml = "<testcase name=\"t\"><error/></testcase>"
    gives [Outcome("t", false)]
}

test t_junit_skipped {
    for report::junit
    given xml = "<testcase name=\"t\"><skipped/></testcase>"
    gives []
}

test t_junit_failure_in_a_log {
    for report::junit
    given xml = "<testcase name='t'><system-out><![CDATA[ <failure> ]]></system-out></testcase>"
    gives [Outcome("t", true)]
}

test t_junit_path {
    for report::junit
    given xml = "<testcase name=\"tests::t\"/>"
    gives [Outcome("t", true)]
}

// src/source.rs

test t_line_doc {
    for source::mitra_line
    given line = "/// mitra: claim c : correct(f(1))"
    gives Some("claim c : correct(f(1))")
}

test t_line_plain {
    for source::mitra_line
    given line = "    // mitra: claim c : correct(f(1))"
    gives Some("claim c : correct(f(1))")
}

test t_line_keeps_indent {
    for source::mitra_line
    given line = "// mitra:   then 1"
    gives Some("  then 1")
}

test t_line_comment {
    for source::mitra_line
    given line = "// a comment about mitra: no"
    gives None
}

test t_line_code {
    for source::mitra_line
    given line = "let x = 1; // mitra: claim c : correct(f(1))"
    gives None
}

test t_below_plain {
    for source::fn_below
    given code = "fn f() {}"
    gives Some("f")
}

test t_below_qualified {
    for source::fn_below
    given code = "pub(crate) const unsafe fn f() {}"
    gives Some("f")
}

test t_below_attribute {
    for source::fn_below
    given code = "#[cfg_attr(test, allow(unused))]\npub async fn f<T>() {}"
    gives Some("f")
}

test t_below_struct {
    for source::fn_below
    given code = "pub struct S;\nfn f() {}"
    gives None
}

test t_below_nothing {
    for source::fn_below
    given code = ""
    gives None
}

test t_words_plain {
    for source::words
    given line = "opaque f(a: Int) -> Int"
    gives ["opaque", "f", "a", "Int", "Int"]
}

test t_words_comment {
    for source::words
    given line = "claim c -- a test of opaque things"
    gives ["claim", "c"]
}

test t_words_string {
    for source::words
    given line = "claim c : correct(g(\"test -- \\\" opaque\")) -- x"
    gives ["claim", "c", "correct", "g"]
}

test t_extract_one {
    for source::extract
    given text = "// mitra: claim c : correct(f(1))"
    gives Ok([(1, "claim c : correct(f(1))")])
}

test t_extract_none {
    for source::extract
    given text = "// a comment about mitra: no"
    gives Ok([])
}

test t_extract_aligned {
    for source::extract
    given text = "// mitra: opaque f(a: Bool) -> Bool\n#[inline] pub fn f() {}"
    gives Ok([(1, "opaque f(a: Bool) -> Bool")])
}

test t_extract_misaligned {
    for source::extract
    given text = "// mitra: opaque add(a: Int) -> Int\nfn sub() {}"
    gives Err((1, "`opaque add` must sit above `fn add`, found `fn sub`"))
}

test t_extract_alone {
    for source::extract
    given text = "// mitra: test t : correct(f(1))"
    gives Err((1, "`test t` must sit above `fn t`, found no function"))
}

test t_extract_in_a_string {
    for source::extract
    given text = "const A: &str = \"\n// mitra: claim a : correct(f(1))\n\";"
    gives Ok([])
}
