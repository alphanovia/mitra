-- Evidence, append-only: `mitra add` and `mitra ingest` write here.
@[source "test:t_attr_double", rev "afc7f950ce6c"] evidence correct(attr("<testcase name=\"t\"", "name")) at 1
@[source "test:t_attr_double", rev "afc7f950ce6c"] evidence attr("<testcase name=\"t\"", "name") = Some("t") at 1
@[source "test:t_attr_entities", rev "afc7f950ce6c"] evidence correct(attr("<a name=\"a &lt; b &amp;lt;\"", "name")) at 1
@[source "test:t_attr_entities", rev "afc7f950ce6c"] evidence attr("<a name=\"a &lt; b &amp;lt;\"", "name") = Some("a < b &lt;") at 1
