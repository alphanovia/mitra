@[source "test:t_attr_inside_another", rev "afc7f950ce6c"] evidence attr("<testcase\tclassname=\"name=x\" name = \"t\"", "name") = Some("t") at 1
@[source "test:t_attr_missing", rev "afc7f950ce6c"] evidence correct(attr("<testcase time=\"1\"", "name")) at 1
@[source "test:t_attr_missing", rev "afc7f950ce6c"] evidence attr("<testcase time=\"1\"", "name") = None at 1
@[source "test:t_attr_single", rev "afc7f950ce6c"] evidence correct(attr("<testcase name='t'", "name")) at 1
@[source "test:t_attr_single", rev "afc7f950ce6c"] evidence attr("<testcase name='t'", "name") = Some("t") at 1
