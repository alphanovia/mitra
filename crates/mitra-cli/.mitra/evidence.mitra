@[source "test:t_libtest_failed", rev "afc7f950ce6c"] evidence libtest("test t_big ... FAILED") = [Outcome("t_big", false)] at 1
@[source "test:t_libtest_ignored", rev "afc7f950ce6c"] evidence correct(libtest("test tests::slow ... ignored")) at 1
@[source "test:t_libtest_ignored", rev "afc7f950ce6c"] evidence libtest("test tests::slow ... ignored") = [] at 1
