@[source "test:t_junit_path", rev "afc7f950ce6c"] evidence junit("<testcase name=\"tests::t\"/>") = [Outcome("t", true)] at 1
@[source "test:t_junit_skipped", rev "afc7f950ce6c"] evidence correct(junit("<testcase name=\"t\"><skipped/></testcase>")) at 1
@[source "test:t_junit_skipped", rev "afc7f950ce6c"] evidence junit("<testcase name=\"t\"><skipped/></testcase>") = [] at 1
