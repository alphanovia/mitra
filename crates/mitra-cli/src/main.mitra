// core2, modelled in its own language: the dogfood model.
//
// One subject per module of src/, in the order the layers stand on each
// other; three environments for what core2 uses and does not write. Ties
// are in the model (`at "crates/<crate>/src/x.rs/…"`), so the code is not touched.
//
// What core2's language can write is numbers, truths, tuples and
// records. Most of core2 works on text, trees and maps: those functions
// and records are opaque here, and what they promise is an ensure, in
// words. Where core2 computes on numbers or truths (Rational, the
// states of judgement, Subjective Logic), the model has the body.
//
// Modelling choices, flagged for review (none is a new concept of the
// language):
// - `numbers::fused` takes takings in Rust; here it takes what they add
//   up to: weighted runs for and against, with the prior weight and the
//   base rate of the settings.
// - f64 in Rust, rational (exact) here: a measuring test compares within
//   1e-12, the row is exact.
//
// Split next to the code (user, 12:17): one file per module of src/,
// this one the whole: `cli` uses every layer.

subject cli {
    // Not used by the command line, read so the model is whole.
    use location from "location";
    use tactic from "tactic";
    use agree from "agree";
    use blame from "blame";
    use check from "check";
    use explain from "explain";
    use numbers from "numbers";
    use parse from "parse";
    use settings from "settings";
    require checked: check::sound;
    require agreed: agree::no_false_holds;
    require explained: explain::verdicts;
    require blamed: blame::minimal;
    require numbered: numbers::in_unit;
    require parsed: parse::first_error;
    require set: settings::nothing_unread;
    use cargo from "reader";
    require ran: cargo::reports;
    require tested: settings::sections;
    ensure answers: "check, explain and blame each answer their question; the exit code is 1 on a malformed model or evidence, 2 on a wrong command line, else 0"
        from (checked, agreed, explained, blamed, numbered, parsed, set);
    // The command is `[test] command` of mitra.toml, cargo's by default;
    // `--report` gives what tests printed instead, `--no-test` runs none.
    ensure runs_tests: "unless told not to, explain and blame run the project's test command at the root of a Rust project, and say how many tests ran, passed, failed and were ignored"
        from (ran, tested);
}
