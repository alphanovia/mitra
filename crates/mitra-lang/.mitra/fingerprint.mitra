// The fingerprint of a piece (src/fingerprint.rs).
//
// Twelve hex digits per piece of a model: a function, a claim, a record,
// an enum, a promise, a capture. It says whether the piece means today
// what it meant when somebody looked at it. Evidence said by a person
// keeps it (`seen "…"`); the build file will list it for every piece.

import std::rust::{Option};
import std::claims::{uniform};

subject fingerprint {
    ensure meaning_not_bytes = "The fingerprint of a piece comes from what it says: comments, spacing and the order of the declarations do not change it; another body, another type, another claim or another prose does.";
    ensure capture_follows_its_claims = "The fingerprint of a capture changes when the prose of its promise changes, and when a claim the promise rests on is added, removed or says something else.";
    ensure speaks_of_its_piece = "A name under a piece, such as `f::correct`, `f::tied` or `f::uses`, has the fingerprint of the piece.";

    // Twelve hex digits of the FNV-1a hash of a text.
    fn hash(text: String) -> String;

    // The fingerprint of every piece, by its name.
    fn all(m: model::Model) -> Map<String, String>;

    // The fingerprint of the piece a name speaks of.
    fn of(prints: Map<String, String>, name: String) -> Option<String>;

    claim t_hash_empty() { hash("") == "cbf29ce48422" }
    claim t_hash_a() { hash("a") == "af63dc4c8601" }

    // meaning_not_bytes
    claim writing_does_not_count() {
        match types::load("subject s { fn f(a: Int) -> Int; claim c(a: Int) { f(a) >= 0 } }", "") {
            Err(e) => false,
            Ok(m) => match types::load("// why\nsubject s {\n  claim c(a: Int) {   f(a) >= 0 }\n  fn f(a: Int) -> Int;\n}", "") {
                Err(e) => false,
                Ok(n) => all(m) == all(n),
            },
        }
    }
    claim another_claim_counts() {
        match types::load("subject s { fn f(a: Int) -> Int; claim c(a: Int) { f(a) >= 0 } }", "") {
            Err(e) => false,
            Ok(m) => match types::load("subject s { fn f(a: Int) -> Int; claim c(a: Int) { f(a) > 0 } }", "") {
                Err(e) => false,
                Ok(n) => of(all(m), "s::c") != of(all(n), "s::c") && of(all(m), "s::f") == of(all(n), "s::f"),
            },
        }
    }

    // capture_follows_its_claims
    claim a_new_claim_changes_the_capture() {
        match types::load("subject s { ensure e = \"x\"; fn f(a: Int) -> Int; }", "") {
            Err(e) => false,
            Ok(m) => match types::load("subject s { ensure e = \"x\"; fn f(a: Int) -> Int; claim c(a: Int) { f(a) > 0 } }", "") {
                Err(e) => false,
                Ok(n) => of(all(m), "s::e::captured") != of(all(n), "s::e::captured") && of(all(m), "s::e") == of(all(n), "s::e"),
            },
        }
    }

    // speaks_of_its_piece
    claim t_of_the_piece() { of({"s::f": "aa"}, "s::f") == Some("aa") }
    claim t_of_what_is_under_it() { of({"s::f": "aa"}, "s::f::correct") == Some("aa") }
    claim t_of_nothing() { of({"s::f": "aa"}, "s::g") == None }
}
