// The trust calculus (src/trust.rs, src/trust/culprits.rs) as Mitra sees
// it: what it promises, aside from the code.
//
// A comment `// mitra: implements mass::Mass::judged`
// above a `fn` ties it to a function here, and `mitra tie` checks that
// the two agree. A test says which input it pins in its own comment,
// `// mitra: evidence for mass::Mass::judged given ok = true, c = 0.25 gives …`.
// How the opinions are computed is not stated here: only what must be
// true of them.

// `Option` and `Result` are imported in model.mitra: the files of a store
// are one model.

subject mass {
    ensure valid = "An opinion made here is valid: belief, disbelief and the uncommitted part are each within 0 and 1 and sum to 1.";
    ensure combines = "Two valid opinions on one question combine into one valid opinion, and how much they contradict each other is measured, never lost.";

    // An opinion on "the subject is correct".
    record Mass { b: f64, d: f64, u: f64 }

    impl Mass {
        // The opinion one judged input gives, with confidence `c`.
        fn judged(ok: bool, c: f64) -> Option<Self>;
        fn is_valid(&self) -> bool;
        fn conflict(&self, o: &Mass) -> f64;
        // Dempster's rule: no answer when the two contradict each other fully.
        fn dempster(&self, o: &Mass) -> Option<Self>;
        // Yager's rule: always an answer, with the conflict beside it.
        fn yager(&self, o: &Mass) -> Option<(Self, f64)>;
    }

    // valid
    claim judged_valid(ok: bool, c: f64) {
        match Mass::judged(ok, c) { None => c < 0.0 || c > 1.0, Some(m) => valid(m) }
    }
    claim is_valid_says_valid(m: Mass) { m.is_valid() == valid(m) }

    // combines
    claim conflict_symmetric(m: Mass, o: Mass) { m.conflict(o) == o.conflict(m) }
    claim conflict_bounded(m: Mass, o: Mass) {
        !valid(m) || !valid(o) || (m.conflict(o) >= 0.0 && m.conflict(o) <= 1.0)
    }
    claim yager_combines(m: Mass, o: Mass) {
        match m.yager(o) {
            None => !valid(m) || !valid(o),
            Some(r) => valid(m) && valid(o) && valid(r.0) && r.1 == m.conflict(o),
        }
    }
    claim dempster_combines(m: Mass, o: Mass) {
        match m.dempster(o) {
            None => !valid(m) || !valid(o) || m.conflict(o) >= 0.999999999,
            Some(r) => valid(m) && valid(o) && valid(r),
        }
    }
    // An opinion that commits to nothing changes nothing.
    claim nothing_changes_nothing(m: Mass, o: Mass) {
        !valid(m) || o != Mass(0.0, 0.0, 1.0) || m.yager(o) == Some((m, 0.0))
    }
}

// The one formula kept: what `valid` means, to a rounding error. A
// definition of the model, not a description of the code.
fn valid(m: Mass) -> bool {
    let e = 0.000000001;
    let s = m.b + m.d + m.u;
    m.b >= -e && m.d >= -e && m.u >= -e && s >= 1.0 - e && s <= 1.0 + e
}

subject culprits {
    ensure ranks = "From how much each piece is trusted and which pieces can't all be right, each piece gets how much it must be wrong and how much it can be.";

    // For each piece, how much it must be wrong and how much it can be.
    record Ranking { belief: Vec<f64>, plausibility: Vec<f64>, conflict: f64, doubted: usize }
    enum NoRanking { TooMany, Invalid }

    fn rank(biases: Vec<Option<f64>>, clauses: Vec<Vec<usize>>) -> Result<Ranking, NoRanking>;

    // One opinion per piece, each within 0 and 1.
    claim rank_shape(biases, clauses) {
        match rank(biases, clauses) {
            Err(_) => true,
            Ok(r) => len(r.belief) == len(biases) && len(r.plausibility) == len(biases)
                && r.conflict >= 0.0 && r.conflict <= 1.0
                && all(x in r.belief, x >= 0.0 && x <= 1.0)
                && all(x in r.plausibility, x >= 0.0 && x <= 1.0),
        }
    }
    // With no clause, no piece has to be wrong.
    claim no_clause_no_belief(biases, clauses) {
        len(clauses) > 0 || match rank(biases, clauses) {
            Err(_) => true,
            Ok(r) => all(x in r.belief, x == 0.0),
        }
    }
}
