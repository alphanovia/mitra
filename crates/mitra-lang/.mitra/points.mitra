// The points the tests pin: each is a claim. The test that checks it is
// the `fn` under the comment `// mitra: evidence for <claim>`, in the
// Rust file named above the claim.

// src/eval.rs

claim t_holds() { verdicts::Holds.as_str() == "holds" }

claim t_assuming() { Assuming.as_str() == "holds assuming" }

claim t_unverified() { Unverified.as_str() == "unverified" }

claim t_fails() { Fails.as_str() == "fails" }

claim t_plus() { eval::binary("+", 2, 3) == Some(5) }

claim t_plus_swapped() { eval::binary("+", 3, 2) == Some(5) }

claim t_plus_overflow() { eval::binary("+", 9223372036854775807, 1) == None }

claim t_plus_overflow_swapped() { eval::binary("+", 1, 9223372036854775807) == None }

claim t_plus_mixed() { eval::binary("+", 2, true) == None }

claim t_plus_mixed_swapped() { eval::binary("+", true, 2) == None }

claim t_plus_floats() { eval::binary("+", 0.5, 0.25) == Some(0.75) }

claim t_plus_floats_swapped() { eval::binary("+", 0.25, 0.5) == Some(0.75) }

claim t_minus() { eval::binary("-", 2, 3) == Some(-1) }

claim t_plus_negated() { eval::binary("+", 2, -3) == Some(-1) }

claim t_times() { eval::binary("*", 4, -3) == Some(-12) }

claim t_times_swapped() { eval::binary("*", -3, 4) == Some(-12) }

claim t_divide() { eval::binary("/", -12, -3) == Some(4) }

claim t_divide_towards_zero() { eval::binary("/", -7, 2) == Some(-3) }

claim t_divide_by_zero() { eval::binary("/", 1, 0) == None }

claim t_divide_floats() { eval::binary("/", 1.0, 4.0) == Some(0.25) }

claim t_equal() { eval::binary("==", 2, 2) == Some(true) }

claim t_different() { eval::binary("!=", 2, 2) == Some(false) }

claim t_equal_mixed() { eval::binary("==", 2, "2") == Some(false) }

claim t_different_mixed() { eval::binary("!=", 2, "2") == Some(true) }

claim t_less() { eval::binary("<", 2, 3) == Some(true) }

claim t_and() { eval::binary("&&", true, false) == Some(false) }

claim t_or() { eval::binary("||", true, false) == Some(true) }

claim t_unknown_operator() { eval::binary("%", 2, 3) == None }

claim t_not_true() { eval::unary("!", true) == Some(false) }

claim t_not_false() { eval::unary("!", false) == Some(true) }

claim t_negate() { eval::unary("-", 3) == Some(-3) }

claim t_negate_back() { eval::unary("-", -3) == Some(3) }

claim t_negate_float() { eval::unary("-", 0.5) == Some(-0.5) }

claim t_negate_string() { eval::unary("-", "a") == None }

claim t_in_set() { eval::binary("in", 2, {1, 2}) == Some(true) }

claim t_in_list() { eval::binary("in", 3, [1, 2]) == Some(false) }

claim t_in_map() { eval::binary("in", "a", {"a": 1}) == Some(true) }

claim t_in_number() { eval::binary("in", 1, 2) == None }

claim t_union() { eval::binary("|", {1, 2}, {2, 3}) == Some({1, 2, 3}) }

claim t_union_swapped() { eval::binary("|", {2, 3}, {1, 2}) == Some({1, 2, 3}) }

claim t_intersection() { eval::binary("&", {1, 2}, {2, 3}) == Some({2}) }

claim t_apart() { eval::binary("&", {1}, {2, 3}) == Some({}) }

claim t_difference() { eval::binary("\\", {1, 2}, {2, 3}) == Some({1}) }

claim t_map_update() { eval::binary("|", {"a": 1, "b": 2}, {"a": 5}) == Some({"a": 5, "b": 2}) }

claim t_map_remove() { eval::binary("\\", {"a": 1, "b": 2}, {"a", "z"}) == Some({"b": 2}) }

claim t_set_with_map() { eval::binary("|", {1}, {"a": 1}) == None }

claim t_keys() { eval::unary("keys", {"a": 1, "b": 2}) == Some({"a", "b"}) }

claim t_keys_of_a_set() { eval::unary("keys", {1}) == None }

// src/print.rs

claim t_level_or() { print::level("||") == 1 }

claim t_level_and() { print::level("&&") == 2 }

claim t_level_compare() { print::level("<=") == 3 }

claim t_level_sum() { print::level("-") == 4 }

claim t_level_union() { print::level("|") == 4 }

claim t_level_intersection() { print::level("&") == 5 }

claim t_level_in() { print::level("in") == 3 }

claim t_level_product() { print::level("/") == 5 }

claim t_negative_int() { print::negative(-1) == true }

claim t_negative_zero() { print::negative(0) == false }

claim t_negative_float() { print::negative(-0.5) == true }

claim t_negative_string() { print::negative("-1") == false }

// src/report.rs

claim t_word_certain() { report::word(Candidate(Code("f"), 1.0, 1.0)) == "certain" }

claim t_word_likely() { report::word(Candidate(Code("f"), 0.5, 1.0)) == "likely" }

claim t_word_possible() { report::word(Candidate(Code("f"), 0.0, 0.5)) == "possible" }

claim t_word_unlikely() { report::word(Candidate(Code("f"), 0.0, 0.25)) == "unlikely" }

// src/set.rs

claim t_quote_plain() { print::quote("a b") == "\"a b\"" }

claim t_quote_empty() { print::quote("") == "\"\"" }

claim t_quote_escapes() { print::quote("a\"b\\c\nd\te") == "\"a\\\"b\\\\c\\nd\\te\"" }
