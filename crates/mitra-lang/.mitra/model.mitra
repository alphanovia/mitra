// mitra-lang as Mitra sees it. Start here.
//
// The model is aside from the code (src/), one file per subject. Each
// file reads alone: it says what its subject promises (`ensure`), what
// it needs (`require`), then the records, functions and claims that
// serve those promises, and nothing else.
//
// What a model is made of, in reading order:
//   functions.mitra   a function: code, spec, helper, world
//   claims.mitra      a claim, an assumption, `uses`, the implied claims
//   intent.mitra      an `ensure`, a `require`, the capture between prose and claims
//   ledger.mitra      evidence: pinned, passes, sampled, vouched
//   model.mitra       the model that holds them (this file)
//
// What Mitra does with one:
//   modules.mitra     what it is handed: named texts, never a disk
//   reader.mitra      from text to a model
//   types.mitra       what a model must satisfy before anything is judged
//   verdicts.mitra    from a model and its evidence to verdicts
//   report.mitra      the pieces that can be wrong, and the words printed
//   culprits.mitra    how the pieces of a conflict are ranked
//   advice.mitra      the evidence still owed
//   results.mitra     test results as evidence, and the JUnit format
//   operators.mitra   the operators of the language
//   print.mitra       printing values back
//   points.mitra      the single calls the unit tests pin
//
// A comment `// mitra: implements model::Model` above a `struct` or a
// `fn` ties it to a record or a function here, and `mitra tie` checks
// that the two agree. A record states only the fields a claim reads:
// `..` and `record R;` leave the rest to the code. A Rust `Value` is the
// type `Any`.
//
// mitra-lang has no boundary: it reads no file, no clock and no network
// (modules.mitra says so). The disk is in mitra-store's model.

import std::rust::{Option, Result};

subject model {
    ensure holds_everything = "A model is everything Mitra judges: the functions, the claims on them, the promises in prose, and the evidence brought; nothing outside it counts.";
    ensure world_apart = "The functions of the environment are listed apart from the code under review.";
    ensure blocks_are_things = "Each named `subject` and `boundary` is held as a block, with the side it is on and the store it was brought from if any; a piece finds its block by its name.";

    // The side of the line a block is on: built by us, or bought.
    enum Side { Subject, Boundary }

    // `subject name { … }` or `boundary name { … }`.
    record Block {
        name: String,
        side: Side,
        // The store it was brought from, `import store::name::{…};`.
        from: Option<String>,
        ..
    }

    record Model {
        functions: Vec<functions::Function>,
        claims: Vec<claims::Claim>,
        ensures: Vec<intent::Ensure>,
        evidence: Vec<ledger::Evidence>,
        // The functions written in a boundary, by name.
        boundaries: Vec<String>,
        blocks: Vec<Block>,
        ..
    }

    impl Model {
        // The block a piece is declared in, by the name of the piece.
        fn block_of(&self, piece: String) -> Option<Block>;
    }

    // holds_everything
    claim nothing_written_nothing_held() {
        match types::load("", "") {
            Err(e) => false,
            Ok(m) => len(m.functions) == 0 && len(m.claims) == 0 && len(m.ensures) == 0 && len(m.evidence) == 0,
        }
    }

    // blocks_are_things
    claim blocks_are_listed() {
        match types::load("boundary clock { fn now() -> Int; } subject s { fn f() -> Int; }", "") {
            Err(e) => false,
            Ok(m) => len(m.blocks) == 2
                && m.blocks[0].name == "clock" && m.blocks[0].side == Boundary
                && m.blocks[1].name == "s" && m.blocks[1].side == Subject
                && m.blocks[1].from == None,
        }
    }
    claim a_block_written_twice_is_one() {
        match types::load("subject s { fn f() -> Int; } subject s { fn g() -> Int; }", "") {
            Err(e) => false,
            Ok(m) => len(m.blocks) == 1,
        }
    }

    // world_apart
    claim world_is_listed() {
        match types::load("boundary fn now() -> Int; subject fn f() -> Int;", "") {
            Err(e) => false,
            Ok(m) => m.boundaries == ["now"],
        }
    }
}
