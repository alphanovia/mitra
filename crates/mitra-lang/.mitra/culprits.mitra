// Ranking the pieces of a conflict (src/trust/culprits.rs): the trust
// calculus Mitra runs. How the numbers are computed is not stated here,
// only what must be true of them.

import std::rust::{Option, Result};

subject culprits {
    ensure ranks = "From how much each piece is trusted and which pieces can't all be right, each piece gets how much it must be wrong and how much it can be.";

    // For each piece, how much it must be wrong (belief) and how much it
    // can be (plausibility).
    record Ranking {
        belief: Vec<f64>,
        plausibility: Vec<f64>,
        // How much of the trust given contradicts itself.
        conflict: f64,
        // How many pieces trusted fully had to be doubted.
        doubted: usize,
    }

    enum NoRanking {
        TooMany,
        Invalid
    }

    // `biases[i]` is the trust in piece `i`; each clause lists pieces
    // that can't all be right.
    fn rank(biases: Vec<Option<f64>>, clauses: Vec<Vec<usize>>) -> Result<Ranking, NoRanking>;

    // One opinion per piece, each within 0 and 1.
    claim rank_shape(biases, clauses) {
        match rank(biases, clauses) {
            Err(_) => true,
            Ok(r) => len(r.belief) == len(biases)
                && len(r.plausibility) == len(biases)
                && r.conflict >= 0.0 && r.conflict <= 1.0
                && all(x in r.belief, x >= 0.0 && x <= 1.0)
                && all(x in r.plausibility, x >= 0.0 && x <= 1.0),
        }
    }

    // With no clause, no piece has to be wrong.
    claim no_clause_no_belief(biases, clauses) {
        len(clauses) > 0 || match rank(biases, clauses) {
            Err(_) => true,
            Ok(r) => all(x in r.belief, x == 0.0),
        }
    }
}
