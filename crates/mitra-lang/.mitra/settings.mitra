// The settings of a store (src/settings.rs): the numbers the trust of a
// tie and of a sample are computed from. The file is read by whoever
// holds the disk; here its text is handed.
//
// How far a tie is from its code is a count of erasures, each with a
// cost; how much a sample says is a matter of how many inputs it drew.
// Neither changes a verdict: both are the trust of a piece, which ranks
// it among the suspects of a contradiction.

import std::core::{Option, Result};
import std::rust::{Vec};

subject settings {
    ensure defaults_without_a_file = "With no file, or a file that states nothing, the settings are the defaults: a tolerance of 0.001, a sample that covers nothing, and the costs of the reader's own profile.";
    ensure only_what_is_known = "A table or a key the settings do not have is refused with its line, and so is a number outside 0 to 1: a setting is never silently ignored.";
    ensure sample_trust_from_count = "A passing sample of n draws is trusted for 1 - (1 - tolerance)^n: nothing for no draw, more for more draws, each draw adding less, never 1.";
    ensure tie_trust_from_erasures = "A tie is trusted for the product of what each erasure on its path leaves: 1 when nothing was erased, less with each erasure that costs, whatever their order.";
    ensure in_force_is_written = "The settings in force can be written as a file that reads back to the same settings, with every cost of the reader's profile in it.";

    record Settings {
        // The share of its domain a sampled claim may fail on unseen.
        tolerance: f64,
        // Whether a passing sample lets a claim hold assuming it.
        counts: bool,
        // The costs the file states, by erasure.
        erasure: Map<String, f64>,
    }

    impl Settings {
        fn read(text: String) -> Result<Self, String>
            uses voices::policy_reads;
        fn sample(&self, n: u64) -> f64;
        fn strength(costs: Vec<f64>) -> f64;
        fn written(&self, profile: Vec<(String, f64)>) -> String;
        // How often a word of this kind of voice is wrong.
        fn doubt(&self, kind: String) -> f64;
    }

    // defaults_without_a_file
    claim absent_is_default() {
        match Settings::read("") {
            Err(e) => false,
            Ok(s) => s.tolerance == 0.001 && !s.counts,
        }
    }

    // only_what_is_known
    claim file_is_read() {
        match Settings::read("[sample]\ncounts = true") {
            Err(e) => false,
            Ok(s) => s.counts,
        }
    }
    claim unknown_setting_is_refused() {
        Settings::read("[other]") is Err && Settings::read("[erasure]\nwidth = 2") is Err
    }

    // sample_trust_from_count
    claim sample_grows_less() {
        match Settings::read("") {
            Err(e) => false,
            Ok(s) => s.sample(0) == 0.0 && s.sample(1000) < s.sample(2000) && s.sample(2000) < 1.0
                && s.sample(2000) - s.sample(1000) < s.sample(1000),
        }
    }

    // tie_trust_from_erasures
    claim strength_is_a_product() {
        Settings::strength([]) == 1.0 && Settings::strength([0.0, 0.0]) == 1.0
            && Settings::strength([0.5, 0.5]) == 0.25
    }

    // in_force_is_written
    claim written_is_read_back() {
        match Settings::read("") {
            Err(e) => false,
            Ok(s) => Settings::read(s.written([("width", 0.02)])) is Ok,
        }
    }
}
