// What a report says when something does not add up (src/eval.rs,
// src/report.rs).
//
// Everything is a suspect: when pieces can't all be right, each of them
// is a candidate, with how much it must be wrong and how much it can be.

import std::claims::{uniform};
import std::rust::{Option, Result};

subject report {
    require ranked = culprits::ranks;

    ensure words = "A verdict and a candidate are printed with the word the reference gives them.";

    // A piece that may be the wrong one. Rust's variants hold unnamed
    // values; the field names are the model's.
    enum Piece {
        Evidence(line: usize),        // a piece of evidence someone brought
        Code(subject: String),        // the code of a function
        Claim(name: String),          // the statement of a claim
        Signature(function: String),  // the inputs and result type of a function
        Assumption(name: String),     // an `assume`, taken as true
        Uses(function: String),       // the `uses` clause of a function
        Requirement(name: String),    // the text of an `ensure`
        Capture(name: String),        // that the claims say what that text says
        Helper(name: String),         // a helper of the model, as a definition
        Tie(function: String)         // that a function and its code agree
    }

    // A piece, how much it must be wrong and how much it can be.
    record Candidate {
        piece: Piece,
        belief: f64,
        plausibility: f64,
    }

    impl Logic {
        fn as_str(self) -> String {
            match self {
                verdicts::Holds => "holds",
                Assuming => "holds assuming",
                Unverified => "unverified",
                Fails => "fails",
            }
        }
    }

    // The word a ranking prints beside a candidate.
    fn word(c: Candidate) -> String {
        if c.belief >= 0.995 { "certain" }
        else if c.belief >= 0.5 { "likely" }
        else if c.plausibility >= 0.5 { "possible" }
        else { "unlikely" }
    }

    // One class per word.
    claim word_uniform = uniform(word, |c| -> {"certain", "likely", "possible", "unlikely"} { word(c) });
}
