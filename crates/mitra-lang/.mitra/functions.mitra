// A function of a model (src/ast.rs, `Function`).
//
// Where it is written and whether it has a body say what it is:
//
//   subject fn f(a: Int) -> Int;          code: real code under review
//   subject fn f(a: Int) -> Int { a }     spec: what that code should return
//   fn h(a: Int) -> Int { a }             helper: a definition of the model
//   boundary fn now() -> Int;             world: the environment

import std::core::{Option, Result};

subject functions {
    ensure code_is_only_observed = "A function of a subject is real code: Mitra never runs it and knows of it only what evidence says. Unless the model says otherwise, it is claimed correct and deterministic.";
    ensure spec_is_a_claim = "A body on a function of a subject is a spec: it adds the claim that the code returns what the body computes, in place of the bare claim that it is correct.";
    ensure helper_is_a_definition = "A function outside every subject and boundary is a helper: Mitra computes it, and nothing is claimed about any code.";
    ensure world_is_not_claimed = "A function of a boundary is the world: nothing is claimed about it unless the model assumes it.";

    // A body, as read. Nothing of it is stated here.
    record Expr;

    record Function {
        name: String,
        // `None` for code Mitra never runs.
        body: Option<Expr>,
        line: usize,
        ..
    }

    // code_is_only_observed
    claim code_is_claimed_correct() {
        match types::load("subject fn f() -> Bool;", "") {
            Err(e) => false,
            Ok(m) => map(c in m.claims, c.name) == ["f::correct", "f::deterministic"],
        }
    }

    // spec_is_a_claim
    claim spec_replaces_correct() {
        match types::load("subject fn f() -> Bool { true }", "") {
            Err(e) => false,
            Ok(m) => map(c in m.claims, c.name) == ["f::spec", "f::deterministic"],
        }
    }

    // helper_is_a_definition
    claim helper_claims_nothing() {
        match types::load("fn h() -> Bool { true }", "") {
            Err(e) => false,
            Ok(m) => len(m.claims) == 0 && map(f in m.functions, f.name) == ["h"],
        }
    }

    // world_is_not_claimed
    claim world_claims_nothing() {
        match types::load("boundary fn now() -> Int;", "") {
            Err(e) => false,
            Ok(m) => len(m.claims) == 0,
        }
    }
}
