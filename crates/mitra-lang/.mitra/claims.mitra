// A claim (src/ast.rs, `Claim` and `Target`).
//
// A claim says something that must be true of the code on every input
// it names. What it says is its target:
//
//   claim c(a: Int) { f(a) >= 0 }      a property, written
//   assume c(a: Int) { f(a) >= 0 }     the same, taken as true with no evidence
//   subject fn g() -> Int uses f;      g::uses: what `g` calls
//   f::correct, f::spec                implied by a function of a subject
//   f::deterministic                   implied: one input, one output
//   f::tied                            the code is where a tie comment says

import std::core::{Option, Result};
import std::rust::{Vec};

subject claims {
    ensure names_its_function = "A claim has a name of its own and names the function it is about, so a report can point at it.";
    ensure assume_is_a_claim = "An assumption is a claim with evidence nobody brought: what rests on it holds assuming it, and says so.";
    ensure uses_is_a_claim = "What a function calls is a claim like any other: stated by `uses`, or read from the body of a spec.";
    ensure implied_are_named = "Every claim Mitra adds on its own (correct, spec, deterministic, uses, tied) has a name that can be given evidence, vouched for, or be the piece that is wrong.";
    ensure trust_is_on_the_statement = "The trust written on a claim is trust in its statement, apart from any evidence for it.";

    // What a claim says. Rust's variants hold unnamed values; the field
    // names are the model's.
    enum Target {
        Correct,                              // judged by people: right or wrong
        Matches(spec: functions::Expr),       // equal to this expression on every input
        Property(body: functions::Expr),      // true on every input
        Uniform(by: Option<String>),          // one judged input stands for its class
        Uses(used: Vec<String>, only: bool),  // calls these, and with `only` no other
        Tied,                                 // the code is where the tie says
        Represented(set: String)              // one tested input stands for a set
    }

    record Claim {
        name: String,
        // The function it is about.
        func: String,
        target: Target,
        trust: Option<f64>,
        line: usize,
        ..
    }

    // names_its_function
    claim written_claim_is_named() {
        match types::load("subject fn f(a: Int) -> Int; claim c(a: Int) { f(a) == f(a) }", "") {
            Err(e) => false,
            Ok(m) => map(c in m.claims, c.name) == ["c", "f::correct", "f::deterministic"],
        }
    }

    // assume_is_a_claim
    claim assume_is_named_and_assumed() {
        match verdicts::run("subject fn f(a: Int) -> Int; assume c(a: Int) { f(a) >= 0 }", "") {
            Err(e) => false,
            Ok(r) => map(v in r.verdicts, v.claim) == ["c", "f::correct", "f::deterministic"]
                && map(v in r.verdicts, v.logic) == [Assuming, Unverified, Unverified],
        }
    }

    // uses_is_a_claim
    claim uses_is_named() {
        match types::load("subject fn f() -> Int; subject fn g() -> Int uses f;", "") {
            Err(e) => false,
            Ok(m) => "g::uses" in map(c in m.claims, c.name),
        }
    }
    claim uses_is_read_from_a_body() {
        match types::load("subject fn f() -> Int; subject fn g() -> Int { f() }", "") {
            Err(e) => false,
            Ok(m) => "g::uses" in map(c in m.claims, c.name),
        }
    }

    // implied_are_named
    claim tie_is_named_once_evidence_names_it() {
        match types::load("subject fn f() -> Int;", "evidence t { for f::tied holds }") {
            Err(e) => false,
            Ok(m) => map(c in m.claims, c.name) == ["f::correct", "f::deterministic", "f::tied"],
        }
    }

    // trust_is_on_the_statement
    claim trust_is_kept() {
        match types::load("subject fn f(a: Int) -> Int; claim c(a: Int) trust 0.5 { f(a) >= 0 }", "") {
            Err(e) => false,
            Ok(m) => map(c in m.claims, c.trust) == [Some(0.5), None, None],
        }
    }
}
