// From text to a model (src/parse.rs).

import std::core::{Option, Result};

subject reader {
    ensure reads = "A model written as the language reference says is read.";
    ensure refuses = "A text that is not a model is refused, with the line of the fault and what is wrong.";

    // A fault in a text, with its line.
    record Error {
        line: usize,
        message: String,
    }

    // What the reader keeps of names. Nothing of it is read here.
    record Names;

    fn model(src: String) -> Result<(model::Model, Names), Error>;

    // reads
    claim reads_a_subject() {
        model("subject fn f() -> Bool;") is Ok
    }

    // refuses
    claim refuses_a_bare_fn() {
        model("fn f() -> Bool;") is Err
    }
    claim fault_is_placed(src: String) {
        match model(src) {
            Ok(read) => true,
            Err(e) => e.line >= 1 && e.message != "",
        }
    }
}
