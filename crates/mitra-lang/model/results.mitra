// Test results as evidence (src/ledger/results.rs).
//
// A reader of a language of code finds the tests tied to claims and
// reads its own report format. Here: what a result is, the JUnit format
// many tools write, and the rules that turn results into evidence.
//
//   // mitra: evidence for c                        nothing pinned
//   // mitra: evidence for f given a = 6 gives 3    pinned
//   // mitra: evidence for c given a in S sampled 100

import std::core::{Option, Result};
import std::rust::{Vec};

subject results {
    require judged_as_written = ledger::unstated_covers_nothing;

    ensure a_pass_is_not_overstated = "A passing test becomes evidence for exactly what its tie comment pins: with no input stated, on a claim with inputs, it only passes.";
    ensure a_failure_is_kept = "A failing test becomes evidence against what its tie comment pins, or against the whole claim when it pins nothing.";
    ensure reads_junit = "Every test case of a JUnit report is read, with its name and whether it passed; skipped ones are left out.";

    // One test of a report, and whether it passed.
    record Outcome {
        name: String,
        passed: bool,
    }

    // A test tied to a claim by a comment above it.
    record Tied {
        // The name of the test.
        test: String,
        claim: String,
        // What the comment pins, as the clauses of an evidence block.
        pinned: String,
        // The file and line of the comment.
        place: String,
    }

    // What the results say, as evidence blocks to add.
    record Ingested {
        evidence: Vec<String>,
        // What was left out, and why.
        notes: Vec<String>,
        // Tests recorded as `passes`.
        loose: Vec<String>,
    }

    // What a tie comment pins, and who it says wrote the test.
    fn signed(pinned: String) -> (String, String);

    fn from_tests(model: model::Model, tied: Vec<Tied>, outcomes: Vec<Outcome>, rev: Option<String>) -> Result<Ingested, String>;

    // a_pass_is_not_overstated
    claim unpinned_pass_only_passes() {
        match types::load("subject fn f(a: Int) -> Int; claim c(a: Int) { f(a) >= 0 }", "") {
            Err(e) => false,
            Ok(m) => match from_tests(m, [Tied("t", "c", "", "lib.rs:1")], [Outcome("t", true)], None) {
                Err(e) => false,
                Ok(said) => said.evidence == ["evidence test { for c passes source \"test:t\" }"]
                    && len(said.loose) == 1,
            },
        }
    }
    claim pass_on_a_point_holds() {
        match types::load("subject fn f(a: Int) -> Int; claim c() { f(1) >= 0 }", "") {
            Err(e) => false,
            Ok(m) => match from_tests(m, [Tied("t", "c", "", "lib.rs:1")], [Outcome("t", true)], None) {
                Err(e) => false,
                Ok(said) => said.evidence == ["evidence test { for c holds source \"test:t\" }"],
            },
        }
    }
    claim pinned_pass_is_written_as_it_stands() {
        match types::load("subject fn f(a: Int) -> Int;", "") {
            Err(e) => false,
            Ok(m) => match from_tests(m, [Tied("t", "f", "given a = 6 gives 3", "lib.rs:1")], [Outcome("t", true)], Some("abc")) {
                Err(e) => false,
                Ok(said) => said.evidence == [
                    "evidence test { for f given a = 6 gives 3 source \"test:t\" rev \"abc\" }",
                    "evidence test { for f given a = 6 holds source \"test:t\" rev \"abc\" }"],
            },
        }
    }
    claim sample_keeps_its_count() {
        match types::load("subject fn f(a: Int) -> Int; claim c(a: Int) { f(a) >= 0 }", "") {
            Err(e) => false,
            Ok(m) => match from_tests(m, [Tied("t", "c", "given a in 0..=9 sampled 10", "lib.rs:1")], [Outcome("t", true)], None) {
                Err(e) => false,
                Ok(said) => said.evidence == ["evidence test { for c given a in 0..=9 sampled 10 source \"test:t\" }"],
            },
        }
    }

    // a_failure_is_kept
    claim pinned_failure_denies_the_pin() {
        match types::load("subject fn f(a: Int) -> Int;", "") {
            Err(e) => false,
            Ok(m) => match from_tests(m, [Tied("t", "f", "given a = 6 gives 3", "lib.rs:1")], [Outcome("t", false)], None) {
                Err(e) => false,
                Ok(said) => said.evidence == ["evidence test { for f given a = 6 fails source \"test:t\" }"],
            },
        }
    }
    claim unpinned_failure_fails_the_claim() {
        match types::load("subject fn f(a: Int) -> Int; claim c(a: Int) { f(a) >= 0 }", "") {
            Err(e) => false,
            Ok(m) => match from_tests(m, [Tied("t", "c", "", "lib.rs:1")], [Outcome("t", false)], None) {
                Err(e) => false,
                Ok(said) => said.evidence == ["evidence test { for c fails source \"test:t\" }"],
            },
        }
    }
    claim failing_sample_says_fails() {
        match types::load("subject fn f(a: Int) -> Int; claim c(a: Int) { f(a) >= 0 }", "") {
            Err(e) => false,
            Ok(m) => match from_tests(m, [Tied("t", "c", "given a in 0..=9 sampled 10", "lib.rs:1")], [Outcome("t", false)], None) {
                Err(e) => false,
                Ok(said) => said.evidence == ["evidence test { for c given a in 0..=9 sampled 10 fails source \"test:t\" }"],
            },
        }
    }

    // reads_junit

    // The name of a test without its module path.
    fn short(path: String) -> String;

    // A short name is already short.
    claim short_once(path) {
        short(short(path)) == short(path)
    }

    // The value of an attribute in an XML tag.
    fn attr(tag: String, attr: String) -> Option<String>;

    // The text without what stands between `open` and `close`.
    fn strip(text: String, open: String, close: String) -> String;

    fn junit(xml: String) -> Vec<Outcome>
        uses only strip, attr, short;
}
