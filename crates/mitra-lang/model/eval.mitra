// The operators of the language (src/eval.rs): the value of an expression.
//
// They are stated with the operators themselves: each side of a claim
// is computed by this code, and the tests give the outputs.

import std::core::{Option, Result};

subject eval {
    ensure computes = "An operator computes what the language reference says, and gives no value where it does not apply.";

    // An operator of one value. `None` when it does not apply to the value.
    fn unary(op: String, v: Any) -> Option<Any>;

    // An operator of two values.
    fn binary(op: String, x: Any, y: Any) -> Option<Any>;

    claim not_is(v: Bool) {
        unary("!", v) == Some(!v)
    }
    claim twice_negated(v: Int) {
        match unary("-", v) {
            None => true,
            Some(n) => unary("-", n) == Some(v),
        }
    }
    claim plus_commutes(x, y) {
        binary("+", x, y) == binary("+", y, x)
    }
    claim times_commutes(x, y) {
        binary("*", x, y) == binary("*", y, x)
    }
    claim minus_is_plus_negated(x: Int, y: Int) {
        match unary("-", y) {
            None => true,
            Some(n) => binary("-", x, y) == binary("+", x, n),
        }
    }
    claim different_is_not_equal(x, y) {
        match binary("==", x, y) {
            None => false,
            Some(e) => binary("!=", x, y) == unary("!", e),
        }
    }
    claim union_commutes(x: Set<Int>, y: Set<Int>) {
        binary("|", x, y) == binary("|", y, x)
    }
    // What is left of x without y has nothing of y.
    claim difference_apart(x: Set<Int>, y: Set<Int>) {
        match binary("\\", x, y) {
            None => false,
            Some(d) => binary("&", d, y) == Some({}),
        }
    }
    claim divides_back(x: Int, y: Int \ {0}) {
        match binary("*", x, y) {
            None => true,
            Some(p) => binary("/", p, y) == Some(x),
        }
    }
}
