// Evidence, and the ledger that holds it (`Evidence` and `Judgment` in
// src/model.rs, read by src/ledger/).
//
// One piece of evidence is one thing somebody observed or judged, about
// a function or a claim:
//
//   for f given a = 6 gives 3     pinned: one input, the output observed
//   for c holds                   vouched: a person says the claim is true
//   for c fails                   refuted: a counterexample, or a bug report
//   for c passes                  a test passed on inputs it does not state
//   for c sampled 1000            a test passed on 1000 drawn inputs
//
// with who says so (`source`), on which code (`rev`), and how much its
// author trusts it (`trust`, 1 when not said). The ledger is the list of
// them, in the order they were written. Keeping it on a disk is
// mitra-store's work.
//
// Not everything in a ledger judges. Evidence on a piece the model no
// longer has, and evidence a person said of a piece that reads
// otherwise today (`seen`, see fingerprint.mitra), is set aside: kept,
// shown in every report, counting for nothing.

import std::core::{Option, Result};
import std::rust::{Vec};

subject ledger {
    ensure says_who_and_when = "Each piece of evidence keeps who or what observed it, the revision of the code it was observed on, and the trust its author puts in it.";
    ensure pinned_is_an_output = "Evidence that pins an input records the output the code gave there: every claim that reads that output is judged with it.";
    ensure act_fits_its_claim = "Evidence that states its act is checked against what it says and what it is on: a test is a point, a sample states its count, a set run through is exhaustive, a whole claim or a capture takes a review or a proof, a report only denies. An act that cannot say it is refused with the reason.";
    ensure vouch_covers_the_claim = "A person's word that a claim holds covers every input the claim names.";
    ensure unstated_covers_nothing = "A test that passed on inputs it does not state covers no input: the claim stays unverified.";
    ensure sample_covers_nothing_unless_set = "A test that passed on drawn inputs covers no input: the claim stays unverified, with the sample and its trust under it. Only when the settings say a sample counts, and it was drawn from every input nothing else judges, does the claim hold assuming its sample, `c::sample`.";
    ensure failing_sample_refutes = "A test that failed on a drawn input refutes the claim, on an input it does not state.";
    ensure orphaned_judges_nothing = "Evidence of a ledger on a piece the model does not have is set aside: kept, shown, judging nothing. New evidence on such a piece is refused.";
    ensure stale_judges_nothing = "Evidence that keeps the fingerprint of its piece judges nothing once the piece has another one: it is set aside, with both fingerprints.";
    ensure machine_or_person = "Evidence whose source starts with `test:` or `reader:` was observed by a machine; any other is someone's word.";

    // What was observed. The field names are the model's.
    enum Judgment {
        Correct(ok: bool),                                // right or wrong, on a function
        Output(value: Any),                               // the output observed
        Holds(ok: bool),                                  // true or false, on a claim
        Passed,                                           // a test passed, inputs not stated
        Sampled(count: u64, ok: bool, domain: String, over: Any),    // on that many drawn inputs
        Measured(measure: functions::Expr, value: f64)    // a measure, as measured
    }

    record Evidence {
        // The function or the claim it is about.
        about: String,
        judgment: Judgment,
        // The trust of its author, from 0 to 1.
        confidence: f64,
        source: Option<String>,
        rev: Option<String>,
        // The fingerprint of its piece when a person said it.
        seen: Option<String>,
        line: usize,
        ..
    }

    impl Evidence {
        // Whether a machine observed it.
        fn by_machine(&self) -> bool;
        // What was done: the act it states, or the one its shape says.
        fn act(&self) -> String;
        // Whose word it is: who wrote what a machine ran, or who did it.
        fn voice(&self) -> Option<String>;
    }

    // Why evidence of the ledger counts for nothing.
    enum Why {
        Orphaned,                              // the model has no such piece
        Stale(seen: String, now: String)       // its piece says something else now
    }

    // Evidence set aside.
    record Aside {
        about: String,
        source: Option<String>,
        rev: Option<String>,
        why: Why,
        line: usize,
    }

    // One evidence block of a ledger, read without a model: the piece
    // it names as written, and its first and last line.
    record Entry {
        about: String,
        source: Option<String>,
        rev: Option<String>,
        seen: Option<String>,
        first: usize,
        last: usize,
    }

    fn entries(src: String) -> Vec<Entry>;

    // orphaned_judges_nothing
    claim orphan_is_set_aside() {
        match types::load("subject fn f() -> Bool;", "evidence r { for g holds source \"review:me\" }") {
            Err(e) => false,
            Ok(m) => map(a in m.aside, a.about) == ["g"]
                && map(a in m.aside, a.why) == [Orphaned]
                && len(m.evidence) == 0,
        }
    }

    // stale_judges_nothing
    claim stale_is_set_aside() {
        match types::load("subject fn f() -> Bool;", "evidence r { for f holds seen \"000000000000\" }") {
            Err(e) => false,
            Ok(m) => map(a in m.aside, a.about) == ["f"] && len(m.evidence) == 0,
        }
    }
    claim seen_as_it_is_judges() {
        match types::load("subject fn f() -> Bool;", "evidence r { for f holds }") {
            Err(e) => false,
            Ok(m) => len(m.aside) == 0 && len(m.evidence) == 1,
        }
    }

    // What `entries` reads.
    claim t_entries_one() {
        entries("evidence r { for a::b holds source \"review:me\" rev \"1\" }")
            == [Entry("a::b", Some("review:me"), Some("1"), None, 1, 1)]
    }
    claim t_entries_label_is_the_source() {
        entries("evidence ci {\n  for f given a = 1 gives 2\n}") == [Entry("f", Some("ci"), None, None, 1, 3)]
    }
    claim t_entries_none() {
        entries("// nothing") == []
    }

    // says_who_and_when
    claim source_rev_and_trust_are_kept() {
        match types::load("subject fn f() -> Bool;", "evidence r { for f holds source \"review:me\" rev \"abc\" trust 0.9 }") {
            Err(e) => false,
            Ok(m) => map(x in m.evidence, x.source) == [Some("review:me")]
                && map(x in m.evidence, x.rev) == [Some("abc")]
                && map(x in m.evidence, x.confidence) == [0.9],
        }
    }

    // pinned_is_an_output
    claim pinned_keeps_the_output() {
        match types::load("subject fn f(a: Int) -> Int;", "evidence t { for f given a = 1 gives 2 }") {
            Err(e) => false,
            Ok(m) => map(x in m.evidence, x.judgment) == [Output(2)],
        }
    }
    claim pinned_output_refutes_a_claim() {
        match verdicts::run("subject fn f(a: Int) -> Int; claim c(a: Int) { f(a) >= 0 }", "evidence t { for f given a = 1 gives -2 }") {
            Err(e) => false,
            Ok(r) => map(v in r.verdicts, v.logic) == [Fails, Unverified, Unverified],
        }
    }

    // act_fits_its_claim
    claim an_act_is_checked_against_its_claim() {
        verdicts::run("subject fn f(a: Int) -> Int; claim c(a: Int) { f(a) >= 0 }", "evidence t { for c holds act test }") is Err
            && verdicts::run("subject fn f(a: Int) -> Int; claim c(a: Int) { f(a) >= 0 }", "evidence t { for c holds act review }") is Ok
    }

    // vouch_covers_the_claim
    claim vouched_holds() {
        match verdicts::run("subject fn f(a: Int) -> Int; claim c(a: Int) { f(a) >= 0 }", "evidence r { for c holds }") {
            Err(e) => false,
            Ok(r) => map(v in r.verdicts, v.logic) == [verdicts::Holds, Unverified, Unverified],
        }
    }

    // unstated_covers_nothing
    claim passes_stays_unverified() {
        match verdicts::run("subject fn f(a: Int) -> Int; claim c(a: Int) { f(a) >= 0 }", "evidence t { for c passes }") {
            Err(e) => false,
            Ok(r) => map(v in r.verdicts, v.logic) == [Unverified, Unverified, Unverified],
        }
    }

    // sample_covers_nothing_unless_set
    claim sample_stays_unverified() {
        match verdicts::run("subject fn f(a: Int) -> Int; claim c(a: Int) { f(a) >= 0 }", "evidence t { for c sampled 100 }") {
            Err(e) => false,
            Ok(r) => map(v in r.verdicts, v.logic) == [Unverified, Unverified, Unverified],
        }
    }
    claim part_sample_stays_unverified() {
        match verdicts::run("subject fn f(a: Int) -> Int; claim c(a: Int) { f(a) >= 0 }", "evidence t { for c given a in 0..=9 sampled 100 }") {
            Err(e) => false,
            Ok(r) => map(v in r.verdicts, v.logic) == [Unverified, Unverified, Unverified],
        }
    }

    // failing_sample_refutes
    claim failing_sample_fails() {
        match verdicts::run("subject fn f(a: Int) -> Int; claim c(a: Int) { f(a) >= 0 }", "evidence t { for c sampled 100 fails }") {
            Err(e) => false,
            Ok(r) => map(v in r.verdicts, v.logic) == [Fails, Unverified, Unverified],
        }
    }
}
