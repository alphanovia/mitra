// A model, compiled (src/build.rs), and what the levels say beyond the
// report (src/build/levels.rs).
//
// `mitra build` is the first of four levels: the model alone. What it
// writes is this module's: every piece of the model, written or implied,
// with its kind, its fingerprint and what it rests on, and the interface
// the code must meet. Writing the files is mitra-store's work.

import std::core::{Option, Result};
import std::rust::{Vec};

subject build {
    require by_meaning = fingerprint::meaning_not_bytes;

    ensure every_piece_is_listed = "A compiled model lists every piece once: what is written, and what the model implies and never writes (`f::correct`, `f::deterministic`, captures), each with its kind and its fingerprint, in the order of their names.";
    ensure rests_on_is_kept = "A promise is listed with the claims, the requires and the capture it rests on.";
    ensure one_fingerprint_for_the_whole = "The fingerprint of a compiled model changes when a piece is added, removed or says something else, and only then.";
    ensure interface_is_ours = "The interface lists the functions, records and enums of the subjects of this store, each under the comment that ties code to it: nothing of a boundary, nothing brought from another store.";

    // One piece of a compiled model.
    record Item {
        // function, spec, helper, world, record, enum, claim, implied,
        // ensure, require, promise or capture.
        kind: String,
        name: String,
        print: String,
        // The pieces it rests on.
        on: Vec<String>,
    }

    record Built {
        items: Vec<Item>,
        // The fingerprint of the whole.
        model: String,
    }

    fn build(m: model::Model) -> Built
        uses fingerprint::all, fingerprint::of, fingerprint::hash;

    impl Built {
        // The build file: `mitra build 1`, `model <fingerprint>`, then
        // one line per piece.
        fn lock(&self) -> String;
        // How many pieces of a kind it holds.
        fn count(&self, kind: String) -> Nat;
    }

    fn interface(m: model::Model) -> String;

    // every_piece_is_listed, rests_on_is_kept
    claim implied_pieces_are_listed() {
        match types::load("subject s { ensure e = \"x\"; fn f(a: Int) -> Int; claim c(a: Int) { f(a) >= 0 } }", "") {
            Err(e) => false,
            Ok(m) => map(i in build(m).items, i.name) == ["s::c", "s::e", "s::e::captured", "s::f", "s::f::correct", "s::f::deterministic"]
                && map(i in build(m).items, i.kind) == ["claim", "ensure", "capture", "function", "implied", "implied"],
        }
    }
    claim a_promise_lists_what_it_rests_on() {
        match types::load("subject s { ensure e = \"x\"; fn f(a: Int) -> Int; }", "") {
            Err(e) => false,
            Ok(m) => map(i in build(m).items, i.on) == [["s::f::correct", "s::e::captured"], [], [], [], []],
        }
    }

    // one_fingerprint_for_the_whole
    claim writing_does_not_change_the_build() {
        match types::load("subject s { fn f(a: Int) -> Int; }", "") {
            Err(e) => false,
            Ok(m) => match types::load("// why\nsubject s {\n    fn f(a: Int) -> Int;\n}", "") {
                Err(e) => false,
                Ok(n) => build(m) == build(n),
            },
        }
    }
    claim another_type_changes_the_build() {
        match types::load("subject s { fn f(a: Int) -> Int; }", "") {
            Err(e) => false,
            Ok(m) => match types::load("subject s { fn f(a: Int) -> Bool; }", "") {
                Err(e) => false,
                Ok(n) => build(m).model != build(n).model,
            },
        }
    }

    // interface_is_ours
    claim the_world_is_not_in_the_interface() {
        match types::load("boundary clock { fn now() -> Int; } subject s { fn f(a: Int) -> Int; }", "") {
            Err(e) => false,
            Ok(m) => interface(m) == "// The code this model expects. Above each piece: the comment to put\n// above the code that implements it; `mitra tie` then compares the two.\n\n// mitra: implements s::f\nfn f(a: Int) -> Int;\n",
        }
    }
}

subject levels {
    require what_is_owed = advice::owed;

    ensure person_or_handed_over = "What is owed is split in two: what asks for a review or a reviewer's word, and evidence a person said that was set aside, is a person's; everything else can be handed over.";
    ensure observation_is_compared = "An observation is judged by the report with it against the report without it: it contradicts when a claim comes to fail or a new error appears, and each verdict that changes is listed.";

    record Left {
        person: Vec<String>,
        delegate: Vec<String>,
    }

    fn left(model: model::Model, report: verdicts::Report) -> Left
        uses advice::plan;

    record Diagnosis {
        contradicts: Bool,
        // `claim: before -> after`.
        changed: Vec<String>,
        text: String,
    }

    // person_or_handed_over
    claim a_capture_is_a_person_s() {
        match verdicts::run("subject s { ensure e = \"x\"; fn f(a: 0..=1) -> Int; }", "") {
            Err(e) => false,
            Ok(r) => match types::load("subject s { ensure e = \"x\"; fn f(a: 0..=1) -> Int; }", "") {
                Err(e) => false,
                Ok(m) => len(left(m, r).person) == 2 && len(left(m, r).delegate) == 1,
            },
        }
    }
}
