// The dogfood model of `src/evidence.rs`: core2 modelled in its own
// language, beside the code it models (the parts it uses are read by
// `use … from`). The whole model: `mitra check src/bin/mitra.mitra`.

subject record Ledger at "crates/mitra-lang/src/evidence.rs/Ledger" { measurements: [Measurement], reviews: [Review] }

// `by` and `from` are keywords of the model: the fields so named in
// Rust are in `..`, the fields the model does not state (raw names,
// finding 12c, would let the model name them).
subject record Measurement at "crates/mitra-lang/src/evidence.rs/Measurement" {
    inputs: [(Path, Value)], outputs: [(Path, Value)], seen: bool, count: integer, ..
}

subject record Review at "crates/mitra-lang/src/evidence.rs/Review" {
    prop: Path, holds: bool, seeing: [[~char]], ..
}

// A value of the model: opaque here.
subject record Value at "crates/mitra-lang/src/simulation.rs/Value";

subject evidence {
    use Path from "model";
    use check from "check";
    require checked: check::sound;

    ensure fits: "a ledger evidence accepts measures only tied functions of the model, with every input and an output, and reviews only what a review can name"
        from (checked);
    ensure links: "a review of a link names one of its piece's links, an ensure's from list or a require's ensure, and each voice reviews a piece or a link once"
        from (checked);
    ensure no_test_reviews: "a review by a test's voice is refused, V007: a test measures, someone reviews seeing it";
}
