// The dogfood model of `src/check.rs`: core2 modelled in its own
// language, beside the code it models (the parts it uses are read by
// `use … from`). The whole model: `mitra check src/bin/mitra.mitra`.

// What check gives is a list of errors: opaque.
subject record Errors;

subject check {
    use Model from "model";
    use catalogue from "catalogue";
    require codes: catalogue::never_reused;

    fn check(m: Model) -> errors: Errors at "crates/mitra-lang/src/check.rs/check";
    ensure sound: "a model check gives no error for has every path resolved, every type agreed, no support cycle, every proof checked by type and by one run, and one value for each function at each point of its examples"
        from (codes, one_value);
    ensure one_value: "two examples of a function at one point that give different values are the error M024";
    ensure in_ranges: "a range type that holds no number is the error M025, an example outside one M026";
    ensure empty_sets: "a range of a rule's set whose low end is at or above its high end holds no point and is the error M034, with the range it likely meant";
    ensure declared: "an enum with no variant, a type parameter nothing it holds uses, an enum that holds itself in every variant, or a record that holds itself, is the error M027";
    ensure recursion: "a function calls itself only on parts of one of its inputs a `match` takes apart, the same for every call (M019 otherwise); a claim `by induction t` names such an input that is a tree (M031 otherwise)";
    ensure short_proofs: "a rule's proof written as its step alone, `by tollens`, shows the rule only when exactly one proof of that step from the rule's premises, each as it is or negated, shows it; none, or two listed as they are written in full, is M032";
    ensure invariants: "a claim `by invariant` of a function whose body is no loop, `by invariant n` of an `until`, or with `n` a name the function or its loop has, is M033";
    ensure nested: "a part holding parts that holds more than parts, requires, ensures and examples is M028, one of its ensures resting on more than its inner parts' ensures and its own requires M029, a `self` not first or in a part with no record M030";
    // Finding 45 J6, shown by tests/static_gaps.rs: warnings that refuse
    // nothing (A019, A020, A021).
    ensure cases_made: "every case of an enum the model makes is made by some body, or the model says which case nothing makes";
    ensure failures_carried: "a function that calls something that can fail either carries the failure in what it gives or says how it is handled";
    ensure inputs_read: "every input of a function with a body is read by that body";
    ensure type_explained: "a type error (M005, M006) shows the expression, underlines its innermost part with no type and the type of each argument, says what that operation takes, and converts no number";
}
