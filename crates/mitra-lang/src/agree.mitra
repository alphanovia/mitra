// The dogfood model of `src/agree.rs`: core2 modelled in its own
// language, beside the code it models (the parts it uses are read by
// `use … from`). The whole model: `mitra check src/bin/mitra.mitra`.

subject agree {
    // The settings, as Rust has them: `agree::Settings`.
    subject record Settings at "crates/mitra-lang/src/agree.rs/Settings" { points: integer, splits: integer, budget: Budget, length: integer, height: integer }
    use Budget from "simulation";
    use check from "check";
    use simulation from "simulation";
    require checked: check::sound;
    // A value of the world an example of the model gives is read first.
    require given: simulation::given_first;
    require exact: simulation::exact_right;
    require ranges: simulation::ranges_sound;
    require kept: simulation::kept_sound;
    require promised: simulation::promised;
    require ranges_checked: simulation::ranges_checked;
    // Each limit a setting, none fixed in the code.
    require stops: simulation::budgeted;

    fn agree_defaults() -> s: Settings at "crates/mitra-lang/src/agree.rs/Settings/default" {
        Settings { points: 64, splits: 4, budget: Budget { steps: 100000, depth: 1000 }, length: 3, height: 3 }
    }
    ensure no_false_holds: "agree says Holds only when what the model says twice agrees at every point where the claims of functions with no body hold"
        from (checked, exact, ranges, kept, given, promised);
    ensure within_ranges: "agree reads a claim only where the ranges of what its function takes hold, checks that the body keeps the range of what it gives, and tries every point of the ranges when they hold at most `points`" from (ranges_checked);
    // Shown by the hint A010 and the `given` of each finding, seen by the tests.
    ensure given_named: "when an answer of agree relies on the claims of a function with no body, it names them as assumptions" from (promised);
    ensure no_false_none: "agree says no value keeps a function's claims (A004) only when none does"
        from (checked, exact, ranges, kept);
    ensure lengths: "agree tries sequences from `[]` up to `Settings::length` long, of the values worth trying of what they hold";
    ensure heights: "agree tries trees up to `Settings::height` levels in themselves, of the values worth trying of what they hold";
    ensure invariant: "a claim `by invariant` holds when it holds at its loop's start and each turn keeps it: by bounds, what the loop carries any value that keeps the claim, or as linear facts, each equality put in place; under `by invariant n`, `n` is 0 at the start, one more each turn, the length folded at the end" from (ranges, promised);
    ensure induction: "a claim `by induction t` holds by bounds only when it holds where each call of its function on a part of `t` gives what the claim says there; a part of a tree is any tree to bounds, never none" from (ranges, promised);
    ensure ends: "the agreement ends: a claim that reaches a budget, by bounds or at points, is unknown (A007), with the budget it reached" from (checked, stops);
    // Shown by tests/one_run.rs (finding 39 B): another value is A002, a
    // call with no value A014, a callee's claim that refuses the value
    // A017, a given never called A015, a budget A016, an `until` that
    // comes back A013; an input known in part is read as a claim.
    ensure examples: "an example is one run: everything it states is used; on a function with a body it holds or fails, saying why, and on one with none, the code measured at its input decides";
}
