// The dogfood model of `src/explain.rs`: core2 modelled in its own
// language, beside the code it models (the parts it uses are read by
// `use … from`). The whole model: `mitra check src/bin/mitra.mitra`.

subject record Explanation at "crates/mitra-lang/src/explain.rs/Explanation";

subject explain {
    // The settings, as Rust has them: `explain::Settings`.
    subject record Settings at "crates/mitra-lang/src/explain.rs/Settings" { rounds: integer, cases: integer, rests: integer, budget: Budget }
    use Budget from "simulation";
    use check from "check";
    use evidence from "evidence";
    use judgement from "judgement";
    use reader from "reader";
    use simulation from "simulation";
    require in_part: simulation::known_in_part;
    require checked: check::sound;
    // What a measurement saw an opaque function give is read first.
    require given: simulation::given_first;
    require fits: evidence::fits;
    require kernel: judgement::sound;
    require read: reader::nothing_dropped;
    require linked: evidence::links;

    fn explain_defaults() -> s: Settings at "crates/mitra-lang/src/explain.rs/Settings/default" {
        Settings { rounds: 64, cases: 1024, rests: 1024, budget: Budget { steps: 1000000, depth: 1000 } }
    }
    ensure drift: "a value measured outside the range of its type is a taking against the function at that point, by its ties, and X011 says which value; a failed test there takes nothing" from (fits);
    ensure no_points: "an all or an any over a set its condition leaves with no point is given nothing from its points, and X013 says so: never explained by no evidence";
    ensure worlds: "what the environment gave a run is part of the point it is judged at: two worlds are two points, and a point in a world is an instance or a witness of an all, never one of its cases";
    ensure only_known: "a measurement known in part is a taking only where what it knows decides; elsewhere X010 says which field" from (in_part);
    ensure verdicts: "each proposition is explained, assumed, contradicted or unsupported, as judgement gives it from the model and the ledger; assumed names the links no one reviewed and the requires in words it rests on"
        from (checked, fits, kernel, read, given);
    ensure asks: "explain asks for a review of each link no review answers, from what an ensure rests on to the ensure, and of each ensure said only in words, with the line to write once reviewed; a require that names an ensure is that ensure, so it is never asked"
        from (linked);
}
