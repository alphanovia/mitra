// The Rust code of a project, as Mitra takes it to be (std::fs).
//
// A boundary: the files are the project's, and which revision they are
// is the word of whoever runs the command.

import std::core::{Option, Result};
import std::rust::{Vec};

boundary code {
    ensure reads_what_is_there = "Reading a Rust file gives its whole text, and listing `src/` and `tests/` gives every Rust file under them.";
    ensure is_the_revision_named = "The files read are the code of the revision the evidence is recorded at. Mitra does not ask git: the caller says which revision it is.";

    // A folder: Rust's own `std::path::Path`.
    record Path;

    fn read_to_string(path: String) -> Result<String, String>;
    fn read_dir(path: String) -> Result<Vec<String>, String>;
}
