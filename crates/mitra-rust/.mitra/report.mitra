// The report of `cargo test` (src/report.rs).
//
// A report reaches this code as text: reading the file is the caller's.
// JUnit XML is not Rust's: mitra-lang reads it (its results.mitra).

// One test of a report, and whether it passed: mitra-lang's, stated and
// tied in its own model.
import mitra_lang::results::{Outcome};

subject report {
    ensure reads_results = "Every test in a cargo test report is read, with its name and whether it passed.";

    fn libtest(text: String) -> Vec<Outcome>;
}
