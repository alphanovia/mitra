// The points the tests pin: each is a claim. The test that checks it is
// the `fn` under the comment `// mitra: evidence for <claim>`, in the
// Rust file named above the claim.

// src/report.rs

claim t_libtest_ok() { reader::libtest("test tests::t_small ... ok") == [Outcome("t_small", true)] }

claim t_libtest_failed() { reader::libtest("test t_big ... FAILED") == [Outcome("t_big", false)] }

claim t_libtest_timed() {
    reader::libtest("test t_timed ... ok <0.001s>") == [Outcome("t_timed", true)]
}

claim t_libtest_ignored() { reader::libtest("test tests::slow ... ignored") == [] }

claim t_libtest_other_lines() {
    reader::libtest("running 3 tests\ntest result: FAILED. 1 passed; 1 failed") == []
}

claim t_libtest_two() {
    reader::libtest("test a ... ok\ntest b ... FAILED") == [Outcome("a", true), Outcome("b", false)]
}

// src/source.rs

claim t_line_doc() {
    source::mitra_line("/// mitra: claim c : correct(f(1))") == Some("claim c : correct(f(1))")
}

claim t_line_plain() {
    source::mitra_line("    // mitra: claim c : correct(f(1))") == Some("claim c : correct(f(1))")
}

claim t_line_keeps_indent() { source::mitra_line("// mitra:   then 1") == Some("  then 1") }

claim t_line_comment() { source::mitra_line("// a comment about mitra: no") == None }

claim t_line_code() { source::mitra_line("let x = 1; // mitra: claim c : correct(f(1))") == None }

claim t_below_plain() { source::fn_below("fn f() {}") == Some("f") }

claim t_below_qualified() { source::fn_below("pub(crate) const unsafe fn f() {}") == Some("f") }

claim t_below_attribute() {
    source::fn_below("#[cfg_attr(test, allow(unused))]\npub async fn f<T>() {}") == Some("f")
}

claim t_below_struct() { source::fn_below("pub struct S;\nfn f() {}") == None }

claim t_below_nothing() { source::fn_below("") == None }
