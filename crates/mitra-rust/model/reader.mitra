// mitra-rust as a reader of code (src/report.rs, src/tie.rs).
//
// It fills the contract `Reader` of mitra-lang for Rust: the report of
// `cargo test` as plain results, the tests tied to claims, and the code
// tied to the model compared with it. What the contract promises of any
// reader is owed here for Rust, as `reader::Rust::compares_shape` and
// the others. JUnit XML is not Rust's: mitra-lang reads it.
//
// `Rust` is the reader, a struct with nothing in it (src/tie.rs). Its
// functions are those of the contract, written again where they use
// the disk.

import std::core::{Option, Result};

import mitra_lang::Reader;
// A model, a test result and a test tied to a claim: mitra-lang's,
// stated and tied in its own model. `Model` comes without its fields:
// they name types of mitra-lang that are not brought here.
import mitra_lang::model::{Model};
import mitra_lang::results::{Outcome, Tied};
// What comparing gives back: the core's, the same for any reader.
import mitra_lang::frontend::{Found};

subject reader {
    record Rust;

    // The report of `cargo test` as plain results: what `Rust::results`
    // gives (src/report.rs).
    fn libtest(text: String) -> List<results::Outcome>;

    impl Reader<Path> for Rust {
        require code_read = code::reads_what_is_there;
        require right_revision = code::is_the_revision_named;
        require comments_found = source::finds_ties;

        // Every test of `src/` and `tests/` tied to a claim.
        fn tests(&self, root: Path) -> Result<List<results::Tied>, String>
            uses code::read_to_string, code::read_dir, source::mitra_line, source::fn_below;

        // Compare the code under `root` with the model.
        fn tie(&self, root: Path, model: model::Model, rev: Option<String>) -> Result<frontend::Found, String>
            uses code::read_to_string, code::read_dir;
    }
}
