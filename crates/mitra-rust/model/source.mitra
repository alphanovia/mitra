// The comments of a Rust file that tie its code to the model
// (src/source.rs).

import std::core::{Option, Result};

subject source {
    ensure finds_ties = "A tie comment in Rust code is found, with the name of the function or test written below it.";

    // The text after `mitra:` in a comment line.
    fn mitra_line(line: String) -> Option<String>;

    // The name of the `fn` that the code starts with.
    fn fn_below(code: String) -> Option<String>;

    // Whether the text after `mitra:` ties code to the model.
    fn is_tie(m: String) -> bool;

    claim implements_is_a_tie() {
        is_tie("implements a::f")
    }
    claim evidence_for_is_a_tie() {
        is_tie("evidence for a::c given x = 1 gives 2")
    }
    claim a_line_of_model_is_no_tie() {
        !is_tie("subject fn f() -> Bool;")
    }
}
