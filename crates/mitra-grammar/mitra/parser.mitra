-- Dogfood: Mitra's claims about its own parser.
-- A seed names one program from the generator (src/gen.rs): a model file
-- and an evidence file. The fuzz test turns each run into evidence.

-- The reference grammar (LALRPOP) accepts the program: the generator is sound.
opaque grammar_accepts (seed : Int) : Bool
-- The hand-written parser accepts the program.
opaque parses (seed : Int) : Bool
-- parse → print → parse gives the same AST.
opaque round_trips (seed : Int) : Bool

claim grammar_sample : ∀ seed ∈ Icc 0 499, grammar_accepts seed = true
claim parses_sample : ∀ seed ∈ Icc 0 499, parses seed = true
claim round_trips_sample : ∀ seed ∈ Icc 0 499, round_trips seed = true
-- What we would like: the parser accepts every generated program.
claim parses_all : ∀ seed, parses seed = true

policy strict
