# The reference grammar, left-factored and without left recursion, so that
# it can be checked LL(1). One rule per line: `A = alt | alt ;`.
# Quoted symbols are tokens; NAT DEC STR NAME are token classes;
# an empty alternative is ε.

Model         = Command Model | ;
Command       = Record | Enum | Opaque | Def | Claim | Test ;
Record        = "record" NAME "(" NAME RecordRest ;
# Fields, or type parameters then fields.
RecordRest    = ":" Set ParamsTail ")" | NamesTail ")" Params ;
Enum          = "enum" NAME EnumParams "{" Variant VariantsTail "}" ;
EnumParams    = "(" NAME NamesTail ")" | ;
Variant       = NAME VariantFields ;
VariantFields = Params | ;
VariantsTail  = "," Variant VariantsTail | ;
Test          = "test" NAME ":" Foralls Judgment ;
Opaque        = "opaque" NAME FnParams "->" Set ;
Def           = "def" NAME FnParams "->" Set ":=" Expr ;
Params        = "(" Param ParamsTail ")" ;
FnParams      = "(" FnParamsRest ;
FnParamsRest  = ")" | NAME FnAfterName ;
FnAfterName   = ":" Set ParamsTail ")" | NamesTail ")" "(" FnFields ;
FnFields      = ")" | Param ParamsTail ")" ;
ParamsTail    = "," Param ParamsTail | ;
Param         = NAME ":" Set ;
Claim         = "claim" NAME ":" ClaimRest ;
ClaimRest     = "uniform" NAME By | Only "uses" NAME "[" NAME NamesTail "]"
              | Foralls ClaimBody Derive ;
By            = "by" NAME | ;
ClaimBody     = "correct" "(" NAME Args ")" | Expr ClaimEq ;
ClaimEq       = "=" Expr | ;
Only          = "only" | ;
Derive        = ":=" "by" "derive" "[" NAME NamesTail "]" | ;
NamesTail     = "," NAME NamesTail | ;

Evidences     = Evidence Evidences | ;
Evidence      = Attributes "evidence" Foralls Judgment "at" Number ;
Attributes    = "@[" NAME STR AttrsTail "]" | ;
AttrsTail     = "," NAME STR AttrsTail | ;
Judgment      = "correct" "(" NAME Args ")" | Not Negated | NAME Args Output
              | Measure "=" Number ;
Measure       = "rate" "(" NAME In Set "," Expr ")" | Score "(" NAME ")" ;
Score         = "precision" | "recall" | "false_positive_rate" ;
Negated       = "correct" "(" NAME Args ")" | NAME Args ;
Output        = "=" Value | ;

# ASCII first; Lean's Unicode symbols are aliases.
ForallKw      = "forall" | "∀" ;
In            = "in" | "∈" ;
Not           = "not" | "¬" ;
Union         = "|" | "∪" ;
InterOp       = "&" | "∩" | "\" ;

Foralls       = ForallKw NAME InSet "," Foralls | ;
InSet         = In Set | ;
Args          = "(" ArgsRest | ;
ArgsRest      = ")" | Arg ArgsTail ")" ;
ArgsTail      = "," Arg ArgsTail | ;
Arg           = NAME ArgRecord | "true" | "false" | Num | "-" Num | STR
              | "(" TupleRest | "[" Values "]" | "{" Braces ;
ArgRecord     = "(" Value ValuesTail ")" | ;

Set           = Inter SetTail ;
SetTail       = Union Inter SetTail | ;
Inter         = SetAtom InterTail ;
InterTail     = InterOp SetAtom InterTail | ;
SetAtom       = "Bool" | "Int" | "Int8" | "Int16" | "Int32" | "Int64"
              | "UInt8" | "UInt16" | "UInt32" | "Float64" | "String" | "Value"
              | "{" Values "}" | "(" SetsRest
              | NAME SetArgs | "List" "(" Set ")"
              | "Set" "(" Set ")" | "Map" "(" Set MapValues ")"
              | Bound RangeOp | ".." Bound | "..=" Bound ;
MapValues     = "," Set | ;
SetArgs       = "(" Set SetsTail ")" | ;
SetsTail      = "," Set SetsTail | ;
SetsRest      = ")" Arrow | Set SetsTail ")" Arrow ;
# `(A, B) -> C`: a function type.
Arrow         = "->" SetAtom | ;
RangeOp       = "..=" Bound | ".." OptBound ;
Bound         = NAT | "-" NAT ;
OptBound      = Bound | ;
Values        = Value ValuesTail | ;
ValuesTail    = "," Value ValuesTail | ;

Expr          = "if" Expr "then" Expr "else" Expr | "let" NAME ":=" Expr ";" Expr | Or ;
Or            = And OrTail ;
OrTail        = "||" And OrTail | ;
And           = Compare AndTail ;
AndTail       = "&&" Compare AndTail | ;
Compare       = Sum CompareTail ;
CompareTail   = CmpOp Sum CompareTail | ;
CmpOp         = "==" | "!=" | "<" | "<=" | ">" | ">=" | In ;
# `|` and `\` on sets and maps bind like `+`, `&` like `*`.
Sum           = Product SumTail ;
SumTail       = "+" Product SumTail | "-" Product SumTail
              | "|" Product SumTail | "\" Product SumTail | ;
Product       = Unary ProductTail ;
ProductTail   = "*" Unary ProductTail | "/" Unary ProductTail | "&" Unary ProductTail | ;
Unary         = "!" Unary | "-" Unary | Atom Postfix ;
Postfix       = "." Field Postfix | "[" Expr "]" Postfix | ;
Field         = NAME | NAT ;
Atom          = NAME CallArgs | Literal | "(" ExprsRest | "[" Exprs "]"
              | "len" "(" Expr ")" | "keys" "(" Expr ")" | "{" BracesExpr | "match" Expr "{" Arm ArmsTail "}" | Measure ;
Arm           = ArmPattern "=>" Expr ;
ArmsTail      = "," Arm ArmsTail | ;
ArmPattern    = "_" | NAME ArmFields ;
ArmFields     = "(" NAME NamesTail ")" | ;
CallArgs      = "(" ExprsRest | ;
ExprsRest     = ")" | Expr ExprsTail ")" ;
Exprs         = Expr ExprsTail | ;
ExprsTail     = "," Expr ExprsTail | ;
Literal       = "true" | "false" | Num | STR ;

Value         = "true" | "false" | Num | "-" Num | STR
              | "(" TupleRest | NAME ArgRecord
              | "[" Values "]" | "{" Braces ;
# A set `{}`, `{a, b}` or a map `{:}`, `{k: v}`.
# `()` is the unit value.
TupleRest     = ")" | Value "," Value ValuesTail ")" ;
Braces        = "}" | ":" "}" | Value BracesRest ;
BracesRest    = ":" Value Pairs "}" | ValuesTail "}" ;
Pairs         = "," Value ":" Value Pairs | ;
BracesExpr    = "}" | ":" "}" | Expr BracesExprRest ;
BracesExprRest = ":" Expr PairsExpr "}" | ExprsTail "}" ;
PairsExpr     = "," Expr ":" Expr PairsExpr | ;
Num           = NAT | DEC ;
Number        = NAT | DEC ;
