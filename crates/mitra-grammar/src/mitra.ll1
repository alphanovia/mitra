# The reference grammar, left-factored and without left recursion, so that
# it can be checked LL(1). One rule per line: `A = alt | alt ;`.
# Quoted symbols are tokens; NAT DEC STR NAME are token classes;
# an empty alternative is ε.

Model         = Command Model | ;
Command       = Opaque | Def | Claim | Test | Profile | Policy ;
Test          = "test" NAME ":" Foralls Judgment ;
Opaque        = "opaque" NAME Binders ":" Set ;
Def           = "def" NAME Binders ":" Set ":=" Expr ;
Binders       = Binder BindersTail ;
BindersTail   = Binder BindersTail | ;
Binder        = "(" NAME Names ":" Set ")" ;
Names         = NAME Names | ;
Claim         = "claim" NAME ":" ClaimRest ;
ClaimRest     = "uniform" NAME "by" NAME | "uses" NAME "[" NAME NamesTail "]"
              | Foralls ClaimBody Derive ;
ClaimBody     = "correct" "(" NAME Args ")" | NAME Args "=" Expr ;
Derive        = ":=" "by" "derive" "[" NAME NamesTail "]" | ;
NamesTail     = "," NAME NamesTail | ;
Profile       = "profile" NAME "for" NAME Regions ;
Regions       = "|" Region "=>" Number Regions | ;
Region        = "_" | NAME In Set ;
Policy        = "policy" PolicyRest ;
PolicyRest    = "strict" | NAME ":=" PolicyKind ;
PolicyKind    = "strict" | "coverage" ProfileName ;
ProfileName   = NAME | "uniform" ;

Evidences     = Evidence Evidences | ;
Evidence      = Attributes "evidence" Foralls Judgment "at" Number ;
Attributes    = "@[" NAME STR AttrsTail "]" | ;
AttrsTail     = "," NAME STR AttrsTail | ;
Judgment      = "correct" "(" NAME Args ")" | Not Negated | NAME Args Output ;
Negated       = "correct" "(" NAME Args ")" | NAME Args ;
Output        = "=" Value | ;

# ASCII first; Lean's Unicode symbols are aliases.
ForallKw      = "forall" | "∀" ;
In            = "in" | "∈" ;
Not           = "not" | "¬" ;
Union         = "|" | "∪" ;
InterOp       = "&" | "∩" | "\" ;

Foralls       = ForallKw NAME InSet "," Foralls | ;
InSet         = In Set | ;
Args          = Arg Args | ;
Arg           = NAME | "true" | "false" | Num | STR | "(" "-" Num ")" ;

Set           = Inter SetTail ;
SetTail       = Union Inter SetTail | ;
Inter         = SetAtom InterTail ;
InterTail     = InterOp SetAtom InterTail | ;
SetAtom       = "Bool" | "Int" | "Int8" | "Int16" | "Int32" | "Int64"
              | "UInt8" | "UInt16" | "UInt32" | "Float64" | "String" | "Value"
              | "{" Values "}" | "(" Set ")"
              | Bound RangeOp | ".." Bound | "..=" Bound ;
RangeOp       = "..=" Bound | ".." OptBound ;
Bound         = NAT | "-" NAT ;
OptBound      = Bound | ;
Values        = Value ValuesTail | ;
ValuesTail    = "," Value ValuesTail | ;

Expr          = "if" Expr "then" Expr "else" Expr | "let" NAME ":=" Expr ";" Expr | Or ;
Or            = And OrTail ;
OrTail        = "||" And OrTail | ;
And           = Compare AndTail ;
AndTail       = "&&" Compare AndTail | ;
Compare       = Sum CompareTail ;
CompareTail   = CmpOp Sum CompareTail | ;
CmpOp         = "==" | "!=" | "<" | "<=" | ">" | ">=" ;
Sum           = Product SumTail ;
SumTail       = "+" Product SumTail | "-" Product SumTail | ;
Product       = Unary ProductTail ;
ProductTail   = "*" Unary ProductTail | ;
Unary         = "!" Unary | "-" Unary | NAME Atoms | Literal | "(" Expr ")" ;
Atoms         = Atom Atoms | ;
Atom          = NAME | Literal | "(" Expr ")" ;
Literal       = "true" | "false" | Num | STR ;

Value         = "true" | "false" | Num | "-" Num | STR ;
Num           = NAT | DEC ;
Number        = NAT | DEC ;
