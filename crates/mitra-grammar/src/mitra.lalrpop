// The reference grammar (docs/reference/language.md), as LALRPOP.
// A recognizer: every action is `()`. It is not the production parser.
// LALRPOP refuses to build a grammar with any conflict, so a clean build
// proves this grammar is unambiguous and LR(1).

grammar;

match {
    r"\s*" => { },
    r"--[^\n\r]*" => { },
    r"[0-9]+" => NAT,
    r"[0-9]+\.[0-9]+" => DEC,
    r#""[^"\n]*""# => STR,
    "opaque", "def", "claim", "test", "evidence",
    "correct", "at", "by", "derive", "if", "then", "else", "let",
    "true", "false", "forall", "in", "not",
    "Bool", "Int", "Int8", "Int16", "Int32", "Int64", "UInt8", "UInt16", "UInt32",
    "Float64", "String", "Value", "Real",
    "_", "uniform", "uses", "only",
    "@[", "..=", "..", ":=", "=>", "->", "==", "!=", "<=", ">=", "&&", "||",
    "(", ")", ":", ";", ",", "=", "{", "}", "[", "]", "|", "&",
    "!", "<", ">", "+", "-", "*", "\\", "∀", "∈", "∪", "∩", "¬",
} else {
    r"[A-Za-z_][A-Za-z0-9_]*" => NAME,
}

Comma1<T>: () = T ("," T)* => ();

pub Model: () = Command* => ();
Command: () = { Opaque, Def, Claim, Test };
Test: () = "test" NAME ":" Forall* Judgment => ();

Opaque: () = "opaque" NAME Params "->" Set => ();
Def: () = "def" NAME Params "->" Set ":=" Expr => ();
Params: () = "(" Comma1<Param> ")" => ();
Param: () = NAME ":" Set => ();
Claim: () = {
    "claim" NAME ":" Forall* ClaimBody Derive? => (),
    "claim" NAME ":" "uniform" NAME "by" NAME => (),
    "claim" NAME ":" "only"? "uses" NAME "[" Comma1<NAME> "]" => (),
};
ClaimBody: () = {
    "correct" "(" NAME Args? ")" => (),
    NAME Args? "=" Expr => (),
};
Derive: () = ":=" "by" "derive" "[" Comma1<NAME> "]" => ();

pub Evidences: () = Evidence* => ();
Evidence: () = Attributes? "evidence" Forall* Judgment "at" Number => ();
Attributes: () = "@[" Comma1<Attribute> "]" => ();
Attribute: () = NAME STR => ();
Judgment: () = {
    "correct" "(" NAME Args? ")" => (),
    Not "correct" "(" NAME Args? ")" => (),
    Not NAME Args? => (),
    NAME Args? => (),
    NAME Args? "=" Value => (),
};

// ASCII first; Lean's Unicode symbols are aliases.
ForallKw: () = { "forall" => (), "∀" => () };
In: () = { "in" => (), "∈" => () };
Not: () = { "not" => (), "¬" => () };
Union: () = { "|" => (), "∪" => () };
InterOp: () = { "&" => (), "∩" => (), "\\" => () };

Forall: () = {
    ForallKw NAME "," => (),
    ForallKw NAME In Set "," => (),
};
Args: () = "(" Comma1<Arg> ")" => ();
Arg: () = {
    NAME => (), "true" => (), "false" => (), Num => (), "-" Num => (), STR => (),
};

Set: () = { Inter, Set Union Inter => () };
Inter: () = { SetAtom, Inter InterOp SetAtom => () };
SetAtom: () = {
    "Bool" => (), "Int" => (), "Int8" => (), "Int16" => (), "Int32" => (),
    "Int64" => (), "UInt8" => (), "UInt16" => (), "UInt32" => (),
    "Float64" => (), "String" => (), "Value" => (),
    "{" "}" => (),
    "{" Comma1<Value> "}" => (),
    "(" Set ")" => (),
    Bound "..=" Bound => (),
    Bound ".." Bound => (),
    Bound ".." => (),
    "..=" Bound => (),
    ".." Bound => (),
};
Bound: () = { NAT => (), "-" NAT => () };
Num: () = { NAT => (), DEC => () };

Expr: () = {
    "if" Expr "then" Expr "else" Expr => (),
    "let" NAME ":=" Expr ";" Expr => (),
    Or,
};
Or: () = { And, Or "||" And => () };
And: () = { Compare, And "&&" Compare => () };
Compare: () = { Sum, Compare CmpOp Sum => () };
CmpOp: () = { "==" => (), "!=" => (), "<" => (), "<=" => (), ">" => (), ">=" => () };
Sum: () = { Product, Sum "+" Product => (), Sum "-" Product => () };
Product: () = { Unary, Product "*" Unary => () };
Unary: () = {
    "!" Unary => (),
    "-" Unary => (),
    NAME => (),
    NAME "(" Comma1<Expr> ")" => (),
    Literal => (),
    "(" Expr ")" => (),
};
Literal: () = { "true" => (), "false" => (), Num => (), STR => () };

Value: () = { "true" => (), "false" => (), Num => (), "-" Num => (), STR => () };
Number: () = { NAT => (), DEC => () };
