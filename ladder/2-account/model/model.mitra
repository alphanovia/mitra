// Rung 2 of the ladder (ladder/README.md): a record, and an invariant
// that every value the code builds must keep.
import std::core::{Option};
subject bank {
    ensure bounded = "An account is never overdrawn past its limit: a withdrawal that would pass it is refused.";
    ensure exact = "A deposit adds exactly its amount and a withdrawal takes exactly its amount.";
    ensure frozen = "A closed account takes no deposit and gives no money.";

    record Account { balance: Int, limit: Nat, closed: Bool }
    impl Account {
        fn new(limit: Nat) -> Self;
        fn deposit(&self, n: Nat) -> Self;
        fn withdraw(&self, n: Nat) -> Option<Self>;
        fn close(&self) -> Self;

        claim within_limit(self) { self.balance + self.limit >= 0 }
    }

    claim starts_empty(limit: Nat) { Account::new(limit) == Account(0, limit, false) }
    claim deposit_adds(a: Account, n: Nat) when !a.closed {
        a.deposit(n) == Account(a.balance + n, a.limit, false)
    }
    claim withdraw_takes(a: Account, n: Nat) when !a.closed && a.balance + a.limit >= n {
        a.withdraw(n) == Some(Account(a.balance - n, a.limit, false))
    }
    claim refuses_past_limit(a: Account, n: Nat) when a.balance + a.limit < n {
        a.withdraw(n) is None
    }
    claim closes(a: Account) { a.close() == Account(a.balance, a.limit, true) }
    claim closed_is_frozen(a: Account, n: Nat) when a.closed {
        a.deposit(n) == a && a.withdraw(n) is None
    }
}

// What the tests draw from: accounts and amounts under a thousand.
fn small(n: Nat) -> Bool { n < 1000 }
