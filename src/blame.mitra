// The dogfood model of `src/blame.rs`: core2 modelled in its own
// language, beside the code it models (the parts it uses are read by
// `use … from`). The whole model: `mitra check src/bin/mitra.mitra`.

subject record BlameSettings at "src/blame.rs/Settings" { diagnoses: integer, tries: integer }

subject blame {
    use explain from "explain";
    require explained: explain::verdicts;
    fn blame_defaults() -> s: BlameSettings at "src/blame.rs/Settings/default" {
        BlameSettings { diagnoses: 10, tries: 100000 }
    }
    ensure minimal: "each diagnosis is a smallest set of suspects whose drop leaves nothing contradicted"
        from (explained);
}
