// The dogfood model of `src/expression.rs`: core2 modelled in its own
// language, beside the code it models (the parts it uses are read by
// `use … from`). The whole model: `mitra check src/bin/mitra.mitra`.

subject record Expression at "src/expression.rs/Expression";

subject expression {
    ensure binding: "an expression is a binding tree: each name is bound once, an argument is read at most once, a fault is lazy";
    ensure substitution: "substitute replaces free names only, and never captures";
}
