// The dogfood model of `src/numbers.rs`: core2 modelled in its own
// language, beside the code it models (the parts it uses are read by
// `use … from`). The whole model: `mitra check src/bin/mitra.mitra`.

environment float {
    // Rust's f64, which numbers.rs computes with.
    ensure near: "f64 arithmetic on the numbers of numbers.rs is within 1e-12 of the exact result";
}

subject record NumbersSettings at "src/numbers.rs/Settings" {
    base_rate: rational, prior_weight: rational, checker: rational, voices: Voices
}

// An opinion in numbers.
subject record Belief at "src/numbers.rs/Belief" {
    belief: rational, disbelief: rational, uncertainty: rational, expected: rational
}

// An opinion with its base rate, as multiplication reads it.
subject record Said at "src/numbers.rs/Said" { b: rational, d: rational, u: rational, a: rational }

// The voices' weights are a map: opaque.
subject record Voices;

subject numbers {
    use explain from "explain";
    require explained: explain::verdicts;
    require near: float::near;

    // From a belief and a disbelief, with base rate a: a conflict (more
    // than 1 together) is read in proportion, with no uncertainty.
    fn opinion(belief: rational, disbelief: rational, a: rational) -> o: Belief
        at "src/numbers.rs/Belief/of"
    {
        let total = belief + disbelief in
        let b = if 1.0 < total { belief / total } else { belief } in
        let d = if 1.0 < total { disbelief / total } else { disbelief } in
        let u = if 1.0 - b - d < 0.0 { 0.0 } else { 1.0 - b - d } in
        Belief { belief: b, disbelief: d, uncertainty: u, expected: b + a * u }
    } where {
        claim sums_to_one: o.belief + o.disbelief + o.uncertainty == 1.0;
        claim in_unit: !(0.0 <= belief && 0.0 <= disbelief && 0.0 <= a && a <= 1.0)
            || (0.0 <= o.expected && o.expected <= 1.0);
    }

    // r runs for, s against (weighted by voice), prior weight w, base
    // rate a. As Settings::sane does, a weight below 0 is read as 0 and
    // the base rate is clamped into [0, 1]. (Weights are also capped at
    // 1e300 and NaN read as 0 or 1/2: neither can be written here.)
    fn fused(r: rational, s: rational, w: rational, a: rational) -> o: Belief at "src/numbers.rs/fused" {
        let r0 = if r < 0.0 { 0.0 } else { r } in
        let s0 = if s < 0.0 { 0.0 } else { s } in
        let w0 = if w < 0.0 { 0.0 } else { w } in
        let a0 = if a < 0.0 { 0.0 } else { if 1.0 < a { 1.0 } else { a } } in
        let n = r0 + s0 + w0 in
        if 0.0 < n { opinion(r0 / n, s0 / n, a0) } else { opinion(0.0, 0.0, a0) }
    } where {
        claim nothing_known: !(r <= 0.0 && s <= 0.0) || !(0.0 <= a && a <= 1.0) || o.expected == a;
        claim clean_rate: 0.0 <= o.expected && o.expected <= 1.0;
        examples { (97.0, 3.0, 2.0, 1/2) -> Belief { belief: 97/102, disbelief: 1/34, uncertainty: 1/51, expected: 49/51 } }
    }

    // Subjective Logic's binomial multiplication (Jøsang, McAnally).
    fn times(x: Said, y: Said) -> z: Said at "src/numbers.rs/times" {
        let k = 1.0 - x.a * y.a in
        if 0.0 < k {
            Said {
                b: x.b * y.b + ((1.0 - x.a) * y.a * x.b * y.u + x.a * (1.0 - y.a) * x.u * y.b) / k,
                d: x.d + y.d - x.d * y.d,
                u: x.u * y.u + ((1.0 - y.a) * x.b * y.u + (1.0 - x.a) * x.u * y.b) / k,
                a: x.a * y.a
            }
        } else {
            Said {
                b: x.b * y.b,
                d: x.d + y.d - x.d * y.d,
                u: x.u * y.u + x.b * y.u + x.u * y.b,
                a: x.a * y.a
            }
        }
    } where {
        // Certain truth, with base rate 1, is the unit of multiplication.
        examples { (Said { b: 1.0, d: 0.0, u: 0.0, a: 1.0 }, Said { b: 1/2, d: 1/4, u: 1/4, a: 1/2 })
                   -> Said { b: 1/2, d: 1/4, u: 1/4, a: 1/2 } }
    }

    ensure in_unit: "every number given is in [0, 1], and belief, disbelief and uncertainty add to 1"
        from (opinion::sums_to_one, opinion::in_unit, near);
}
