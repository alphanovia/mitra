// The fall (docs/model.md): the stone, in the system, falls from a
// tower; the sun, outside it, gives light. The same model as the one
// tests/model.rs builds by hand.

environment sun {
    // How the sun gives light is not known: the function is opaque.
    fn light() -> w: Real;

    // No list: only someone taking it holds it.
    ensure shines = "at least 200 W/m² at noon";
}

subject stone {
    // The sun's ensure gives the first; the second is a hypothesis.
    require light = sun::shines;
    require air = "still air";

    // How the stone falls: nature does it, how is not known. Tied to
    // the drop in the tower.
    fn drop(h: Real) -> v: Real at "lab/tower/stone" where {
        // v² = 2·g·h, within 2 m²/s².
        claim falls: within(v * v, 2.0 * 9.81 * h, 2.0);
        // From 20 m or less, under 21 m/s.
        claim slow: !(h <= 20.0) || v < 21.0;
        // Arithmetic, which no rule of judgement does: assumed.
        rule slows: drop::falls, speed::slow |- drop::slow;
        // The same, shown by modus ponens: the checker takes it.
        rule lands: drop::slows, drop::falls, speed::slow |- drop::slow
            by ponens(drop::slows, drop::falls, speed::slow);
    }

    // The model's own square of the speed: it has a body.
    fn speed(h: Real) -> v2: Real { 2.0 * 9.81 * h } where {
        claim slow: !(h <= 20.0) || v2 < 400.0;
        // What it gives at 5 m: 2 · 9.81 · 5.
        examples { (5.0) -> 98.1 }
    }

    ensure lands_slow = "lands slowly" from (speed::slow, drop::falls);
}
