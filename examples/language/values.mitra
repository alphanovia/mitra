// Values: the types and expressions a model writes.
// Every function here has a body, so `mitra check` runs it on its claims.

// A data part: a record with a name of its own.
subject record Point { x: rational, y: rational }

// A data part that is one of its variants.
subject enum Shape { Dot(Point), Square(rational) }

subject Shapes {
    fn area(s: Shape) -> a: rational {
        match s { Dot(p) => 0.0, Square(side) => side * side }
    } where {
        examples { (Shape::Square(3.0)) -> 9.0 }
    }

    // `let x = …;` names a value in a block, as in Rust.
    fn far(p: Point) -> d: rational {
        let dx = p.x;
        let dy = p.y;
        dx * dx + dy * dy
    } where {
        examples { (Point { x: 3.0, y: 4.0 }) -> 25.0 }
    }

    // A range type: an integer that is checked to stay in 0..=9.
    fn digit(n: 0..=49) -> d: 0..=9 { n % 10 } where {
        claim at_most: d <= n;
        examples { (42) -> 2 }
    }

    // A sequence and its length; reading past its end has no value.
    fn first_or(xs: [integer], other: integer) -> y: integer {
        if xs.len() == 0 { other } else { xs[0] }
    } where {
        examples { ([7, 8], 0) -> 7, ([], 5) -> 5 }
    }

    // Text is `[~char]`: its length is in bytes, as in Rust.
    fn greet(name: [~char]) -> g: [~char] { "hello " ++ name } where {
        examples { ("ana") -> "hello ana" }
    }

    // A loop over a sequence: `fold` carries one value, given back bare.
    fn total(xs: [integer]) -> t: integer { xs.fold(sum: 0) { x -> sum + x } } where {
        examples { ([1, 2, 3]) -> 6, ([]) -> 0 }
    }

    // Two values carried: a tuple with labels, read `.sum` or `.0`.
    fn mean(xs: [integer]) -> m: integer {
        let c = xs.fold((sum: 0, n: 0)) { x -> (sum + x, n + 1) };
        if c.n == 0 { 0 } else { c.sum / c.n }
    } where {
        examples { ([2, 4, 9]) -> 5, ([]) -> 0 }
    }

    // A while loop: `until` stops at the first carried value where `k <= 1`.
    fn halvings(n: integer) -> s: integer {
        until((k: n, steps: 0), k <= 1) { (k / 2, steps + 1) }.steps
    } where {
        examples { (8) -> 3, (1) -> 0 }
    }
}
