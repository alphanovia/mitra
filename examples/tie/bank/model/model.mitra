// The model, aside from the code.
import std::claims::{uniform};
record Account { balance: Nat, open: Bool }

subject bank {
    fn deposit(a: Account, n: Nat) -> Account {
        if a.open { Account(a.balance + n, true) } else { a }
    }
    fn withdraw(a: Account, n: Nat) -> (Account, Bool) uses only check;
    fn check(a: Account, n: Nat) -> Bool { a.open && n <= a.balance }
    fn close(a: Account) -> Account;

    claim deposit_uniform = uniform(deposit, |a, n| a.open);
}

claim deposit_adds() { bank::deposit(Account(0, true), 5) == Account(5, true) }
