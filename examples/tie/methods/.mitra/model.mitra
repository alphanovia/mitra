// An `impl` as Rust writes it, tied to the methods of the real `impl`.
subject bank {
    record Account { balance: Int, .. }
    impl Account {
        fn open() -> Self;
        fn deposit(&mut self, amount: Int) -> Self;
        fn can_pay(&self, amount: Int) -> Bool { self.balance >= amount }
        fn close(self) -> Int;
        claim never_negative(self) { self.balance >= 0 }
    }
}
