// The reply: well formulated, and never silence.

subject Reporter {
    fn report(r: Result<Answer, HarnessFailure>, a: Ask) -> reply: Reply;
    fn decline(v: Verdict) -> reply: Reply;
    fn ask_back(a: Ask) -> reply: Reply;
    fn helped(sent: bool) -> reply: Reply;
    fn tuned(s: Preferences) -> reply: Reply;
    // Our model could not judge the message: nothing was done (C11).
    // It says why: the message is too long for our model, or our model
    // is down (W5).
    fn unchecked(f: LlmFailure) -> reply: Reply;
    // The owner said yes: what the held call gave (C16).
    fn confirmed(o: Outcome) -> reply: Reply;
    // A yes that names no held call, or from someone who may not give it.
    // The same words either way, so a guess learns nothing (C16).
    fn not_allowed() -> reply: Reply;
    // What the owner's phone is told of a held call: who asks, what, and
    // the code to answer with (C16).
    // CHOICE TO CONFIRM (C17, round 3): the owner sees the sender's own
    // words, the tool, and the call's input only when it is short (32
    // characters at most) and plain; else its length. The input shown is
    // exactly what will run, so the owner can judge it; a short plain
    // input can still be worded to mislead ("send 100 to mum"). Kept as a
    // named residual: hiding it would leave the owner saying yes blind.
    fn ask_owner(h: Hold, from: Holder) -> reply: Reply;
    // The server stopped while working on it: it was not finished (C12),
    // and the calls that had begun may have run (H13).
    fn interrupted(begun: [Call]) -> reply: Reply;
    // The owner is told that calls may have run for another device.
    fn begun(cs: [Call], from: Holder) -> reply: Reply;
    ensure explains_failure: "a failure or a refusal is told as what was not done, and why";   // rule, measured
    ensure clear: "plain words, one point at a time: what was done, and what was not";       // quality, measured

    // Names from the other files.
    use Result from "std";
    use Answer from "vocabulary";
    use HarnessFailure from "vocabulary";
    use Ask from "vocabulary";
    use Verdict from "vocabulary";
    use Reply from "vocabulary";
    use Preferences from "vocabulary";
    use LlmFailure from "vocabulary";
    use Outcome from "vocabulary";
    use Hold from "vocabulary";
    use Holder from "vocabulary";
    use Call from "vocabulary";
}
