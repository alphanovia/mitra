// The two machines for the model, and which one works on what.
//
// Decided (user, 2026-11-25 19:22): the frontier model, in the cloud and
// not ours, works out the user's instruction; our smaller local model
// manages the request (identity aside: security, safety, purpose) and may
// do easy tasks too. Who answers, by preference: plain code when it can
// (Commands), then the local model, then the frontier model.

// A model behind inference: stateless; how it answers is not known.
environment Llm {
    // Its window holds what it reads and what it writes back; `reserve`
    // is the room kept for the answer (the API's max_tokens). Bytes stand
    // for tokens until a tokenizer part. `machine` says which one it is.
    record { window: integer, reserve: integer, machine: Machine }
    fn inference(self, request: [~char], tools: [Tool]) -> a: Result<Answer, LlmFailure> where {
        claim windowed: request.len() + self.reserve <= self.window || a == Err(LlmFailure::TooLong);
    }
    ensure refuses_long: "a request that leaves less than the reserve in the window is refused"
        from (inference::windowed);

    // Names from the other files.
    use Result from "std";
    use Answer from "vocabulary";
    use LlmFailure from "vocabulary";
    use Tool from "vocabulary";
    use Machine from "vocabulary";
}

environment CloudLlm {
    ensure serves: "a provider's frontier model, not ours, answers inference over the network";
}
subject LocalLlm {
    use Server from "server/server";
    require server: Server::reachable;
    ensure serves: "a smaller model, on a machine of ours, answers inference and judges messages";
}

// The two machines, and how many turns the agent loop may take with one
// before it gives up (a setting; H12).
subject Models {
    use Ask from "vocabulary";
    use Machine from "vocabulary";
    record { cloud: Llm, local: Llm, turns: integer }

    require cloud: CloudLlm::serves;
    require local: LocalLlm::serves;

    // Which machine works out an ask. Its inputs are all finite, so Mitra
    // tries every one: the claims hold.
    fn machine(easy: bool) -> m: Machine {
        if easy { Machine::Local } else { Machine::Cloud }
    } where {
        // Local before frontier: an easy ask never goes to the cloud.
        claim local_first: !easy || m == Machine::Local;
        // The user's instruction is worked out by the frontier model.
        // CHOICE TO CONFIRM (C7): when the cloud cannot be reached, the user
        // is told; the ask is not handed down to our model, nor queued.
        claim no_downgrade: easy || m == Machine::Cloud;
    }

    fn llm(self, m: Machine) -> l: Llm {
        match m { Machine::Local => self.local, Machine::Cloud => self.cloud }
    }

    // The model for an ask.
    fn pick(self, a: Ask) -> l: Llm {
        self.llm(machine(a.easy))
    }

    ensure cheapest_first: "an easy ask is answered by our model, and only a harder one goes to the frontier model"
        from (machine::local_first, local);
    ensure frontier_for_work: "the user's real work goes to the frontier model, and is never quietly done by a weaker one"
        from (machine::no_downgrade, cloud);
}
