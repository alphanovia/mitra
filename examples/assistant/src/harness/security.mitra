// Who sent a message, what code can answer at once, and whether there is
// anything to do.

// Who sent it. Identity depends on the device: one assumption per device,
// and each goes into the user manual.
environment Identity {
    use Message from "vocabulary";
    use Person from "vocabulary";
    fn who(m: Message) -> p: Person;
    require phone: "on a phone, the phone's lock tells its owner: the manual asks for a password on it";
    require computer: "on a computer, the session's login tells its user";
    require voice: "on the wearable, voice recognition tells the user's voice from others'";
    ensure identified: "each message is given the person its device tells, or a stranger"
        from (phone, computer, voice);
}

// Plain code, before any model (decided: a machine answer when it can).
// CHOICE TO CONFIRM (C8): a short fixed list of read-only commands (the
// time, "say it again", what a setting is), and a list of help words
// that call for help even when no model is up.
subject Commands {
    fn answer(m: Message, p: Person) -> r: Option<Reply> where {
        examples {
            (Message { holder: Holder { household: 1, device: Device::Computer, number: 1 }, text: "What time is it?", recognised: true }, Person { role: Role::Owner }) -> Option::Some(Reply { text: "It is ten o'clock." }),
            (Message { holder: Holder { household: 1, device: Device::Computer, number: 1 }, text: "open the door", recognised: true }, Person { role: Role::Owner }) -> Option::None
        }
    }
    // Exact words, so that "help me with my email" is no alarm.
    fn alarm(m: Message) -> help: bool where {
        examples {
            (Message { holder: Holder { household: 1, device: Device::Computer, number: 1 }, text: "Help", recognised: true }) -> true,
            (Message { holder: Holder { household: 1, device: Device::Computer, number: 1 }, text: "au secours", recognised: true }) -> true,
            (Message { holder: Holder { household: 1, device: Device::Computer, number: 1 }, text: "help me with my email", recognised: true }) -> false
        }
    }
    ensure plain_first: "a request plain code can answer is answered without any model";       // capability, shown by examples
    ensure read_only: "an answer by plain code only tells, and never acts on anything";        // property: answer has no tools to call
    ensure help_words: "a call for help in plain words is passed on even when no model is up";  // rule, measured on the word list

    // Names from the other files.
    use Option from "std";
    use Message from "vocabulary";
    use Person from "vocabulary";
    use Reply from "vocabulary";
    use Holder from "vocabulary";
    use Device from "vocabulary";
    use Role from "vocabulary";
}

// Security, by the local model: is there anything to do?
subject Gate {
    // It fails when our model cannot be reached (C11).
    fn screen(m: Message, p: Person) -> v: Result<Verdict, LlmFailure> where {
        // Nothing heard is noise: a voice the server could not make out
        // comes here with no words.
        claim empty_is_noise: m.text != "" || v == Ok(Verdict::Noise) || v == Err(LlmFailure::Unreachable);
    }
    require identified: Identity::identified;
    require local: LocalLlm::serves;
    ensure spots_malice: "a message meant to do harm is judged malicious";                          // quality, measured
    ensure spots_noise: "noise, a cat on the keyboard or a sound, is judged noise"                  // quality, measured
        from (screen::empty_is_noise);
    ensure help_first: "a call for help is recognised whatever the role or the doubt";             // measured
    ensure few_refused: "a real message of the user is rarely refused or taken for noise";        // quality, measured

    // Names from the other files.
    use LocalLlm from "models";
    use Message from "vocabulary";
    use Person from "vocabulary";
    use Verdict from "vocabulary";
    use LlmFailure from "vocabulary";
    use Result from "std";
}
