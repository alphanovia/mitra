// The harness: one message through the pipeline, and the agent loop in it.
//
//   Identity -> Commands (plain code) -> Gate -> Purpose -> Experience
//     -> the loop on the chosen model (Composer -> Llm -> Policy -> Tool -> ToolGuard)
//     -> Reporter
//
// with a call for help passed on first, and meta messages to Tuning. The
// harness returns the reply and the notes its steps made; the server
// keeps both (see server/worker.mitra).

subject Harness {
    require identified: Identity::identified;
    require framed: Conversation::framed;
    require refuses_long: Llm::refuses_long;
    require fits: Composer::fits_window;
    // The loop ends: a leaf in words, nothing in the model shows it.
    require stops: "the model, in the end, asks for no tool, or inference fails, within the turns allowed";

    // One message, through the pipeline: the reply, and the notes made.
    fn serve(m: Message, history: Conversation, models: Models, tools: [Tool]) -> out: (reply: Reply, notes: [Annotation]) {
        let p = Identity::who(m);
        let seen = [Annotation { by: Step::Identity, note: Note::Sender(p) }];
        if Commands::alarm(m) {
            (reply: Reporter::helped(Helpline::alert(p, m)),
             notes: seen ++ [Annotation { by: Step::Commands, note: Note::Verdict(Verdict::Distress) }])
        } else {
            match Commands::answer(m, p) {
                Option::Some(r) => (reply: r, notes: seen),
                Option::None => match Gate::screen(m, p) {
                    // CHOICE TO CONFIRM (C11): our model cannot judge it, so nothing
                    // is done, and the sender is told; plain code and help words
                    // above still work.
                    Err(f) => (reply: Reporter::unchecked(f), notes: seen),
                    Ok(v) => {
                        let judged = seen ++ [Annotation { by: Step::Gate, note: Note::Verdict(v) }];
                        match after_gate(v, p.role) {
                            Route::Work => match Purpose::pin(m, p, history) {
                                Err(f) => (reply: Reporter::unchecked(f), notes: judged),
                                Ok(a) => {
                                    let asked = judged ++ [Annotation { by: Step::Purpose, note: Note::Ask(a) }];
                                    match after_ask(a.clear) {
                                        Route::Work => {
                                            let done = run(models.pick(a), models.turns, a, p, Experience::recall(a, p), history, tools);
                                            (reply: Reporter::report(done.result, a), notes: asked ++ called(done.c.outcomes(), a))
                                        },
                                        Route::AskBack => (reply: Reporter::ask_back(a), notes: asked),
                                        // Never: after_ask gives Work or AskBack. `match` needs the arms.
                                        Route::Help => (reply: Reporter::ask_back(a), notes: asked),
                                        Route::Tune => (reply: Reporter::ask_back(a), notes: asked),
                                        Route::Decline => (reply: Reporter::ask_back(a), notes: asked)
                                    }
                                }
                            },
                            Route::Help => (reply: Reporter::helped(Helpline::alert(p, m)), notes: judged),
                            Route::Tune => (reply: Reporter::tuned(Tuning::adjust(m, p)), notes: judged),
                            Route::Decline => (reply: Reporter::decline(v), notes: judged),
                            // Never: after_gate gives no AskBack.
                            Route::AskBack => (reply: Reporter::decline(v), notes: judged)
                        }
                    }
                }
            }
        }
    }

    // Where a verdict sends a message. Finite: Mitra tries every verdict
    // and role.
    fn after_gate(v: Verdict, role: Role) -> r: Route {
        match v {
            Verdict::Act => Route::Work,
            Verdict::Distress => Route::Help,
            // A stranger does not tune the assistant (H8).
            Verdict::Meta => if role == Role::Stranger { Route::Decline } else { Route::Tune },
            Verdict::Noise => Route::Decline,
            Verdict::Malicious => Route::Decline
        }
    } where {
        // Only a message judged a request is worked on.
        claim only_requests: r != Route::Work || v == Verdict::Act;
        // A malicious message, or noise, goes no further than a reply.
        claim benign_only: v != Verdict::Malicious || r == Route::Decline;
        claim signal_only: v != Verdict::Noise || r == Route::Decline;
        // A call for help is passed on.
        claim helps: v != Verdict::Distress || r == Route::Help;
        // A judgement of the assistant tunes it, never runs as a request.
        claim scored: r != Route::Tune || v == Verdict::Meta;
        claim strangers_tune_nothing: role != Role::Stranger || r != Route::Tune;
    }

    // Where an ask goes: worked on when clear, else asked back.
    fn after_ask(clear: bool) -> r: Route {
        if clear { Route::Work } else { Route::AskBack }
    } where {
        claim asks_first: clear || r == Route::AskBack;
        claim works_clear: !clear || r == Route::Work;
    }

    // Each tool call made, as a note of the policy.
    // A call held for a yes also gets its code (C16).
    fn called(os: [Outcome], a: Ask) -> ns: [Annotation] {
        os.fold(ns: []) { o -> ns ++ [Annotation { by: Step::Policy, note: Note::Called(o) }] ++ held(o, a) }
    }
    // The hold keeps what the sender asked, so the owner reads the sender's
    // words beside the call the model chose (K2).
    fn held(o: Outcome, a: Ask) -> ns: [Annotation] {
        if awaits(o) { [Annotation { by: Step::Policy, note: Note::Held(Hold { code: Codes::fresh(), call: o.call, asked: a.text }) }] } else { none() }
    }
    fn none() -> ns: [Annotation] { [] }
    fn awaits(o: Outcome) -> a: bool {
        match o.output { Ok(_) => false, Err(f) => f == ToolFailure::AwaitsYes }
    }

    // The agent loop, on one model: the Composer builds each request from
    // the conversation; tools run as the Policy says, outputs pass the guard.
    // It gives up after `turns` answers of the model that still call a
    // tool (H12).
    fn run(llm: Llm, turns: integer, a: Ask, p: Person, h: Habits, history: Conversation, tools: [Tool])
        -> out: (result: Result<Answer, HarnessFailure>, c: Conversation) {
        if a.text == "" { (result: empty(), c: history) } else {
            let start = Conversation { turns: history.turns ++ [Turn::User(a.text)] };
            let first = Composer::compose(a, Purpose::context(a, start), h, llm);
            let last = until((c: start, got: llm.inference(first, tools), k: 1), finished(got) || k >= turns) {
                match got {
                    Ok(ans) => {
                        let next = Conversation {
                            turns: c.turns ++ [Turn::Model(ans), Turn::Results(perform_all(ans.calls, p, h, tools, read_output(c)))]
                        };
                        (next, llm.inference(Composer::compose(a, Purpose::context(a, next), h, llm), tools), k + 1)
                    },
                    // Never reached: an Err is finished. `match` needs the arm.
                    Err(_) => (c, got, k)
                }
            };
            (result: if finished(last.got) { lifted(last.got) } else { too_many() }, c: last.c)
        }
    } where {
        // What until means: it stops at a final answer or a failure (finding D).
        claim ends: match out.result { Ok(ans) => ans.calls.len() == 0, Err(_) => true };
        // An empty ask is refused.
        claim refused: a.text != "" || out.result == Err(HarnessFailure::EmptyPrompt);
    }

    fn empty() -> r: Result<Answer, HarnessFailure> { Err(HarnessFailure::EmptyPrompt) }
    fn too_many() -> r: Result<Answer, HarnessFailure> { Err(HarnessFailure::TooManyTurns) }

    // The model's failure, as the harness's. Named apart: a `match` in a
    // tuple cannot be typed (finding R).
    fn lifted(got: Result<Answer, LlmFailure>) -> r: Result<Answer, HarnessFailure> {
        match got { Ok(ans) => Ok(ans), Err(e) => Err(HarnessFailure::Llm(e)) }
    }

    // When the loop stops: a final answer, or a failure.
    fn finished(got: Result<Answer, LlmFailure>) -> f: bool {
        match got { Ok(ans) => ans.calls.len() == 0, Err(_) => true }
    } where {
        examples {
            (Ok(Answer { text: "hi", calls: [] })) -> true,
            (Err(LlmFailure::Unreachable)) -> true
        }
    }

    // Every call, in order: a tool of the harness's own list, run only
    // when allowed, its output guarded. A name not on the list runs
    // nothing (H1).
    fn perform_all(calls: [Call], p: Person, h: Habits, tools: [Tool], after_output: bool) -> rs: [Outcome] {
        calls.fold(rs: []) { c -> rs ++ [Outcome { call: c, output: match lookup(c.tool, tools) {
            Option::None => unknown(),
            Option::Some(t) => {
                let d = Policy::allow(t, c, p, h, after_output);
                if runs(d) { ToolGuard::screen(act(t, c)) } else { Err(withheld(d)) }
            }
        } }] }
    } where {
        claim each: rs.len() == n by invariant n;
        examples { ([], Person { role: Role::Owner }, Habits {}, [], false) -> [] }
    }
    // A tool runs only once its call is written down (H13).
    fn act(t: Tool, c: Call) -> got: Result<[~char], ToolFailure> {
        Ahead::mark(c); t.call(c.input)
    }
    // Whether a tool's output has been read in this request: a call after
    // it may be the output's word, not the user's (K1).
    fn read_output(c: Conversation) -> r: bool {
        c.outcomes().fold(r: false) { o -> r || match o.output { Ok(_) => true, Err(_) => false } }
    }
    fn unknown() -> got: Result<[~char], ToolFailure> { Err(ToolFailure::Unknown) }

    // The tool of this name in the harness's list, if any.
    fn lookup(name: [~char], tools: [Tool]) -> t: Option<Tool> {
        tools.fold(t: no_tool()) { x -> if x.name == name { Option::Some(x) } else { t } }
    } where {
        examples {
            ("door", [Tool { name: "door", description: "opens the front door", level: Level::Irreversible }])
                -> Option::Some(Tool { name: "door", description: "opens the front door", level: Level::Irreversible }),
            ("door", []) -> Option::None
        }
    }
    fn no_tool() -> t: Option<Tool> { Option::None }

    // Whether a decision runs the tool, and why not when it does not.
    // Finite: Mitra tries every decision.
    fn runs(d: Decision) -> r: bool {
        d == Decision::Run
    } where {
        claim only_run: r == (d == Decision::Run);
    }
    fn withheld(d: Decision) -> f: ToolFailure {
        match d { Decision::Confirm => ToolFailure::AwaitsYes, Decision::Refuse => ToolFailure::Refused, Decision::Run => ToolFailure::Refused }
    } where {
        claim waits: d != Decision::Confirm || f == ToolFailure::AwaitsYes;
    }

    // What the harness keeps, by its bodies.
    ensure answers: "every message the harness serves ends in a reply, whichever way it went"
        from (run::ends, stops);
    ensure machine_first: "plain code answers before any model is asked, and our model judges a message before the frontier one sees it";   // route in serve (finding A)
    ensure helps: "a call for help is passed on, by plain code before any model, or as soon as our model recognises it"
        from (after_gate::helps);
    ensure benign_only: "a malicious message or noise goes no further than a reply saying so"
        from (after_gate::benign_only, after_gate::signal_only, after_gate::only_requests);
    ensure scored: "a message judging the assistant tunes it, and is never run as a request"
        from (after_gate::scored);
    ensure fails_closed: "when our model cannot judge a message, nothing is done with it, and the sender is told";   // route in serve (finding A)
    ensure guarded: "only a tool of the assistant's own list runs, only when the policy says so, and its output passes the guard"
        from (runs::only_run, withheld::waits, perform_all::each);   // the lookup is shown by lookup's examples
    ensure bounded: "the agent loop gives up after the turns the settings allow, and says so";   // route in run (finding D)
    ensure asks_first: "an unclear ask is asked back before any model works on it"
        from (after_ask::asks_first, run::refused);
    ensure composed: "every request the loop sends is the composer's, for the model it goes to"
        from (fits);
    ensure noted: "each step that decides about a message leaves a note saying what it decided";   // route in serve (finding A)

    // Names from the other files.
    use Result from "std";
    use Option from "std";
    use Ahead from "store";
    use Message from "vocabulary";
    use Person from "vocabulary";
    use Verdict from "vocabulary";
    use Ask from "vocabulary";
    use Habits from "vocabulary";
    use Reply from "vocabulary";
    use Annotation from "vocabulary";
    use Note from "vocabulary";
    use Step from "vocabulary";
    use Tool from "vocabulary";
    use Call from "vocabulary";
    use Answer from "vocabulary";
    use Outcome from "vocabulary";
    use Turn from "vocabulary";
    use Decision from "vocabulary";
    use Role from "vocabulary";
    use ToolFailure from "vocabulary";
    use LlmFailure from "vocabulary";
    use HarnessFailure from "vocabulary";
    use Conversation from "conversation";
    use Identity::who from "security";
    use Commands::{answer, alarm} from "security";
    use Gate::screen from "security";
    use Purpose::{pin, context} from "purpose";
    use Experience::recall from "purpose";
    use Composer::compose from "purpose";
    use Models from "models";
    use Llm from "models";
    use Policy::allow from "tools";
    use ToolGuard::screen from "tools";
    use Helpline::alert from "care";
    use Tuning::adjust from "care";
    use Reporter::{report, decline, ask_back, helped, tuned, unchecked} from "reply";
    use Route from "vocabulary";
    use Level from "vocabulary";
    use Hold from "vocabulary";
    use Codes::fresh from "server/confirm";
}
