// The owner's yes (C16, from the challenger's H2). A call the policy holds
// gets a code; the owner's phone is told. Only "yes <code>" from a device
// that vouches for the owner runs it, once. Plain code reads the yes and
// checks it against the store: no model ever decides it.

// Where codes come from.
environment Codes {
    fn fresh() -> c: integer;
    ensure unguessable: "each held call gets a fresh code that cannot be guessed from the others";
}

subject Confirmations {
    require identified: Identity::identified;
    require unguessable: Codes::unguessable;
    require append_only: Stored::append_only;

    // The code a message gives when it says "yes <code>", if any. Plain code.
    fn code(text: [~char]) -> c: Option<integer> where {
        examples {
            ("yes 123456") -> Option::Some(123456),
            ("  YES 42 ") -> Option::Some(42),
            ("yes") -> Option::None,
            ("yes 12a") -> Option::None,
            ("yes 1234567890123") -> Option::None,
            ("I said yes 123456") -> Option::None
        }
    }

    // A yes: the held call runs when the sender may allow it, and the code
    // is noted as used, in the same write as the reply.
    fn confirm(store: ConversationStore, c: integer, m: Message, tools: [Tool]) -> out: (reply: Reply, notes: [Annotation]) {
        let p = Identity::who(m);
        let seen = [Annotation { by: Step::Identity, note: Note::Sender(p) }];
        match store.held(c) {
            Option::None => (reply: Reporter::not_allowed(), notes: seen),
            Option::Some(call) => if allowed(p.role, m.recognised) {
                let o = Outcome { call: call, output: run(call, tools) };
                (reply: Reporter::confirmed(o),
                 notes: seen ++ [Annotation { by: Step::Confirmations, note: Note::Confirmed(c) }, Annotation { by: Step::Confirmations, note: Note::Called(o) }])
            } else { (reply: Reporter::not_allowed(), notes: seen) }
        }
    }

    // Who may say yes: the owner, on a device that vouches for them.
    // Finite: Mitra tries every case.
    fn allowed(role: Role, recognised: bool) -> ok: bool {
        role == Role::Owner && recognised
    } where {
        claim owner_only: !ok || role == Role::Owner;
        claim vouched: !ok || recognised;
    }

    // The held call, run through the same list and guard as in the loop.
    fn run(c: Call, tools: [Tool]) -> got: Result<[~char], ToolFailure> {
        match Harness::lookup(c.tool, tools) {
            Option::Some(t) => ToolGuard::screen(act(t, c)),
            Option::None => Harness::unknown()
        }
    }

    ensure owner_only: "a held call runs only on the owner's yes, from a device that vouches for the owner"
        from (allowed::owner_only, allowed::vouched, identified);
    ensure once: "a yes works once: the call it allowed is no longer held";   // shown by the scenario tests
    // Not from `unguessable` (it was): a wrong code runs nothing because
    // the store holds no call under it; how hard a code is to guess
    // matters only to the owner, the one voice whose yes counts.
    ensure guessing_fails: "a yes with a code that names no held call runs nothing";   // shown by the tests

    // Names from the other files.
    use Harness::act from "harness/harness";
    use Result from "std";
    use Option from "std";
    use Message from "vocabulary";
    use Reply from "vocabulary";
    use Annotation from "vocabulary";
    use Note from "vocabulary";
    use Step from "vocabulary";
    use Tool from "vocabulary";
    use Call from "vocabulary";
    use Outcome from "vocabulary";
    use Role from "vocabulary";
    use ToolFailure from "vocabulary";
    use ConversationStore from "store";
    use Stored from "store";
    use Identity::who from "security";
    use Harness::{lookup, unknown} from "harness/harness";
    use ToolGuard::screen from "tools";
    use Reporter::{confirmed, not_allowed} from "reply";
}
