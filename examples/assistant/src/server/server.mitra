// The server the assistant runs on, as a whole: what it is and what its
// parts give together.

subject Server {
    use Gateway from "gateway";
    use Worker from "worker";
    use ConversationStore from "store";
    require kept: ConversationStore::kept;
    require recorded_first: Gateway::recorded_first;
    require retry_safe: Gateway::retry_safe;
    require delivers: Gateway::delivers;
    require transcribes: Worker::transcribes;
    require answers_back: Worker::answers_back;
    require traced: Worker::traced;
    require paired_only: Gateway::paired_only;
    require recovers: Worker::recovers;
    require in_order: Worker::in_order;

    ensure hosts: "the assistant is deployed and running on the server";                              // assumption of the deployment
    ensure reachable: "the clients reach the server, and the server reaches both model machines";     // assumption of the network
    ensure messaging: "clients send and receive messages through one API, as with a messaging app"
        from (paired_only, recorded_first, retry_safe, delivers, in_order, answers_back);
    ensure memory: "the server keeps the whole conversation: each message as it came, and what was found out about it"
        from (kept, transcribes, traced);
    ensure robust: "a restart loses no message, and leaves none unanswered"
        from (kept, recovers);

    // The connection limits (K14, K17, K18), settings of the deployment:
    // a connection is admitted while the server has room for one more
    // being read, in all and for its peer's address; past either, it is
    // told busy at once (503), and nothing is done for it. Finite: Mitra
    // tries every case.
    fn admits(full: bool, peer_full: bool) -> ok: bool {
        !full && !peer_full
    } where {
        claim within_cap: !full || !ok;
        claim within_peer: !peer_full || !ok;
    }
    ensure told_busy: "past a connection limit, a call is told at once that the server is busy, and nothing is done for it"
        from (admits::within_cap, admits::within_peer);
}
