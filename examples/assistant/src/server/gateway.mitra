// The entry of the server: one API, shaped like a messaging app's
// (Signal, Matrix). A client sends a message, fetches what is new for it,
// says what it got, and sees when the assistant is working. Adapters to
// existing apps would be more clients of this API (the gateway idea).

// Who may call the entry. CHOICE TO CONFIRM (C10): the owner of a
// household pairs each device once (a code shown on the device, typed on
// the owner's phone) and can revoke it; the device then shows its token on
// every call. One household, one conversation store.
environment Accounts {
    use Option from "std";
    use Token from "vocabulary";
    use Holder from "vocabulary";
    fn holder(t: Token) -> h: Option<Holder>;
    // The owner's phone in a household: where held calls are told (C16).
    fn owner(household: integer) -> h: Holder;
    require paired: "the owner pairs each device of the household once, and revokes a lost one";
    ensure known: "a token names one device of one household until it is revoked, and an unknown token names none"
        from (paired);
}

subject Gateway {
    require known: Accounts::known;
    require kept: ConversationStore::kept;
    require once: ConversationStore::once;

    // A device may post only as itself. Finite: Mitra tries every pair.
    fn may_post(h: Holder, p: Party) -> ok: bool {
        p == Party::Client(h)
    } where {
        claim as_itself: ok == (p == Party::Client(h));
    }

    // The call a client makes: refused unless its token is known and the
    // message is its own; else received. The store given is the one of the
    // token's household (C10).
    fn post(store: ConversationStore, t: Token, e: Envelope) -> out: (store: ConversationStore, receipt: Result<Receipt, NetFailure>) {
        if admits(Accounts::holder(t), store, e) {
            let r = receive(store, e);
            (store: r.store, receipt: accepted(r.receipt))
        } else {
            (store: store, receipt: refused())
        }
    }
    // Admitted: a known token, of this store's household (H6), posting as
    // itself, a text within the size limit (H15), and an id not used for
    // another message (H16).
    fn admits(h: Option<Holder>, store: ConversationStore, e: Envelope) -> ok: bool {
        match h {
            Option::Some(x) => x.household == store.household && may_post(x, e.id.from) && small(e.body)
                               && e.id.n > 0 && e.id.n <= Limits::ids() && !store.conflicts(e),
            Option::None => false
        }
    }
    fn small(b: Body) -> ok: bool {
        match b { Body::Text(t) => t.len() <= Limits::text(), Body::Voice(v) => Speech::bytes(v) <= Limits::voice() }
    }
    fn accepted(r: Receipt) -> got: Result<Receipt, NetFailure> { Ok(r) }
    fn refused() -> got: Result<Receipt, NetFailure> { Err(NetFailure::Refused) }

    // The first act: record the message, then send the receipt. Nothing
    // slow happens before the receipt: no model, no speech.
    fn receive(store: ConversationStore, e: Envelope) -> out: (store: ConversationStore, receipt: Receipt) {
        (store: store.record(e), receipt: Receipt::Received(e.id))
    } where {
        claim stored_first: out.store.holds(e.id);                 // finding E
        claim same_twice: !store.holds(e.id) || out.store == store; // finding E
        examples {
            (ConversationStore { household: 1, messages: [] },
             Envelope { id: MessageId { from: Party::Client(Holder { household: 1, device: Device::Computer, number: 1 }), n: 1 }, body: Body::Text("hello") })
                -> (store: ConversationStore { household: 1, messages: [Stored { id: MessageId { from: Party::Client(Holder { household: 1, device: Device::Computer, number: 1 }), n: 1 },
                                                                  to: Party::Assistant, body: Body::Text("hello"), notes: [] }] },
                    receipt: Receipt::Received(MessageId { from: Party::Client(Holder { household: 1, device: Device::Computer, number: 1 }), n: 1 }))
        }
    }

    // What is new for a client: its replies past the last one it has.
    // Only the token's own device is read. CHOICE TO CONFIRM (C13): a long
    // poll, that waits a while for something new; adapters may push later.
    fn fetch(store: ConversationStore, t: Token, after: integer) -> es: [Stored] {
        match Accounts::holder(t) { Option::Some(h) => if h.household == store.household { replies(store, h, after) } else { nothing() }, Option::None => nothing() }
    }
    fn nothing() -> es: [Stored] { [] }
    fn replies(store: ConversationStore, to: Holder, after: integer) -> es: [Stored] {
        store.for_client(to, after)
    } where {
        examples {
            (ConversationStore { household: 1, messages: [
                Stored { id: MessageId { from: Party::Client(Holder { household: 1, device: Device::Computer, number: 1 }), n: 1 }, to: Party::Assistant, body: Body::Text("hello"), notes: [] },
                Stored { id: MessageId { from: Party::Assistant, n: 2 }, to: Party::Client(Holder { household: 1, device: Device::Computer, number: 1 }), body: Body::Text("hi"), notes: [] },
                Stored { id: MessageId { from: Party::Assistant, n: 3 }, to: Party::Client(Holder { household: 1, device: Device::Wearable, number: 1 }), body: Body::Text("hey"), notes: [] }
             ] }, Holder { household: 1, device: Device::Computer, number: 1 }, 0)
                -> [Stored { id: MessageId { from: Party::Assistant, n: 2 }, to: Party::Client(Holder { household: 1, device: Device::Computer, number: 1 }), body: Body::Text("hi"), notes: [] }],
            // Nothing past what the client already has.
            (ConversationStore { household: 1, messages: [
                Stored { id: MessageId { from: Party::Assistant, n: 2 }, to: Party::Client(Holder { household: 1, device: Device::Computer, number: 1 }), body: Body::Text("hi"), notes: [] }
             ] }, Holder { household: 1, device: Device::Computer, number: 1 }, 2)
                -> []
        }
    }

    // A client says it got a reply: the reply is noted delivered, when it
    // was meant for that client.
    fn delivered(store: ConversationStore, t: Token, id: MessageId) -> s: ConversationStore {
        match Accounts::holder(t) {
            Option::Some(h) => store.annotate_for(id, h, Annotation { by: Step::Gateway, note: Note::Delivered }),
            Option::None => store
        }
    }

    // Where a client's own message stands (W12): delivered once a client
    // said it got the reply, read once taken up, else received. Only the
    // token's own messages are told; any other id has no receipt.
    fn receipt(store: ConversationStore, t: Token, n: integer) -> r: Option<Receipt> {
        match Accounts::holder(t) {
            Option::Some(h) => if h.household == store.household { status(store, MessageId { from: Party::Client(h), n: n }) } else { no_receipt() },
            Option::None => no_receipt()
        }
    }
    fn status(store: ConversationStore, id: MessageId) -> r: Option<Receipt> {
        store.messages.fold(r: no_receipt()) { m ->
            if m.id == id { Option::Some(stage(id, m.read(), store.reply_delivered(m))) } else { r }
        }
    }
    fn stage(id: MessageId, read: bool, delivered: bool) -> r: Receipt {
        if delivered { Receipt::Delivered(id) } else { if read { Receipt::Read(id) } else { Receipt::Received(id) } }
    } where {
        examples {
            (MessageId { from: Party::Client(Holder { household: 1, device: Device::Computer, number: 1 }), n: 1 }, true, true) -> Receipt::Delivered(MessageId { from: Party::Client(Holder { household: 1, device: Device::Computer, number: 1 }), n: 1 }),
            (MessageId { from: Party::Client(Holder { household: 1, device: Device::Computer, number: 1 }), n: 1 }, true, false) -> Receipt::Read(MessageId { from: Party::Client(Holder { household: 1, device: Device::Computer, number: 1 }), n: 1 }),
            (MessageId { from: Party::Client(Holder { household: 1, device: Device::Computer, number: 1 }), n: 1 }, false, false) -> Receipt::Received(MessageId { from: Party::Client(Holder { household: 1, device: Device::Computer, number: 1 }), n: 1 })
        }
    }
    fn no_receipt() -> r: Option<Receipt> { Option::None }

    // The "thinking" sign for a client: a message of its own that the
    // assistant has taken up and not answered yet.
    fn typing_for(store: ConversationStore, t: Token) -> on: bool {
        match Accounts::holder(t) { Option::Some(h) => typing(store, h), Option::None => false }
    }
    fn typing(store: ConversationStore, d: Holder) -> on: bool {
        store.messages.fold(on: false) { m -> on || (m.id.from == Party::Client(d) && m.read() && !m.answered()) }
    } where {
        examples {
            (ConversationStore { household: 1, messages: [
                Stored { id: MessageId { from: Party::Client(Holder { household: 1, device: Device::Wearable, number: 1 }), n: 1 }, to: Party::Assistant, body: Body::Text("hello"),
                         notes: [Annotation { by: Step::Worker, note: Note::Read }] } ] }, Holder { household: 1, device: Device::Wearable, number: 1 }) -> true,
            (ConversationStore { household: 1, messages: [
                Stored { id: MessageId { from: Party::Client(Holder { household: 1, device: Device::Wearable, number: 1 }), n: 1 }, to: Party::Assistant, body: Body::Text("hello"),
                         notes: [Annotation { by: Step::Worker, note: Note::Read },
                                 Annotation { by: Step::Worker, note: Note::Answered(MessageId { from: Party::Assistant, n: 2 }) }] } ] },
             Holder { household: 1, device: Device::Wearable, number: 1 }) -> false
        }
    }

    ensure paired_only: "only a paired device of the household can send or fetch, and only as itself"
        from (may_post::as_itself, known);
    ensure own_household: "a device reaches only the conversation of its own household";   // route in admits and fetch (finding A)
    ensure one_meaning: "an id once used names one message: other words under the same id are refused";   // shown by conflicts' examples
    ensure sized: "a message longer than the size limit, typed or spoken, is refused at the door";   // route in admits (finding A)
    ensure recorded_first: "a message is stored before its receipt goes back, so a receipt always means it is kept"
        from (receive::stored_first, kept);
    ensure receipts: "a client can ask where its own message stands: received, taken up, or its reply delivered";   // shown by stage's examples and the tests
    ensure retry_safe: "a client unsure that its message arrived can safely send it again"
        from (receive::same_twice, once);
    ensure delivers: "each client can fetch, in order, every reply meant for it that it has not seen yet";   // shown by replies' examples
    ensure shows_work: "while the assistant works on a message, the client that sent it can see so";          // shown by typing's examples

    examples {
        // A paired computer posts its own message: stored, then received.
        given Accounts::holder(_) -> Option::Some(Holder { household: 1, device: Device::Computer, number: 1 }),
              Limits::text() -> 4000,
              Limits::ids() -> 9007199254740992
        when Gateway::post(ConversationStore { household: 1, messages: [] }, Token { .. }, Envelope { id: MessageId { from: Party::Client(Holder { household: 1, device: Device::Computer, number: 1 }), n: 1 }, body: Body::Text("hello") })
        then (store: ConversationStore { household: 1, messages: [Stored { id: MessageId { from: Party::Client(Holder { household: 1, device: Device::Computer, number: 1 }), n: 1 }, to: Party::Assistant, body: Body::Text("hello"), notes: [] }] },
              receipt: Ok(Receipt::Received(MessageId { from: Party::Client(Holder { household: 1, device: Device::Computer, number: 1 }), n: 1 }))),
        // The wearable's token, on a message that says it is the computer's: refused, nothing stored.
        given Accounts::holder(_) -> Option::Some(Holder { household: 1, device: Device::Wearable, number: 1 })
        when Gateway::post(ConversationStore { household: 1, messages: [] }, Token { .. }, Envelope { id: MessageId { from: Party::Client(Holder { household: 1, device: Device::Computer, number: 1 }), n: 1 }, body: Body::Text("hello") })
        then (store: ConversationStore { household: 1, messages: [] }, receipt: Err(NetFailure::Refused)),
        // An unknown token: refused.
        given Accounts::holder(_) -> Option::None
        when Gateway::post(ConversationStore { household: 1, messages: [] }, Token { .. }, Envelope { id: MessageId { from: Party::Client(Holder { household: 1, device: Device::Computer, number: 1 }), n: 1 }, body: Body::Text("hello") })
        then (store: ConversationStore { household: 1, messages: [] }, receipt: Err(NetFailure::Refused))
    }

    // Names from the other files.
    use MessageId from "vocabulary";
    use Envelope from "vocabulary";
    use Receipt from "vocabulary";
    use Device from "vocabulary";
    use Party from "vocabulary";
    use Body from "vocabulary";
    use Annotation from "vocabulary";
    use Note from "vocabulary";
    use Step from "vocabulary";
    use ConversationStore from "store";
    use Stored from "store";
    use Option from "std";
    use Result from "std";
    use Token from "vocabulary";
    use Holder from "vocabulary";
    use NetFailure from "vocabulary";
    use Accounts::holder;
    use Limits::{text, voice, ids};
    use Speech::bytes from "speech";
}

// The size limit of a text message, a setting (H15). The models' windows
// are set to hold it (see Composer).
environment Limits {
    fn text() -> n: integer;
    // The size limit of a voice message (K8), and the largest id (K9).
    fn voice() -> n: integer;
    fn ids() -> n: integer;
    ensure set: "the size limits and the largest id are settings the owner can read";
}
