// When a round's code meets the goal set. Plain code on finite counts.
// Success is not guaranteed (answer 2): the Judge only says when the loop
// may stop with success; the budget stops it otherwise.

subject Judge {
    use Tally from "vocabulary";
    use TestReport from "vocabulary";
    use Goal from "vocabulary";

    fn done(g: Goal, t: Tally, r: TestReport) -> d: bool {
        t.contradicted == 0 && t.unsupported == 0 && (g.accept_assumed || t.assumed == 0) && r.failed == 0
    } where {
        claim no_contradiction: !d || t.contradicted == 0;
        claim all_supported: !d || t.unsupported == 0;
        claim assumed_as_set: !d || g.accept_assumed || t.assumed == 0;
        claim tests_pass: !d || r.failed == 0;
    }

    ensure strict: "code meets the goal only when no promise is contradicted or without support, assumed promises are accepted only if the settings say so, and every test passes"
        from (done::no_contradiction, done::all_supported, done::assumed_as_set, done::tests_pass);
}
