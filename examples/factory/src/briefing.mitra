// What the coding harness is told each round. How a brief is written is
// the brief setting's (a prompt; answer 8): here it is opaque.

subject Briefing {
    use Model from "vocabulary";
    use ModelDiff from "vocabulary";
    use Diagnostics from "vocabulary";
    use Brief from "vocabulary";
    use Kind from "vocabulary";
    use TestReport from "vocabulary";

    // The setting: the prompt the briefs are made from.
    record { .. }

    // The first brief: the model, what kind of request it is, what changed
    // in the model, and where the code at the revision falls short of it.
    fn first(self, m: Model, k: Kind, d: ModelDiff, why: Diagnostics) -> b: Brief;
    // The next round's brief: the last one, Mitra's blame on the new code,
    // and the failing tests and build (answer 4).
    fn again(self, b: Brief, why: Diagnostics, tests: TestReport) -> next: Brief;
    // The next round's brief when the harness changed the model: that
    // round's code was thrown away, and the harness is told why.
    fn model_touched(self, b: Brief) -> next: Brief;

    ensure told_why: "each round after the first tells the harness which promises are still not met and which tests fail";
}
