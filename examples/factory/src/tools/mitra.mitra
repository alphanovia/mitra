// Mitra itself, as the factory calls it: check, explain, blame. For the
// factory it is a tool like the others, so an environment; its own model
// (crates/mitra-cli) is what makes these promises, not this file.

environment Mitra {
    use Result from "std";
    use Model from "vocabulary";
    use Tree from "vocabulary";
    use Tally from "vocabulary";
    use Diagnostics from "vocabulary";
    use ModelDiff from "vocabulary";

    // `mitra check`: the model alone.
    fn check(m: Model) -> r: Result<Model, Diagnostics>;
    // `mitra explain`: the model against the code and its tests.
    fn explain(m: Model, t: Tree) -> r: Tally;
    // `mitra blame`: the weakest links, for the next brief.
    fn blame(m: Model, t: Tree) -> r: Diagnostics;
    // What changed from one model to the next. QUESTION Q5: a new Mitra
    // verb (`mitra diff`), or the factory's own code over git?
    fn diff(old: Model, new: Model) -> d: ModelDiff;
    // How many ensures explained in `before` are not explained in `after`,
    // among those the diff left untouched. QUESTION Q5: a new Mitra verb,
    // or the factory's own code?
    fn lost(d: ModelDiff, before: Tally, after: Tally) -> n: integer;

    ensure checks: "Mitra refuses a model it cannot read, with its reasons";
    ensure explains: "Mitra gives one verdict for each promise of the model, from the code and its tests";
}
