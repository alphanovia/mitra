// Where a round happens: the code the harness may write, and the model it
// may only read. CHOICE TO CONFIRM (F3): the model is the request's, never
// the harness's: a round that changes it stops the run.

subject Workspace {
    use Model from "vocabulary";
    use Tree from "vocabulary";

    // Whether the model in the tree is still the one the factory was given.
    // Opaque: in code, a comparison of the .mitra files' bytes.
    fn kept(m: Model, t: Tree) -> k: bool;

    ensure model_read_only: "the coding harness cannot change the model it is coding from";
}
