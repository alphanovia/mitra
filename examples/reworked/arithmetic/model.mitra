// A small arithmetic. The code of `add` and `le` is not modelled: only
// what is claimed of it. `sum3` and `between` are built on them, and
// their bodies say how.
import std::claims::{commutative, associative};

subject arith {
    fn add(a: Int, b: Int) -> Int;
    fn le(a: Int, b: Int) -> Bool;

    claim add_commutes = commutative(add, Int);
    claim add_associates = associative(add, Int);
    claim le_transitive(a: Int, b: Int, c: Int) when le(a, b) && le(b, c) { le(a, c) }

    fn sum3(a: Int, b: Int, c: Int) -> Int { add(add(a, b), c) }
    fn between(a: Int, b: Int, c: Int) -> Bool { le(a, b) && le(b, c) }

    // Commutativity, through one body.
    claim sum3_swaps(a: Int, b: Int, c: Int) { sum3(a, b, c) == sum3(b, a, c) }
    // Commutativity and associativity together.
    claim sum3_reverses(a: Int, b: Int, c: Int) { sum3(a, b, c) == sum3(c, b, a) }
    // Transitivity, through one body.
    claim between_orders(a: Int, b: Int, c: Int) when between(a, b, c) { le(a, c) }
    // Nothing above says this.
    claim sum3_drops(a: Int, b: Int, c: Int) { sum3(a, b, c) == add(a, b) }

    // `uses` alone: nothing says how `total` is built from `add`.
    fn total(a: Int, b: Int) -> Int uses add;
    claim total_commutes(a: Int, b: Int) { total(a, b) == total(b, a) }

    // `uses`, and a claim that ties `plus` to `add`: commutativity crosses.
    fn plus(a: Int, b: Int) -> Int uses add;
    claim plus_adds(a: Int, b: Int) { plus(a, b) == add(a, b) }
    claim plus_commutes(a: Int, b: Int) { plus(a, b) == plus(b, a) }

    // The same without `uses`: the claims on `add` are out of reach.
    fn other(a: Int, b: Int) -> Int;
    claim other_adds(a: Int, b: Int) { other(a, b) == add(a, b) }
    claim other_commutes(a: Int, b: Int) { other(a, b) == other(b, a) }
}
