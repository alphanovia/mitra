// A spam filter: a learned function that cannot be right every time.
enum Verdict { Spam, Ham }
enum Option<T> { None, Some(T) }
record Mail { sender: {"boss", "shop", "stranger"}, links: 0..=2 }

subject filter {
    fn is_spam(m: Mail) -> bool;

    // What the code is specified to do with a verdict.
    fn route(v: Verdict, folder: Option<String>) -> String {
        match v {
            Spam => "junk",
            Ham => match folder {
                Some(name) => name,
                None => "inbox",
            },
        }
    }

    fn score(m: Mail) -> 0..=4 {
        let base = if m.sender == "stranger" { 2 } else { 0 };
        base + m.links
    }

    claim boss_never_spam(m: Mail) when m.sender == "boss" {
        !is_spam(m)
    }

    claim catches_most() {
        rate(m in Mail, is_spam(m) == (score(m) >= 3)) >= 0.8
    }

    claim spam_goes_to_junk(folder: Option<String>) {
        route(Spam, folder) == "junk"
    }

    claim by_sender = uniform(is_spam, |m| -> {"boss", "shop", "stranger"} { m.sender });
}
