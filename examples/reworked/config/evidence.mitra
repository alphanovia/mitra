evidence a_is_down {
    for network::fetch
    given url = "a"
    gives Err(Timeout)
    source "trace:run_1"
}
evidence a_falls_back {
    for loader::load
    given url = "a"
    gives Config(3, false)
    source "trace:run_1"
}
evidence b_is_up {
    for fetch
    given url = "b"
    gives Ok("retries=2")
}
evidence uptime {
    for mostly_up
    gives rate = 0.5
    trust 0.8
    source "dashboard"
}
