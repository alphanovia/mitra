// `represented(f, S)`: one tested input of S stands for all of S, and
// nothing is said outside S. Several on one function; a reviewer vouches
// for each.
import std::claims::{represented};

subject calc {
    fn div(a: 0..=9, b: 0..=9) -> 0..=9 { if b == 0 { 0 } else { a / b } }
    fn abs(x: Int) -> Int { if x < 0 { -x } else { x } }

    claim div_rest = represented(div, { (a, b) | b != 0 });
    claim div_by_zero = represented(div, { (a, b) | b == 0 });
    // A set per input also works, and on an infinite type.
    claim abs_small = represented(abs, 0..=9);
}
