// A pair of integers, and the code that adds and subtracts them.
subject pair {
    record Pair { first: i32, second: i32 }

    // A body is the specification of the code.
    fn add(p1: Pair, p2: Pair) -> Pair {
        Pair(p1.first + p2.first, p1.second + p2.second)
    }

    // No body: the code is opaque.
    fn minus(p1: Pair, p2: Pair) -> Pair;

    fn scale(p: Pair, k: 0..=3) -> Pair uses add;

    claim minus_undoes_add(p1: Pair, p2: Pair) {
        minus(add(p1, p2), p2) == p1
    }

    claim scale_zero(p: Pair) {
        scale(p, 0) == Pair(0, 0)
    }

    claim scale_correct {
        given p: Pair, k: 0..=3
        then correct(scale(p, k))
    }

    claim scale_uniform = uniform(scale, |p, k| k == 0);
}
