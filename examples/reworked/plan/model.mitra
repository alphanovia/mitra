// A model with no code and no evidence: `mitra plan` lists the evidence
// each claim owes. It is the list of tests to write.
import std::claims::{commutative};

subject calc {
    fn div(a: 0..=9, b: 0..=9) -> 0..=9 { if b == 0 { 0 } else { a / b } }
    fn add(a: 0..=1, b: 0..=1) -> 0..=2;

    // One tested point stands for its class, once a reviewer agrees.
    claim div_classes = uniform(div, |a, b| b == 0);
    // A point claim: what a test pins.
    claim div_small() { div(6, 2) == 3 }
    claim add_commutes = commutative(add, 0..=1);
    claim add_is_sum(a: 0..=1) { add(a, 1) == a + 1 }
}
