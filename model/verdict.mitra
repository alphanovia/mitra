// The opinion of a piece: a logical state, and how sure it is. The
// state is found first, by logic alone, from the evidence taken as
// true. Confidence is counted after and never changes a state. Reads
// model.mitra; the counts of model.mitra's own opinion are not used.
//
// Code: src/verdict.rs.

import std::core::{Option};

subject verdict {
    require pieces = piece::everything_is_a_piece;
    require said = evidence::evidence_is_a_piece;
    require counts = piece::opinion_is_counts;
    require whole = tie::a_tie_has_a_whole;
    require related = model::relation_is_said;
    require three = model::three_relations;
    require apart = model::settings_are_apart;

    // After Belnap, 1977, "A Useful Four-Valued Logic": the four
    // states, and that told-true and told-false together is a state
    // of its own and not an error.
    ensure a_state_is_one_of_four = "The state of a piece is one of four: unknown, nothing says anything of it; true; false; conflict, it was found both true and false.";
    ensure evidence_starts_true = "Every piece of evidence starts true: what was reported is taken as it was said, until something says otherwise. No other piece starts with a state. Evidence that counts for nothing is not taken at all.";
    ensure states_spread_by_six_rules = "A state spreads by these rules and no other, until none of them gives anything new. One: evidence that is true and says yes makes the piece it is about true; says no, false. Two: a whole that is true makes each of its parts true. Three: a whole whose parts are all true is true, and a whole with a false part is false. Four: a whole that is false, with every part true but one, makes that one false. Five: a claim that is true is true at every input observed, and a claim false at one input is false. Six: a claim true at one input, with its uniform true, is true. The order the rules are applied in changes nothing.";
    ensure the_verdict_is_read_from_the_states = "The verdict of a model is one state: conflict if any piece is in conflict; else false if a statement is false; else unknown if a statement is unknown, whatever the others are; else true. The statements are every piece that is spoken of and is not itself evidence, a relation, or the reliability of a voice.";
    ensure evidence_counts_as_it_stands = "A piece of evidence counts for what it says, a yes or a no and how many, as far as it stands and as far as its voice is believed. It stands at its base rate, moved by the evidence that says yes about it: a review of a test is what makes the test count for more. A voice counts once for what it says of one piece.";
    // The least to give up is a minimum cut: Ford and Fulkerson, 1956,
    // "Maximal Flow Through a Network". Departs: found here by trying
    // every set of evidence, which is exact and slow.
    ensure sure_is_what_must_be_given_up = "Confidence is counted after the states and never changes one. A state is as sure as the least evidence that would have to be given up for it to fall: that much is its count. So two tests of one thing add up, and a state that every way to it goes through one review is no surer than that review. Nothing is counted for a piece that is unknown or in conflict. A verdict that holds is as sure as its least sure statement, which is named: it is where more evidence helps most.";
    // After Reiter, 1987, "A Theory of Diagnosis from First
    // Principles", and de Kleer and Williams, 1987, "Diagnosing
    // Multiple Faults": the smallest sets of assumptions to give up.
    // Departs: ranked by how much each set counts for, not by a
    // probability.
    ensure a_conflict_names_what_to_give_up = "When a piece is in conflict, the smallest sets of evidence that leave no conflict once given up are listed, the one that counts for least first. Nothing is given up silently.";
    ensure a_false_whole_names_its_suspects = "A whole that is false with more than one part not known true refutes none of them: those parts cannot all be true, and they are listed, the least expected first. A part that is itself a whole stands for its own parts.";

    enum State { Unknown, True, False, Conflict }
    // A state and its counts: of yes for a true piece, of no for a
    // false one. None for a piece that is unknown or in conflict.
    record Verdict {
        state: State,
        confidence: Option<piece::Opinion>,
    }
    // Everything read of a model at once.
    record Reading {
        pieces: List<(piece::Piece, Verdict)>,
        suspects: List<List<piece::Piece>>,
    }

    // Both said of one piece.
    fn joined(x: State, y: State) -> State;
    // What a piece of evidence says: yes, no, or neither.
    fn says(e: evidence::Evidence) -> Option<Bool>;
    // How far a piece of evidence stands.
    fn standing(model: model::Model, x: piece::Piece) -> Float64;
    // How much a piece of evidence counts.
    fn weight(model: model::Model, e: evidence::Evidence) -> Float64;
    // The state of every piece something is said of.
    fn spread(model: model::Model) -> List<(piece::Piece, State)>
        uses model::written;
    fn state(model: model::Model, x: piece::Piece) -> State
        uses spread;
    // The pieces a verdict is read from.
    fn statements(model: model::Model) -> List<piece::Piece>
        uses model::written, model::parts, evidence::reliable;
    // The verdict of the model.
    fn overall(model: model::Model) -> State
        uses spread, statements;
    // States, confidence and suspects.
    fn read(model: model::Model) -> Reading
        uses standing, model::written, model::parts, model::base;
    fn verdict_of(model: model::Model, x: piece::Piece) -> Verdict
        uses read;
    fn suspects(model: model::Model) -> List<List<piece::Piece>>
        uses read;
    // How sure a state is, as one number.
    fn sure(v: Verdict, w: Float64) -> Option<Float64>;
    // How sure a verdict that holds is: its least sure statement.
    fn least_sure(model: model::Model) -> Option<(piece::Piece, Float64)>
        uses overall, read, statements, sure;

    claim joined_keeps_what_agrees(x: State) {
        joined(x, x) == x && joined(x, Unknown) == x && joined(Unknown, x) == x
    }
    claim true_and_false_is_a_conflict() {
        joined(True, False) == Conflict && joined(False, True) == Conflict
    }
    claim a_conflict_stays(x: State) {
        joined(Conflict, x) == Conflict
    }
    claim nothing_said_is_unknown(m: model::Model) {
        m.evidence != [] || spread(m) == []
    }
    claim an_unknown_piece_has_no_confidence(m: model::Model, x: piece::Piece) {
        state(m, x) != Unknown || verdict_of(m, x).confidence == None
    }
    claim only_a_verdict_that_holds_is_sure(m: model::Model) {
        overall(m) == True || least_sure(m) == None
    }
    claim suspects_only_with_something_false(m: model::Model) {
        overall(m) == Conflict || overall(m) == False || suspects(m) == []
    }
}
