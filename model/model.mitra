// The side of trust. A place, a piece and the opinion of it; the three
// kinds of piece: statement, evidence, tie; and the model, which puts
// them together and says what is believed of each.
//
// Start here. Code: src/model.rs and src/model/, one file per subject.

import std::core::{Option};

// A location in the system.
subject place {
    ensure place_is_a_path = "A place is a location in the system, known by its path and by nothing else: it is not right or wrong, and nothing is believed of it.";
    ensure within_is_the_path = "A place is within another when its path goes on from the other's; every place is within itself.";

    // From the outside in: a file, then what is in it.
    record Place {
        path: List<String>,
    }

    fn within(a: Place, b: Place) -> Bool;

    // What always holds.
    claim within_itself(a: Place) { place::within(a, a) }
}

// Something said, and what is believed of it.
subject piece {
    ensure everything_is_a_piece = "Whatever can be right or wrong is a piece, known by its name, and has one opinion; there is no second way to be believed.";
    // After Jøsang, 2016, "Subjective Logic: A Formalism for Reasoning Under Uncertainty":
    // an opinion as Beta counts with a base rate and a prior weight W.
    // Departs: W is a setting given with the model, where the book fixes 2.
    ensure opinion_is_counts = "An opinion is a count of yes and a count of no, with a base rate: what to expect with no evidence. It reads as the share of yes, the base rate counted `w` times, so with no evidence it reads as its base rate. The weight `w` is one setting for the whole system, given with the model: nothing here holds a value for it.";
    // After Jøsang, 2016, "Subjective Logic: A Formalism for Reasoning Under Uncertainty":
    // belief, disbelief and uncertainty read from the counts. The
    // interval is the plain Beta one, and is not from the book.
    ensure opinion_is_shown = "An opinion shows as three shares of one: belief, disbelief, and uncertainty, which is what is not evidence. With them, the interval where the piece is right nine times out of ten: how often it is right is a Beta of its counts, the base rate counted with the weight.";
    ensure trusted_is_the_policy = "An opinion is trusted when the number it reads as reaches what the policy asks, and never with no yes at all.";

    // Known by its name only.
    record Piece {
        name: String,
    }

    // `r` counts of yes, `s` counts of no. `a` is the base rate.
    record Opinion {
        r: Float64,
        s: Float64,
        a: Float64,
    }

    fn piece_id(x: Piece) -> String;

    fn nothing(a: Float64) -> Opinion { Opinion(0.0, 0.0, a) }
    // One yes, one no.
    fn yes() -> Opinion { Opinion(1.0, 0.0, 1.0) }
    fn no() -> Opinion { Opinion(0.0, 1.0, 0.0) }

    // The number an opinion reads as. `w` is the weight of what is
    // expected before any evidence, in counts.
    fn projected(o: Opinion, w: Float64) -> Float64 { (o.r + o.a * w) / (o.r + o.s + w) }
    // The three shares of an opinion: for, against, and not evidence.
    fn belief(o: Opinion, w: Float64) -> Float64 { o.r / (o.r + o.s + w) }
    fn disbelief(o: Opinion, w: Float64) -> Float64 { o.s / (o.r + o.s + w) }
    fn uncertainty(o: Opinion, w: Float64) -> Float64 { w / (o.r + o.s + w) }
    // Where the piece is right nine times out of ten: from the 5th to
    // the 95th hundredth of the Beta of (r + a·w) yes and (s + (1 - a)·w) no.
    fn interval(o: Opinion, w: Float64) -> (Float64, Float64);

    fn reaches(o: Opinion, policy: Float64, w: Float64) -> Bool { o.r > 0.0 && projected(o, w) >= policy }
    // The evidence against is at least as strong as the evidence for.
    fn against(o: Opinion) -> Bool { o.s > 0.0 && o.s >= o.r }

    // What always holds.
    claim the_three_shares_make_one(o: Opinion) {
        o.r < 0.0 || o.s < 0.0 || piece::belief(o, 0.2) + piece::disbelief(o, 0.2) + piece::uncertainty(o, 0.2) > 0.9999
    }
}

// An interpretation of the system.
subject statement {
    require believed = piece::everything_is_a_piece;

    ensure statement_is_an_interpretation = "A statement is an interpretation of the system: a piece with a content, which is what it says the system is or does. The content is not read here, whatever it is.";
    record Statement<C> {
        piece: piece::Piece,
        content: C,
    }
}

// How an opinion moves.
subject evidence {
    require believed = piece::everything_is_a_piece;
    require said = statement::statement_is_an_interpretation;

    ensure evidence_is_a_piece = "A piece of evidence is a piece: it says an opinion about another piece, and is itself believed as any other piece.";
    ensure said_as_far_as_believed = "What a piece of evidence says counts as far as that evidence is itself believed: its counts are scaled by what the evidence reads as. Evidence believed at 0 moves nothing, and a yes never becomes a no.";
    ensure count_is_firmness = "The count a piece of evidence says is how firmly it says it. A test at one point says one yes or one no. A review may say many: that is how an author states what is known from experience, and what is so reviewed stands against a failure.";
    ensure reliability_is_implied = "Each voice implies one statement, its reliability: this voice can be relied on. It is a piece like any other, known by the voice's name, and it stands behind all the voice says.";
    // After Jøsang, 2016, "Subjective Logic: A Formalism for Reasoning Under Uncertainty":
    // trust discounting, the belief and the disbelief of a word times the
    // trust in its source. Departs: the result is kept as counts.
    ensure word_as_far_as_its_voice = "What a voice says counts whole if the voice is reliable and not at all if it is not: with a voice reliable at t, the belief and the disbelief of its word are t times what was said. A belief never exceeds the trust in who says it.";
    // After Jøsang, 2016, "Subjective Logic: A Formalism for Reasoning Under Uncertainty":
    // cumulative fusion, counts of independent sources add. Departs: one
    // voice counted once by its strongest word, and the measure of
    // independence between two voices, are ours.
    ensure same_voice_counts_once = "Pieces of evidence about one piece add their counts when their voices are independent; one voice counts once, by its strongest yes and its strongest no.";
    ensure disagreement_is_measured = "Two pieces of evidence that say opposite things about one piece are in conflict as far as each is believed; fused, neither is dropped.";

    // Who says it.
    record Voice {
        name: String,
    }

    // A piece that says `value` about `about`. `by` is its voice.
    record Evidence {
        piece: piece::Piece,
        about: piece::Piece,
        value: piece::Opinion,
        by: Voice,
    }

    // What the reliability of a voice says.
    record Reliable {
        voice: Voice,
    }
    // The reliability of a voice.
    fn reliable(by: Voice) -> statement::Statement<Reliable>;
    // What a word is worth when its voice is reliable with chance `t`.
    fn held(t: Float64, said: piece::Opinion, w: Float64) -> piece::Opinion {
        Opinion(
            w * (t * said.r / (said.r + said.s + w)) / (1.0 - t * (said.r + said.s) / (said.r + said.s + w)),
            w * (t * said.s / (said.r + said.s + w)) / (1.0 - t * (said.r + said.s) / (said.r + said.s + w)),
            said.a)
    }

    // How independent two voices are, from 0 (one voice) to 1 (two kinds).
    fn apart(a: Voice, b: Voice) -> Float64;

    // What evidence says, as far as it is believed: its counts, scaled.
    fn moved(believed: piece::Opinion, said: piece::Opinion, w: Float64) -> piece::Opinion {
        Opinion(piece::projected(believed, w) * said.r, piece::projected(believed, w) * said.s, said.a)
    }

    // Two opinions on one piece, at independence i. At 1 the counts add
    // up. At 0 it is one voice: its strongest yes and its strongest no.
    fn fuse(x: piece::Opinion, y: piece::Opinion, i: Float64) -> piece::Opinion {
        Opinion(
            if x.r >= y.r { x.r + i * y.r } else { y.r + i * x.r },
            if x.s >= y.s { x.s + i * y.s } else { y.s + i * x.s },
            x.a)
    }

    // How far two opinions on one piece contradict each other.
    fn conflict(x: piece::Opinion, y: piece::Opinion) -> Float64 { x.r * y.s + x.s * y.r }

    // Kept here: `evidence` is a word of the language, so another
    // subject cannot call `evidence::moved(..)`.
    // said_as_far_as_believed: a review "correct", believed at 0.5, is
    // half a yes on a test at bias 0.5: the test reads 0.86.
    claim review_lifts_a_test() {
        piece::projected(fuse(piece::nothing(0.5), moved(piece::nothing(0.5), piece::yes(), 0.2), 1.0), 0.2) > 0.85
    }
    claim believed_at_zero_moves_nothing() {
        moved(piece::nothing(0.0), piece::yes(), 0.2) == Opinion(0.0, 0.0, 1.0) && moved(piece::nothing(0.0), piece::no(), 0.2) == Opinion(0.0, 0.0, 0.0)
    }
    claim not_knowing_is_no_review() {
        piece::projected(fuse(piece::nothing(0.5), moved(piece::nothing(0.0), piece::yes(), 0.2), 1.0), 0.2) == 0.5
    }
    // One sure "wrong" is one no against the weight: under 0.1, not 0.
    claim wrong_is_disbelief() {
        piece::projected(fuse(piece::nothing(0.5), moved(piece::nothing(1.0), piece::no(), 0.2), 1.0), 0.2) < 0.1
    }
    claim one_failing_test_is_against() {
        piece::against(moved(piece::nothing(0.5), piece::no(), 0.2)) && !piece::against(moved(piece::nothing(0.0), piece::no(), 0.2))
    }

    // count_is_firmness: ten yes believed at one half are five.
    claim a_count_is_scaled_whole() {
        moved(piece::nothing(0.5), Opinion(10.0, 0.0, 0.5), 0.2).r == 5.0
    }

    // reliability_is_implied
    claim reliability_names_its_voice(by: Voice) { reliable(by).content.voice == by }

    // word_as_far_as_its_voice: a hundred yes from a voice at 0.3 read
    // under 0.66 on a piece at one half; scaled counts would read 0.99.
    claim a_word_never_exceeds_the_trust_in_its_voice() {
        piece::projected(held(0.3, Opinion(100.0, 0.0, 0.5), 0.2), 0.2) < 0.66
    }
    claim an_unreliable_voice_says_nothing() {
        held(0.0, Opinion(100.0, 0.0, 0.5), 0.2) == Opinion(0.0, 0.0, 0.5)
    }

    // same_voice_counts_once
    claim one_voice_twice_is_once() {
        fuse(Opinion(0.5, 0.0, 0.0), Opinion(0.5, 0.0, 0.0), 0.0) == Opinion(0.5, 0.0, 0.0)
    }
    claim two_voices_add_up() {
        fuse(Opinion(0.5, 0.0, 0.0), Opinion(0.5, 0.0, 0.0), 1.0).r == 1.0
    }

    // disagreement_is_measured
    claim two_sure_reviews_that_disagree() {
        fuse(Opinion(1.0, 0.0, 0.5), Opinion(0.0, 1.0, 0.5), 1.0) == Opinion(1.0, 1.0, 0.5)
            && conflict(Opinion(1.0, 0.0, 0.5), Opinion(0.0, 1.0, 0.5)) == 1.0
    }
}

// A believed link between an interpretation and a named part of the system.
subject tie {
    require interpreted = statement::statement_is_an_interpretation;
    require located = place::within_is_the_path;

    ensure tie_is_a_believed_link = "A tie is a believed link between a named part of the system and what the model says of it: a piece that says one or several statements are about a place, and that can be wrong like any other piece.";
    ensure a_tie_has_a_whole = "Each tie implies its whole: the tie, its statements and its completeness, all together. It is what an observation at the place is about. Nobody writes it.";
    ensure completeness_is_implied = "Each tie implies one more statement, its completeness: the statements tied there are all that matters there. It is a piece like any other, known by the tie's name, written by nobody.";
    ensure found_through_ties = "Where a statement is found, and which statements a place concerns, is read from the ties and from nothing else: a statement with no tie is nowhere, and a place concerns what is tied at it or within it.";

    // `statements` are the pieces of the statements it ties. A statement
    // shared by several places is listed by the tie of each.
    record Tie {
        piece: piece::Piece,
        statements: List<piece::Piece>,
        place: place::Place,
    }
    // What an observation at the place is about.
    fn whole(t: Tie) -> piece::Piece;

    // What the completeness of a tie says: nothing is missing at `tie`.
    record Complete {
        tie: piece::Piece,
    }
    // The completeness of a tie.
    fn complete(t: Tie) -> statement::Statement<Complete>;

    // The places a statement is tied to.
    fn places(ties: List<Tie>, statement: piece::Piece) -> List<place::Place>;
    // The statements tied at a place or within it.
    fn concerned(ties: List<Tie>, place: place::Place) -> List<piece::Piece>
        uses place::within;

    // What always holds.
    claim completeness_names_its_tie(t: Tie) { tie::complete(t).content.tie == t.piece }
    claim two_ties_two_completenesses(a: piece::Piece, b: piece::Piece, x: piece::Piece) {
        a == b || tie::complete(Tie(a, [x], Place(["ball"]))).piece != tie::complete(Tie(b, [x], Place(["ball"]))).piece
    }
    claim no_tie_is_nowhere(x: piece::Piece, place: place::Place) {
        tie::places([], x) == [] && tie::concerned([], place) == []
    }
    claim tied_is_found(t: piece::Piece, x: piece::Piece) {
        tie::places([Tie(t, [x], Place(["src/lib.rs", "next"]))], x) == [Place(["src/lib.rs", "next"])]
    }
    claim a_file_concerns_what_is_in_it(t: piece::Piece, x: piece::Piece) {
        tie::concerned([Tie(t, [x], Place(["src/lib.rs", "next"]))], Place(["src/lib.rs"])) == [x]
            && tie::concerned([Tie(t, [x], Place(["src/lib.rs", "next"]))], Place(["src/main.rs"])) == []
    }
}

// All the pieces, put together.
subject model {
    require policy = piece::trusted_is_the_policy;
    require said = statement::statement_is_an_interpretation;
    require moved = evidence::said_as_far_as_believed;
    require voices = evidence::same_voice_counts_once;
    require clash = evidence::disagreement_is_measured;
    require firm = evidence::count_is_firmness;
    require complete = tie::completeness_is_implied;
    require whole = tie::a_tie_has_a_whole;
    require reliable = evidence::reliability_is_implied;
    require word = evidence::word_as_far_as_its_voice;

    ensure only_from_the_model = "The opinion of a piece comes from the evidence about it and from the pieces it is related to, and from nothing else: with neither it is its base rate. The base rate of a piece that is not a whole is never moved; a whole has the base rate of its parts together.";
    ensure relation_is_said = "A relation between pieces is itself said: a statement whose content is the relation. What is computed on a relation counts as far as that statement is believed; a relation believed at 1 is plain structure, and one believed at 0 relates nothing.";
    // After Jøsang and McAnally, 2004, "Multiplication and Comultiplication
    // of Beliefs": the product of two independent opinions as one opinion.
    // Departs: the Beta is fitted to the mean and the variance of the
    // product, where the paper fits the mean; several parts are taken
    // two at a time.
    ensure whole_is_all_its_parts = "A piece that is all of others together reads as all of them, each counted once however many paths lead to it: how often each part is right is taken as independent of the others, and the whole reads as the product. It reads on what is said of it directly only when that leaves less uncertain.";
    ensure yes_flows_down = "What says yes about a whole says yes about each of its parts as much: evidence about a pair is evidence about both.";
    // After Pearl, 1988, "Probabilistic Reasoning in Intelligent Systems:
    // Networks of Plausible Inference": Bayes' rule on a conjunction seen
    // false, each cause blamed by what was expected of it. Departs: only
    // the mean of each suspect is kept, as a count of no added to it; how
    // the suspects depend on each other after the failure is dropped.
    ensure no_is_shared = "What says no about a whole says no about no part alone. The parts, and the parts of each part that is itself a whole, down to what stands on nothing, each once however many paths lead to it; the evidence that says no; and each doubted relation on the way: these are the suspects: a failure is seeing that they are not all right. Each suspect gets the count of no that brings it to what Bayes gives for it, from what each was expected to be before; its count of yes is not touched. An equal start gives equal shares; what was expected less takes more.";
    ensure completeness_is_a_part = "The completeness of a tie is a part of every whole the tie is a part of, though no relation names it: a yes about the whole flows down to it, and it is a suspect of every failure of the whole. A failure where the statement and the tie are otherwise believed says that something is missing there.";
    ensure settings_are_apart = "What a model is read under is apart from what it says: the weight of a base rate, and the base rate of a piece nobody gave one, for the completeness of a tie, for a tie and for the reliability of a voice. They are given with the model, one value each for the whole system; a base rate that is written wins. Nothing here holds a value for any of them.";
    ensure completeness_has_a_default = "The completeness of a tie with no base rate written has the one the model gives for all: whoever models tries for a good model and takes shortcuts, so it is better than a guess and not strong. It is a setting, given with the model.";
    // After Dawid and Skene, 1979, "Maximum Likelihood Estimation of
    // Observer Error-Rates Using the EM Algorithm": observers judged by
    // how they agree with what the others make likely, estimated in
    // rounds. Departs: one number per voice (reliable or not) where they
    // estimate an error rate per answer; what is true is read from the
    // parts of each whole, not estimated as a class; the rounds repeat a
    // reading until nothing moves, and are not their EM.
    ensure voices_are_judged = "A voice whose reliability has a base rate can be doubted. It is reliable or not, and if not its word is nothing. It is judged by every whole it spoke for, passes and failures together: with p the chance that the parts of a whole are all right before anything is seen of it, the observations are as likely as p times (every failing one is wrong) plus (1 - p) times (every passing one is wrong), read with the word of the voice taken whole and without it. Repeated failures of one whole are one fact. The parts are read again with the voices as judged, and so on until nothing moves.";
    // After Ivanovska, Jøsang, Kaplan and Sambo, 2015, "Subjective
    // Networks: Perspectives and Challenges": opinions on the nodes of a
    // Bayesian network, a common parent making its children dependent.
    // Departs: no inference of theirs is used; voices on one source are
    // weighed by a closed form of ours.
    ensure sources_are_shared = "Voices are independent unless a relation says the reliability of each is all of a common source. Voices on one source are weighed together: what contradicts one of them makes the source less believed, and so the word of the others.";
    ensure unjudged_is_not_doubted = "A voice whose reliability has no base rate is not judged: its word counts whole. That is an assumption of the model, to be shown with it.";
    ensure conflict_is_said = "Pieces that cannot all be right are reported, the least believed first, and none of them is chosen silently: the parts of a whole with the evidence that says no about it, and the evidence for and against one piece.";

    // How pieces stand to each other, named after what is computed.
    // One relation can hold many pieces. The other relation of the core
    // is `about`, from a piece of evidence to the piece it speaks of:
    // it is the field of `Evidence`, and its computation is to discount
    // and to fuse.
    enum Relation {
        // The first is all of the others together. Named after what is
        // computed on it: belief goes up as a product, a yes about the
        // whole flows down to each part, a no is shared between them.
        All,
        // They cannot all be right.
        Exclude
    }
    record Related {
        how: Relation,
        pieces: List<piece::Piece>,
    }

    // What a model is read under, apart from what it says. `weight` is
    // the weight of a base rate, in counts. The others are the base
    // rate of a piece nobody gave one: the completeness of a tie, a
    // tie, and the reliability of a voice. With no setting for
    // reliability, a voice nobody gave a base rate is not judged.
    record Settings {
        weight: Float64,
        completeness: Float64,
        tie: Float64,
        reliability: Option<Float64>,
    }

    // All that is said of a system: the evidence, the relations between
    // pieces, each said by a statement, the base rate of each piece
    // that has one, and the ties, each implying its completeness. Then
    // the settings it is read under. A piece with no base rate, written
    // or set, has 0: it is expected wrong, with the weight. "Nothing
    // assumed" is one half.
    record Model {
        evidence: List<evidence::Evidence>,
        related: List<statement::Statement<Related>>,
        base: List<(piece::Piece, Float64)>,
        ties: List<tie::Tie>,
        settings: Settings,
    }

    // The model with the relation of each tie written out: its whole is
    // all of the tie and its statements. That relation is structure.
    fn written(model: Model) -> Model;
    // The parts of a whole: the pieces its relation names after the
    // first, and the completeness of each tie among them.
    fn parts(model: Model, r: Related) -> List<piece::Piece>
        uses tie::complete;

    // What to expect of a piece with no evidence.
    fn base(model: Model, x: piece::Piece) -> Float64
        uses tie::complete, evidence::reliable;
    // How far the word of each doubted voice holds, and how far each
    // source is believed, with the piece of each.
    fn judged(model: Model) -> List<(piece::Piece, Float64)>
        uses written, parts, piece::projected;
    // The model once its voices are judged: their word counted as far as
    // it holds, and no voice left to doubt.
    fn settled(model: Model, judged: List<(piece::Piece, Float64)>) -> Model
        uses written;
    // What is believed of a piece, from the whole model: the voices are
    // judged first.
    fn opinion(model: Model, x: piece::Piece) -> piece::Opinion
        uses written, judged, settled, piece::projected;
    fn trusted(model: Model, x: piece::Piece, policy: Float64) -> Bool
        uses opinion, piece::reaches;
    // The pieces that cannot all be right and are each believed, the
    // least believed first.
    fn conflicts(model: Model) -> List<List<piece::Piece>>
        uses judged, settled, evidence::moved, evidence::conflict, piece::projected;

    // Both of two pieces. How often each is right is a Beta; the two
    // taken as independent, the answer is the Beta with the mean and the
    // variance of their product. Its base rate is the product of the two.
    fn all(x: piece::Opinion, y: piece::Opinion, w: Float64) -> piece::Opinion;

    // What always holds.
    claim an_empty_model_believes_nothing(x: piece::Piece) {
        model::opinion(Model([], [], [], [], Settings(0.2, 0.6, 0.0, None)), x) == piece::nothing(0.0)
    }
    claim evidence_moves_its_piece(c: piece::Piece, t: piece::Piece, by: evidence::Voice) {
        c == t || model::opinion(Model([Evidence(t, c, piece::yes(), by)], [], [(t, 0.5)], [], Settings(0.2, 0.6, 0.0, None)), c) == Opinion(0.5, 0.0, 0.0)
    }
    claim a_review_reaches_the_claim(c: piece::Piece, t: piece::Piece, r: piece::Piece, a: evidence::Voice, b: evidence::Voice) {
        c == t || c == r || t == r
            || model::opinion(Model([Evidence(t, c, piece::yes(), a), Evidence(r, t, piece::yes(), b)], [], [(t, 0.5), (r, 0.5)], [], Settings(0.2, 0.6, 0.0, None)), c).r > 0.85
    }
    claim a_test_judged_wrong_says_less(c: piece::Piece, t: piece::Piece, r: piece::Piece, a: evidence::Voice, b: evidence::Voice) {
        c == t || c == r || t == r
            || model::opinion(Model([Evidence(t, c, piece::yes(), a), Evidence(r, t, piece::no(), b)], [], [(t, 0.5), (r, 1.0)], [], Settings(0.2, 0.6, 0.0, None)), c).r < 0.1
    }
    claim nothing_said_is_no_conflict() {
        model::conflicts(Model([], [], [], [], Settings(0.2, 0.6, 0.0, None))) == []
    }
}

// What the promises above say, on small cases.
subject tests {
    // place

    // within_is_the_path
    claim inside_is_within() {
        place::within(Place(["src/lib.rs", "next"]), Place(["src/lib.rs"])) && !place::within(Place(["src/lib.rs"]), Place(["src/lib.rs", "next"]))
    }
    claim beside_is_not_within() {
        !place::within(Place(["src/lib.rs", "next"]), Place(["src/lib.rs", "back"]))
    }

    // piece

    // opinion_is_counts
    claim no_evidence_is_the_base_rate() { piece::projected(piece::nothing(0.5), 0.2) == 0.5 && piece::uncertainty(piece::nothing(0.5), 0.2) == 1.0 }
    claim one_yes_on_one_half_nearly_settles_it() { piece::projected(Opinion(1.0, 0.0, 0.5), 0.2) > 0.9 && piece::projected(Opinion(0.0, 1.0, 0.5), 0.2) < 0.1 }

    // A small weight lets the first observation nearly settle a piece;
    // a large one asks for more.
    claim the_weight_is_how_fast_it_settles() {
        piece::projected(Opinion(1.0, 0.0, 0.5), 0.2) > piece::projected(Opinion(1.0, 0.0, 0.5), 2.0)
    }

    // opinion_is_shown
    claim no_evidence_is_all_uncertain() { piece::belief(piece::nothing(0.5), 0.2) == 0.0 && piece::disbelief(piece::nothing(0.5), 0.2) == 0.0 }
    claim sure_is_nowhere_else() { piece::interval(piece::nothing(1.0), 0.2) == (1.0, 1.0) && piece::interval(piece::nothing(0.0), 0.2) == (0.0, 0.0) }

    // trusted_is_the_policy
    claim policy_zero_still_needs_belief() {
        !piece::reaches(piece::nothing(0.0), 0.0, 0.2) && piece::reaches(Opinion(0.5, 0.0, 0.0), 0.0, 0.2)
    }
    claim as_much_against_as_for_is_against() {
        piece::against(Opinion(1.0, 1.0, 0.0)) && !piece::against(Opinion(2.0, 1.0, 0.0)) && !piece::against(piece::nothing(0.0))
    }

    // tie

    // completeness_is_implied

    // found_through_ties

    // model

    // only_from_the_model
    claim base_rate_survives() {
        model::opinion(Model([Evidence(Piece("t"), Piece("y"), piece::yes(), Voice("a")), Evidence(Piece("r"), Piece("t"), piece::no(), Voice("b"))], [], [(Piece("t"), 0.5), (Piece("r"), 0.25), (Piece("y"), 0.75)], [], Settings(0.2, 0.6, 0.0, None)), Piece("y")).a == 0.75
    }

    // The calculus, on small models. `t` is a test of `c`, `r` a review
    // of `t`, and each piece is another.
    // One sure "wrong" on the test: it reads under 0.1, and says that much.

    // whole_is_all_its_parts
    claim two_halves_are_a_quarter() {
        piece::projected(model::all(piece::nothing(0.5), piece::nothing(0.5), 0.2), 0.2) > 0.2499 && piece::projected(model::all(piece::nothing(0.5), piece::nothing(0.5), 0.2), 0.2) < 0.2501
    }
    claim one_sure_part_changes_nothing() {
        model::all(piece::nothing(1.0), Opinion(0.5, 0.0, 0.5), 0.2) == Opinion(0.5, 0.0, 0.5)
    }

    // On a small model: `x` is all of `y` alone, tested by `t`.
    claim a_whole_of_one_part_is_that_part() {
        model::opinion(Model([Evidence(Piece("t"), Piece("y"), piece::yes(), Voice("me"))], [Statement(Piece("all: x"), Related(All, [Piece("x"), Piece("y")]))], [(Piece("t"), 0.5), (Piece("all: x"), 1.0)], [], Settings(0.2, 0.6, 0.0, None)), Piece("x")).r == 0.5
    }

    // The throwing toy. One object, the ball; the statement `falls`
    // ("thrown up, it goes up then falls down"); the tie `applies` links
    // the ball to `falls` (this model is a good model of this object).
    // The tie implies its whole and its completeness. A throw is
    // evidence about the whole, believed as far as I trust my senses.
    // Everything written starts at one half, senses too.

    // yes_flows_down
    claim a_throw_that_falls_believes_both() {
        model::opinion(Model([Evidence(Piece("throw"), Piece("whole: applies"), piece::yes(), Voice("me"))], [], [(Piece("applies"), 0.5), (Piece("falls"), 0.5), (Piece("throw"), 0.5)], [Tie(Piece("applies"), [Piece("falls")], Place(["ball"]))], Settings(0.2, 0.6, 0.0, None)), Piece("falls")) == Opinion(0.5, 0.0, 0.5)
            && model::opinion(Model([Evidence(Piece("throw"), Piece("whole: applies"), piece::yes(), Voice("me"))], [], [(Piece("applies"), 0.5), (Piece("falls"), 0.5), (Piece("throw"), 0.5)], [Tie(Piece("applies"), [Piece("falls")], Place(["ball"]))], Settings(0.2, 0.6, 0.0, None)), Piece("applies")) == Opinion(0.5, 0.0, 0.5)
    }

    // no_is_shared. The base rates are the only place to say "I trust my
    // senses more than my model or my tie".
    claim an_equal_start_gives_equal_shares() {
        model::opinion(Model([Evidence(Piece("throw"), Piece("whole: applies"), piece::no(), Voice("me"))], [], [(Piece("applies"), 0.5), (Piece("falls"), 0.5), (Piece("throw"), 0.5)], [Tie(Piece("applies"), [Piece("falls")], Place(["ball"]))], Settings(0.2, 0.6, 0.0, None)), Piece("applies")).s == model::opinion(Model([Evidence(Piece("throw"), Piece("whole: applies"), piece::no(), Voice("me"))], [], [(Piece("applies"), 0.5), (Piece("falls"), 0.5), (Piece("throw"), 0.5)], [Tie(Piece("applies"), [Piece("falls")], Place(["ball"]))], Settings(0.2, 0.6, 0.0, None)), Piece("throw")).s
            && model::opinion(Model([Evidence(Piece("throw"), Piece("whole: applies"), piece::no(), Voice("me"))], [], [(Piece("applies"), 0.5), (Piece("falls"), 0.5), (Piece("throw"), 0.5)], [Tie(Piece("applies"), [Piece("falls")], Place(["ball"]))], Settings(0.2, 0.6, 0.0, None)), Piece("applies")).r == 0.0
    }
    claim trusted_senses_blame_the_tie_and_the_statement_more() {
        model::opinion(Model([Evidence(Piece("throw"), Piece("whole: applies"), piece::no(), Voice("me"))], [], [(Piece("applies"), 0.5), (Piece("falls"), 0.5), (Piece("throw"), 0.9)], [Tie(Piece("applies"), [Piece("falls")], Place(["ball"]))], Settings(0.2, 0.6, 0.0, None)), Piece("applies")).s > model::opinion(Model([Evidence(Piece("throw"), Piece("whole: applies"), piece::no(), Voice("me"))], [], [(Piece("applies"), 0.5), (Piece("falls"), 0.5), (Piece("throw"), 0.9)], [Tie(Piece("applies"), [Piece("falls")], Place(["ball"]))], Settings(0.2, 0.6, 0.0, None)), Piece("throw")).s
    }
    // A ball and a balloon under one statement: the ball falls, the
    // balloon does not. `falls` is believed through the ball, so the
    // balloon's tie takes more of the no.
    claim the_balloon_blames_its_tie() {
        model::opinion(Model([Evidence(Piece("throw ball"), Piece("whole: ball applies"), piece::yes(), Voice("me")), Evidence(Piece("throw balloon"), Piece("whole: balloon applies"), piece::no(), Voice("me"))], [], [(Piece("ball applies"), 0.5), (Piece("balloon applies"), 0.5), (Piece("falls"), 0.5), (Piece("throw ball"), 0.5), (Piece("throw balloon"), 0.5)], [Tie(Piece("ball applies"), [Piece("falls")], Place(["ball"])), Tie(Piece("balloon applies"), [Piece("falls")], Place(["balloon"]))], Settings(0.2, 0.6, 0.0, None)), Piece("balloon applies")).s > model::opinion(Model([Evidence(Piece("throw ball"), Piece("whole: ball applies"), piece::yes(), Voice("me")), Evidence(Piece("throw balloon"), Piece("whole: balloon applies"), piece::no(), Voice("me"))], [], [(Piece("ball applies"), 0.5), (Piece("balloon applies"), 0.5), (Piece("falls"), 0.5), (Piece("throw ball"), 0.5), (Piece("throw balloon"), 0.5)], [Tie(Piece("ball applies"), [Piece("falls")], Place(["ball"])), Tie(Piece("balloon applies"), [Piece("falls")], Place(["balloon"]))], Settings(0.2, 0.6, 0.0, None)), Piece("falls")).s
    }
    // One object, two statements: it falls and makes no noise. The tie is
    // believed through the fall, so `noise` takes more of the no.
    claim silence_blames_the_noise() {
        model::opinion(Model([Evidence(Piece("throw"), Piece("lands"), piece::yes(), Voice("me")), Evidence(Piece("listen"), Piece("bangs"), piece::no(), Voice("me"))], [Statement(Piece("all: lands"), Related(All, [Piece("lands"), Piece("applies"), Piece("falls")])), Statement(Piece("all: bangs"), Related(All, [Piece("bangs"), Piece("applies"), Piece("noise")]))], [(Piece("applies"), 0.5), (Piece("falls"), 0.5), (Piece("noise"), 0.5), (Piece("throw"), 0.5), (Piece("listen"), 0.5), (Piece("all: lands"), 1.0), (Piece("all: bangs"), 1.0)], [], Settings(0.2, 0.6, 0.0, None)), Piece("noise")).s > model::opinion(Model([Evidence(Piece("throw"), Piece("lands"), piece::yes(), Voice("me")), Evidence(Piece("listen"), Piece("bangs"), piece::no(), Voice("me"))], [Statement(Piece("all: lands"), Related(All, [Piece("lands"), Piece("applies"), Piece("falls")])), Statement(Piece("all: bangs"), Related(All, [Piece("bangs"), Piece("applies"), Piece("noise")]))], [(Piece("applies"), 0.5), (Piece("falls"), 0.5), (Piece("noise"), 0.5), (Piece("throw"), 0.5), (Piece("listen"), 0.5), (Piece("all: lands"), 1.0), (Piece("all: bangs"), 1.0)], [], Settings(0.2, 0.6, 0.0, None)), Piece("applies")).s
    }

    // relation_is_said. A latent statement, `gravity`: no tie, nothing to
    // throw at. `mass` is the statement tied to the object, and "it
    // falls" is all of [gravity, mass]. The relation is itself said: one
    // believed at 1 is structure, and one nobody believes relates nothing.
    claim a_latent_statement_is_believed_as_far_as_its_relation() {
        model::opinion(Model([Evidence(Piece("throw"), Piece("it falls"), piece::yes(), Voice("me"))], [Statement(Piece("because"), Related(All, [Piece("it falls"), Piece("gravity"), Piece("mass")]))], [(Piece("gravity"), 0.5), (Piece("mass"), 0.5), (Piece("throw"), 1.0), (Piece("because"), 1.0)], [], Settings(0.2, 0.6, 0.0, None)), Piece("gravity")) == Opinion(1.0, 0.0, 0.5)
            && model::opinion(Model([Evidence(Piece("throw"), Piece("it falls"), piece::yes(), Voice("me"))], [Statement(Piece("because"), Related(All, [Piece("it falls"), Piece("gravity"), Piece("mass")]))], [(Piece("gravity"), 0.5), (Piece("mass"), 0.5), (Piece("throw"), 1.0), (Piece("because"), 0.5)], [], Settings(0.2, 0.6, 0.0, None)), Piece("gravity")) == Opinion(0.5, 0.0, 0.5)
    }
    claim a_relation_nobody_believes_relates_nothing() {
        model::opinion(Model([Evidence(Piece("throw"), Piece("it falls"), piece::yes(), Voice("me"))], [Statement(Piece("because"), Related(All, [Piece("it falls"), Piece("gravity"), Piece("mass")]))], [(Piece("gravity"), 0.5), (Piece("mass"), 0.5), (Piece("throw"), 1.0)], [], Settings(0.2, 0.6, 0.0, None)), Piece("gravity")) == piece::nothing(0.5)
    }

    // completeness_is_a_part
    claim a_tie_adds_its_completeness_to_the_whole() {
        model::parts(Model([Evidence(Piece("throw"), Piece("whole: applies"), piece::no(), Voice("me"))], [], [(Piece("applies"), 0.5), (Piece("falls"), 0.5), (Piece("throw"), 0.5)], [Tie(Piece("applies"), [Piece("falls")], Place(["ball"]))], Settings(0.2, 0.6, 0.0, None)), Related(All, [Piece("lands"), Piece("applies"), Piece("falls")])) == [Piece("applies"), Piece("falls"), Piece("complete: applies")]
    }
    claim completeness_takes_its_share_of_a_no() {
        model::opinion(Model([Evidence(Piece("throw"), Piece("whole: applies"), piece::no(), Voice("me"))], [], [(Piece("applies"), 0.5), (Piece("falls"), 0.5), (Piece("throw"), 0.5)], [Tie(Piece("applies"), [Piece("falls")], Place(["ball"]))], Settings(0.2, 0.6, 0.0, None)), Piece("complete: applies")).s > 0.0
            && model::opinion(Model([Evidence(Piece("throw"), Piece("whole: applies"), piece::no(), Voice("me"))], [], [(Piece("applies"), 0.5), (Piece("falls"), 0.5), (Piece("throw"), 0.5)], [Tie(Piece("applies"), [Piece("falls")], Place(["ball"]))], Settings(0.2, 0.6, 0.0, None)), Piece("complete: applies")).s < model::opinion(Model([Evidence(Piece("throw"), Piece("whole: applies"), piece::no(), Voice("me"))], [], [(Piece("applies"), 0.5), (Piece("falls"), 0.5), (Piece("throw"), 0.5)], [Tie(Piece("applies"), [Piece("falls")], Place(["ball"]))], Settings(0.2, 0.6, 0.0, None)), Piece("applies")).s
    }
    claim completeness_is_believed_by_a_yes() {
        model::opinion(Model([Evidence(Piece("throw"), Piece("whole: applies"), piece::yes(), Voice("me"))], [], [(Piece("applies"), 0.5), (Piece("falls"), 0.5), (Piece("throw"), 0.5)], [Tie(Piece("applies"), [Piece("falls")], Place(["ball"]))], Settings(0.2, 0.6, 0.0, None)), Piece("complete: applies")) == Opinion(0.5, 0.0, 0.6)
    }

    // completeness_has_a_default
    claim an_unwritten_completeness_has_the_setting() {
        model::base(Model([Evidence(Piece("throw"), Piece("whole: applies"), piece::no(), Voice("me"))], [], [(Piece("applies"), 0.5), (Piece("falls"), 0.5), (Piece("throw"), 0.9)], [Tie(Piece("applies"), [Piece("falls")], Place(["ball"]))], Settings(0.2, 0.6, 0.0, None)), Piece("complete: applies")) == 0.6
            && model::base(Model([Evidence(Piece("throw"), Piece("whole: applies"), piece::no(), Voice("me"))], [], [(Piece("applies"), 0.5), (Piece("falls"), 0.5), (Piece("throw"), 0.9)], [Tie(Piece("applies"), [Piece("falls")], Place(["ball"]))], Settings(0.2, 0.6, 0.0, None)), Piece("applies")) == 0.5
            && model::base(Model([Evidence(Piece("throw"), Piece("whole: applies"), piece::no(), Voice("me"))], [], [(Piece("applies"), 0.5), (Piece("falls"), 0.5), (Piece("throw"), 0.9)], [Tie(Piece("applies"), [Piece("falls")], Place(["ball"]))], Settings(0.2, 0.6, 0.0, None)), Piece("unknown")) == 0.0
    }

    // count_is_firmness: a review of a hundred yes on `falls`. The throw
    // fails, and what is reviewed stands better than the tie.
    claim what_is_reviewed_stands() {
        model::opinion(Model([Evidence(Piece("throw"), Piece("whole: applies"), piece::no(), Voice("me")), Evidence(Piece("review"), Piece("falls"), Opinion(100.0, 0.0, 0.5), Voice("author"))], [], [(Piece("applies"), 0.5), (Piece("falls"), 0.5), (Piece("throw"), 0.9), (Piece("review"), 1.0)], [Tie(Piece("applies"), [Piece("falls")], Place(["ball"]))], Settings(0.2, 0.6, 0.0, None)), Piece("falls")).s < model::opinion(Model([Evidence(Piece("throw"), Piece("whole: applies"), piece::no(), Voice("me")), Evidence(Piece("review"), Piece("falls"), Opinion(100.0, 0.0, 0.5), Voice("author"))], [], [(Piece("applies"), 0.5), (Piece("falls"), 0.5), (Piece("throw"), 0.9), (Piece("review"), 1.0)], [Tie(Piece("applies"), [Piece("falls")], Place(["ball"]))], Settings(0.2, 0.6, 0.0, None)), Piece("applies")).s
    }

    // unjudged_is_not_doubted
    claim a_voice_with_no_base_rate_is_not_judged() {
        model::judged(Model([Evidence(Piece("throw"), Piece("whole: applies"), piece::no(), Voice("me")), Evidence(Piece("review"), Piece("falls"), Opinion(100.0, 0.0, 0.5), Voice("author"))], [], [(Piece("applies"), 0.5), (Piece("falls"), 0.5), (Piece("throw"), 0.9), (Piece("review"), 1.0)], [Tie(Piece("applies"), [Piece("falls")], Place(["ball"]))], Settings(0.2, 0.6, 0.0, None))) == []
    }

    // voices_are_judged: the same review, by a voice that can be
    // doubted. The throw fails: the voice is believed less than before,
    // and `falls` less than when the voice was not doubted.
    claim a_failure_doubts_the_voice_that_vouched() {
        piece::projected(model::opinion(Model([Evidence(Piece("throw"), Piece("whole: applies"), piece::no(), Voice("me")), Evidence(Piece("review"), Piece("falls"), Opinion(100.0, 0.0, 0.5), Voice("author"))], [], [(Piece("applies"), 0.5), (Piece("falls"), 0.5), (Piece("throw"), 0.9), (Piece("review"), 1.0), (Piece("reliable: author"), 0.9)], [Tie(Piece("applies"), [Piece("falls")], Place(["ball"]))], Settings(0.2, 0.6, 0.0, None)), Piece("reliable: author")), 0.2) < 0.9
    }
    claim a_doubted_voice_holds_its_word_up_less() {
        piece::projected(model::opinion(Model([Evidence(Piece("throw"), Piece("whole: applies"), piece::no(), Voice("me")), Evidence(Piece("review"), Piece("falls"), Opinion(100.0, 0.0, 0.5), Voice("author"))], [], [(Piece("applies"), 0.5), (Piece("falls"), 0.5), (Piece("throw"), 0.9), (Piece("review"), 1.0), (Piece("reliable: author"), 0.9)], [Tie(Piece("applies"), [Piece("falls")], Place(["ball"]))], Settings(0.2, 0.6, 0.0, None)), Piece("falls")), 0.2) < piece::projected(model::opinion(Model([Evidence(Piece("throw"), Piece("whole: applies"), piece::no(), Voice("me")), Evidence(Piece("review"), Piece("falls"), Opinion(100.0, 0.0, 0.5), Voice("author"))], [], [(Piece("applies"), 0.5), (Piece("falls"), 0.5), (Piece("throw"), 0.9), (Piece("review"), 1.0)], [Tie(Piece("applies"), [Piece("falls")], Place(["ball"]))], Settings(0.2, 0.6, 0.0, None)), Piece("falls")), 0.2)
    }

    // conflict_is_said
    claim a_throw_that_does_not_fall_names_its_suspects() {
        model::conflicts(Model([Evidence(Piece("throw"), Piece("whole: applies"), piece::no(), Voice("me"))], [], [(Piece("applies"), 0.5), (Piece("falls"), 0.5), (Piece("throw"), 0.5)], [Tie(Piece("applies"), [Piece("falls")], Place(["ball"]))], Settings(0.2, 0.6, 0.0, None))) == [[Piece("applies"), Piece("falls"), Piece("throw"), Piece("complete: applies")]]
    }

    // settings_are_apart: a tie nobody gave a base rate has the
    // setting, and a setting for reliability has every voice judged.
    claim an_unwritten_tie_has_the_setting() {
        model::base(Model([Evidence(Piece("throw"), Piece("whole: applies"), piece::no(), Voice("me"))], [], [(Piece("falls"), 0.5), (Piece("throw"), 0.9)], [Tie(Piece("applies"), [Piece("falls")], Place(["ball"]))], Settings(0.2, 0.6, 0.5, None)), Piece("applies")) == 0.5 && model::base(Model([Evidence(Piece("throw"), Piece("whole: applies"), piece::no(), Voice("me"))], [], [(Piece("falls"), 0.5), (Piece("throw"), 0.9)], [Tie(Piece("applies"), [Piece("falls")], Place(["ball"]))], Settings(0.2, 0.6, 0.5, None)), Piece("falls")) == 0.5
    }
    claim a_default_reliability_judges_every_voice() {
        model::judged(Model([Evidence(Piece("throw"), Piece("whole: applies"), piece::no(), Voice("me"))], [], [(Piece("falls"), 0.5), (Piece("throw"), 0.9)], [Tie(Piece("applies"), [Piece("falls")], Place(["ball"]))], Settings(0.2, 0.6, 0.5, None))) == [] && model::base(Model([Evidence(Piece("throw"), Piece("whole: applies"), piece::no(), Voice("me"))], [], [(Piece("falls"), 0.5), (Piece("throw"), 0.9)], [Tie(Piece("applies"), [Piece("falls")], Place(["ball"]))], Settings(0.2, 0.6, 0.5, Some(0.9))), Piece("reliable: me")) == 0.9
    }
}
