// The side of computing. A value is a quantity with a type; operations
// are declared on types; an expression is nested operations that can
// be evaluated. This file declares no type, no operation and no kind
// of quantity of its own.
//
// Code: src/value.rs.

import std::core::{Option};

// What a value can be. Known by its name only.
record Type {
    name: String,
}

// A quantity `Q` with a type. What a quantity is, is not said here:
// one exact amount, the bounds it lies in, or another.
record Value<Q> {
    quantity: Q,
    of: Type,
}

// What applies operations on one kind of quantity: the standard
// table, the one that reads bounds, or a model's own. It is declared
// before the types it speaks of, so they are named here: an operation
// `O` on values `V` gives a quantity `Q`.
contract Applies<O, V, Q> {
    fn apply(&self, op: O, args: List<Option<V>>) -> Option<Q>;
    ensure applied_alone = "Applying an operation is deterministic: what it gives comes from the operation and what it is applied to, and from nothing else. The same operation on the same values always gives the same quantity, or always none.";
    ensure missing_is_told = "An operation is applied to the value of each of its arguments, or to none where that argument has no value: what to give then is the operation's to say.";
}

subject value {
    require applied = Applies::applied_alone;
    require missing = Applies::missing_is_told;

    ensure one_value = "An expression has at most one value at given inputs: the same expression and inputs always give the same value, or none.";
    ensure typed = "Every value has one type. An operation is applied only to values of the types it takes, and what it gives has the type it says: an expression that checks gives only values of the type it checks as.";
    ensure alone = "A value comes from its expression, its inputs and what applies its operations, and from nothing else: no evidence, no voice and no setting changes it.";
    ensure quantity_is_a_reading = "What a quantity is, is not said here. Each kind of quantity has what applies the operations on it, and each is one reading of the same expressions: exact, by bounds, or another. What applies them may lack an operation: the expression then has no value in that reading, which says the reading is unknown and nothing more.";
    ensure nothing_built_in = "No type and no operation is built in. Every operation an expression applies is declared: its name, the types it takes, the type it gives. A quantity is not read here: only what applies an operation knows what is inside.";

    // Same types in and out, it transforms; another type out, it converts.
    record Operation {
        name: String,
        takes: List<Type>,
        gives: Type,
    }

    enum Expression<Q> {
        // A value as it is.
        Given(v: Value<Q>),
        // A named input of a type.
        Input(name: String, of: Type),
        // An operation on what the others give.
        Apply(op: Operation, args: List<Expression<Q>>)
    }

    fn type_of<Q>(v: Value<Q>) -> Type { v.of }
    // The type an expression gives. `None` when it does not check: an
    // operation applied to what it does not take.
    fn check<Q>(e: Expression<Q>) -> Option<Type>;
    // The value of an expression at these inputs. `None` when it has
    // none: an input not given or of another type, an operation on what
    // it does not take, or one that `by` gives nothing for. An
    // argument with no value is passed on as none: `by` says what the
    // operation gives then.
    fn eval<Q>(e: Expression<Q>, inputs: List<(String, Value<Q>)>, by: impl Applies<Operation, Value<Q>, Q>) -> Option<Value<Q>>
        uses Applies::apply;

    // What always holds.
    claim same_value = deterministic(value::eval);
    claim given_is_itself(v: Value<Any>, by: impl Applies<Operation, Value<Any>, Any>) {
        value::eval(Given(v), [], by) == Some(v)
    }
    claim input_is_what_was_given(v: Value<Any>, by: impl Applies<Operation, Value<Any>, Any>) {
        value::eval(Input("x", v.of), [("x", v)], by) == Some(v) && value::eval(Input("x", v.of), [], by) == None
    }
    claim checked_gives_its_type(e: Expression<Any>, by: impl Applies<Operation, Value<Any>, Any>) {
        match value::check(e) {
            None => true,
            Some(t) => match value::eval(e, [], by) {
                None => true,
                Some(v) => value::type_of(v) == t,
            },
        }
    }
    claim an_operation_takes_its_types(v: Value<Any>) {
        value::check(Apply(Operation("f", [Type("A")], Type("B")), [Given(Value(v.quantity, Type("A")))])) == Some(Type("B"))
            && value::check(Apply(Operation("f", [Type("A")], Type("B")), [Given(Value(v.quantity, Type("B")))])) == None
    }
    claim an_input_of_another_type_is_no_value(v: Value<Any>, by: impl Applies<Operation, Value<Any>, Any>) {
        v.of == Type("A") || value::eval(Input("x", Type("A")), [("x", v)], by) == None
    }
    claim a_name_means_nothing_here(v: Value<Any>) {
        value::check(Apply(Operation("+", [v.of], v.of), [Given(v)])) == Some(v.of)
    }
}
