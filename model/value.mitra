// The innermost part of Mitra, on the side of computing (src/value.rs).
//
// Reads: nothing. It does not know what a piece, an opinion or
// evidence is: nothing here is right or wrong, believed or signed.
//
//   value        a quantity with a type
//   type         what a value can be, known by its name
//   operation    declared on types: it takes values of some types and
//                gives one of a type, to transform or to convert
//   expression   nested operations that can be evaluated
//
// Nothing is built in. This file declares no type and no operation,
// and does not read a quantity: what applies an operation is given.
// The standard ones (a truth, a whole number, `+`, `==`, `if`,
// records) are in standard.mitra, beside the core.
//
// Left out on purpose: functions and calls, sets and ranges, lists,
// enums and `match`, generics and contracts, floats, and the numbers
// of the machine (docs/design/numbers.md).

import std::core::{Option};

// What applies operations: the standard table, or a model's own. It
// is declared before the types it speaks of, so they are named here:
// an operation `O` on values `V` gives a quantity `Q`.
contract Applies<O, V, Q> {
    fn apply(&self, op: O, args: List<V>) -> Option<Q>;
    ensure applied_alone = "What an operation gives comes from the operation and the values it is applied to, and from nothing else: the same ones always give the same quantity, or none.";
}

subject value {
    require applied = Applies::applied_alone;

    ensure one_value = "An expression has at most one value at given inputs: the same expression and inputs always give the same value, or none.";
    ensure typed = "Every value has one type. An operation is applied only to values of the types it takes, and what it gives has the type it says: an expression that checks gives only values of the type it checks as.";
    ensure alone = "A value comes from its expression, its inputs and what applies its operations, and from nothing else: no evidence, no voice and no setting changes it.";
    ensure nothing_built_in = "No type and no operation is built in. Every operation an expression applies is declared: its name, the types it takes, the type it gives. A quantity is not read here: only what applies an operation knows what is inside.";

    record Type {
        name: String,
    }

    // How much, or which. Not read here.
    record Quantity;

    record Value {
        quantity: Quantity,
        of: Type,
    }

    // Same types in and out, it transforms; another type out, it converts.
    record Operation {
        name: String,
        takes: List<Type>,
        gives: Type,
    }

    enum Expression {
        // A value as it is.
        Given(v: Value),
        // A named input of a type.
        Input(name: String, of: Type),
        // An operation on what the others give.
        Apply(op: Operation, args: List<Expression>)
    }

    fn type_of(v: Value) -> Type { v.of }
    // The type an expression gives. `None` when it does not check: an
    // operation applied to what it does not take.
    fn check(e: Expression) -> Option<Type>;
    // The value of an expression at these inputs. `None` when it has
    // none: an input not given or of another type, an operation on what
    // it does not take, or one that `by` gives nothing for.
    fn eval(e: Expression, inputs: List<(String, Value)>, by: impl Applies<Operation, Value, Quantity>) -> Option<Value>
        uses Applies::apply;

    // one_value, alone
    claim same_value = deterministic(eval);
    claim given_is_itself(v: Value, by: impl Applies<Operation, Value, Quantity>) {
        eval(Given(v), [], by) == Some(v)
    }
    claim input_is_what_was_given(v: Value, by: impl Applies<Operation, Value, Quantity>) {
        eval(Input("x", v.of), [("x", v)], by) == Some(v) && eval(Input("x", v.of), [], by) == None
    }

    // typed
    claim checked_gives_its_type(e: Expression, by: impl Applies<Operation, Value, Quantity>) {
        match check(e) {
            None => true,
            Some(t) => match eval(e, [], by) {
                None => true,
                Some(v) => type_of(v) == t,
            },
        }
    }
    claim an_operation_takes_its_types(v: Value) {
        check(Apply(Operation("f", [Type("A")], Type("B")), [Given(Value(v.quantity, Type("A")))])) == Some(Type("B"))
            && check(Apply(Operation("f", [Type("A")], Type("B")), [Given(Value(v.quantity, Type("B")))])) == None
    }
    claim an_input_of_another_type_is_no_value(v: Value, by: impl Applies<Operation, Value, Quantity>) {
        v.of == Type("A") || eval(Input("x", Type("A")), [("x", v)], by) == None
    }

    // nothing_built_in: `+` is a name like any other. It checks on
    // whatever types its declaration says.
    claim a_name_means_nothing_here(v: Value) {
        check(Apply(Operation("+", [v.of], v.of), [Given(v)])) == Some(v.of)
    }
}
