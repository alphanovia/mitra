// The seam between the two sides. A claim is a statement that says an
// expression; computing it at an input makes evidence about the claim
// at that input. The only file that reads both model.mitra and
// value.mitra.
//
// Code: src/claim.rs.

import std::core::{Option};

subject claims {
    require said = statement::statement_is_an_interpretation;
    require believed = evidence::evidence_is_a_piece;
    require yes_and_no = piece::opinion_is_counts;
    require computed = value::one_value;
    require truth = standard::applied_as_written;
    require applied = Applies::applied_alone;
    require complete = tie::completeness_is_implied;
    require all = model::whole_is_all_its_parts;
    require shared = model::no_is_shared;
    require sure = bounds::sure_is_everywhere;
    require held = bounds::bounds_hold_the_exact;

    ensure claim_is_a_truth = "A claim is a statement that says an expression. The expression gives a truth, the standard one; one that gives anything else states nothing.";
    ensure instance_is_a_piece = "A claim at given inputs is a piece derived from the claim: at these inputs, what the claim says is so. It is named after the claim and the inputs, so the same claim at the same inputs is one piece. The inputs are exact values, or the ranges they lie in.";
    ensure observed_is_evidence = "Computing a claim at given inputs gives evidence about the claim at those inputs and no other piece: yes where it is true, no where it is false, and no evidence where it has no value.";
    ensure a_range_is_many_points = "Reading a claim by bounds, with each input known to lie in a range, is evidence about the claim over those ranges: yes where the claim is true everywhere in them, no where it is false everywhere, and no evidence where it may be either, may fault, or the reading is unknown. It says as many yes or no as it is given: how many observations a whole range is worth is said by who asks, and nothing here holds a value for it.";
    ensure recorded_through_the_tie = "An observation made at the place of a tie is recorded as evidence about three pieces together: the tie, the claim at those inputs, and the tie's completeness. So a yes supports all three and a no is shared between them. A tie that does not list the claim records nothing. With no tie, the observation is about the claim at those inputs alone.";
    // After Gaudel, 1995, "Testing Can Be Formal, Too": the uniformity
    // hypothesis is what lets finitely many observations stand for a
    // claim on every input. Departs: the hypothesis is a piece,
    // believed more or less, where the paper assumes it; and it is
    // given by who records, with nothing here saying what it covers.
    // The discount is that of a voice's reliability: Jøsang, 2016,
    // "Subjective Logic", trust discounting.
    ensure uniform_discounts = "Nothing leads from a claim at one input to the claim itself, unless who records gives one more piece, uniform: the inputs observed stand for all inputs. Then each observation is also evidence about the claim itself, a yes as a yes and a no as a no, counted as far as the observation and uniform are both believed: uniform is to an observation what reliability is to a voice. It reaches the claim through the tie like the instance does.";
    ensure one_way = "Evidence is made from a value; no value is made from evidence or from an opinion.";

    // What a claim says. A claim is a statement with this content.
    record Claim {
        expression: value::Expression<standard::Exact>,
    }

    // The expression gives a truth.
    fn reads(s: statement::Statement<Claim>) -> Bool
        uses value::check, standard::truth;

    // The claim at these inputs: a piece derived from the claim.
    fn instance<Q>(s: statement::Statement<Claim>, inputs: List<(String, Value<Q>)>) -> piece::Piece;

    // What computing the claim at these inputs says of that instance.
    // `with` applies its operations.
    fn observe(s: statement::Statement<Claim>, inputs: List<(String, Value<standard::Exact>)>, by: evidence::Voice, with: impl Applies<value::Operation, Value<standard::Exact>, standard::Exact>) -> Option<evidence::Evidence>
        uses only instance, value::eval, standard::truth, piece::yes, piece::no;

    // What reading the claim by bounds says of its instance over these
    // ranges: `count` yes or `count` no, or nothing.
    fn bounded(s: statement::Statement<Claim>, ranges: List<(String, Value<bounds::Bounds>)>, count: Float64, by: evidence::Voice, with: impl Applies<value::Operation, Value<bounds::Bounds>, bounds::Bounds>) -> Option<evidence::Evidence>
        uses instance, value::eval, bounds::lifted, bounds::surely, piece::yes, piece::no;

    // The model with an observation of the claim in it. `e` is
    // evidence about an instance of `s`. With a tie, it is recorded
    // through it; with `uniform`, it is also evidence about the claim
    // itself, discounted by that piece. `None` when the tie does not
    // list the claim.
    fn recorded(model: model::Model, s: statement::Statement<Claim>, e: evidence::Evidence, at: Option<tie::Tie>, uniform: Option<piece::Piece>) -> Option<model::Model>;

    // What always holds.
    claim a_number_is_not_a_statement(p: piece::Piece) {
        !claims::reads(Statement(p, Claim(Given(standard::number(1))))) && claims::reads(Statement(p, Claim(Given(standard::yes()))))
    }
    claim true_says_yes(p: piece::Piece) {
        match claims::observe(Statement(p, Claim(Given(standard::yes()))), [], Voice("machine:mitra"), Table([])) {
            None => false,
            Some(e) => e.value == piece::yes() && e.by == Voice("machine:mitra"),
        }
    }
    claim false_says_no(p: piece::Piece) {
        match claims::observe(Statement(p, Claim(Given(standard::no()))), [], Voice("machine:mitra"), Table([])) {
            None => false,
            Some(e) => e.value == piece::no(),
        }
    }
    claim no_value_says_nothing(p: piece::Piece) {
        claims::observe(Statement(p, Claim(Input("x", standard::truth()))), [], Voice("machine:mitra"), Table([])) == None
    }
    claim an_observation_is_about_an_instance(s: statement::Statement<Claim>) {
        match claims::observe(s, [], Voice("machine:mitra"), Table([])) {
            None => true,
            Some(e) => e.about == instance(s, []) && e.about != s.piece,
        }
    }
    claim a_tie_that_does_not_list_it_records_nothing(m: model::Model, s: statement::Statement<Claim>, e: evidence::Evidence, t: piece::Piece) {
        recorded(m, s, e, Some(Tie(t, [], Place(["ball"]))), None) == None
    }
    claim without_uniform_nothing_leads_to_the_claim(m: model::Model, s: statement::Statement<Claim>, e: evidence::Evidence) {
        match recorded(m, s, e, None, None) {
            None => false,
            Some(after) => after.related == m.related,
        }
    }
    claim a_sure_claim_says_its_count(p: piece::Piece, by: evidence::Voice, with: bounds::Ranges) {
        match bounded(Statement(p, Claim(Given(standard::yes()))), [], 10.0, by, with) {
            None => false,
            Some(e) => e.about != p && e.value.r == 10.0 && e.value.s == 0.0,
        }
    }
    claim an_unknown_reading_says_nothing(p: piece::Piece, by: evidence::Voice, with: bounds::Ranges) {
        bounded(Statement(p, Claim(Apply(standard::equal(standard::whole()), [Given(standard::number(1)), Given(standard::number(1))]))), [], 10.0, by, with) == None
    }
}
