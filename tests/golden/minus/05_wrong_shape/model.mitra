fn plus(a: Int, b: Int) -> Int { a + b }
fn opposite(b: Int) -> Int { -b }
fn difference(a: Int, b: Int) -> Int { a - b }

fn add(a: Int, b: Int) -> Int;
fn negate(b: Int) -> Int;
fn minus(a: Int, b: Int) -> Int;

// add, on the inputs minus uses.
claim add_spec(a: 0..=2, b: -2..=0) { add(a, b) == plus(a, b) }
claim negate_spec(b: 0..=2) { negate(b) == opposite(b) }
// A wrong shape: the arguments are swapped.
claim minus_shape(a: 0..=2, b: 0..=2) { minus(a, b) == add(b, negate(a)) }
// Judged from the outputs: observed, or worked out from a vouched shape.
claim minus_spec(a: 0..=2, b: 0..=2) { minus(a, b) == difference(a, b) } 
