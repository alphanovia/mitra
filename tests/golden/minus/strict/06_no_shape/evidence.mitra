-- Without the shape the implication is unchecked, and taken as stated.
evidence add 0 (-2) = -2 at 1
evidence add 0 (-1) = -1 at 1
evidence add 0 0 = 0 at 1
evidence add 1 (-2) = -1 at 1
evidence add 1 (-1) = 0 at 1
evidence add 1 0 = 1 at 1
evidence add 2 (-2) = 0 at 1
evidence add 2 (-1) = 1 at 1
evidence add 2 0 = 2 at 1
evidence negate 0 = 0 at 1
evidence negate 1 = -1 at 1
evidence negate 2 = -2 at 1
