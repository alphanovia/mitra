# Same leaves, but the shape gives b - a: the implication is refuted.
evidence add(0, -2) -> -2 @ 1
evidence add(0, -1) -> -1 @ 1
evidence add(0, 0) -> 0 @ 1
evidence add(1, -2) -> -1 @ 1
evidence add(1, -1) -> 0 @ 1
evidence add(1, 0) -> 1 @ 1
evidence add(2, -2) -> 0 @ 1
