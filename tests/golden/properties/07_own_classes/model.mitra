import std::claims::{uniform};
// Two subjects whose classes can't all meet: (big, zero) never happens.
fn half(x: Int) -> Int;
fn sign(x: Int) -> Int;
fn half_class(x: Int) -> {"small", "big"} { if x < 100 && x > -100 { "small" } else { "big" } }
fn sign_class(x: Int) -> {"neg", "zero", "pos"} { if x < 0 { "neg" } else { if x == 0 { "zero" } else { "pos" } } }
claim half_uniform = uniform(half, half_class);
claim sign_uniform = uniform(sign, sign_class);
claim half_keeps_sign(x) { sign(half(x) * 2) == sign(x) || half(x) == 0 }
claim same_sign(x) { sign(x) * half(x) >= 0 }
claim same_sign_uniform = uniform(same_sign, sign_class);
