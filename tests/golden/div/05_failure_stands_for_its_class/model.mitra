import std::claims::{uniform};
// A division: the developer assumes it behaves the same on every input,
// except when dividing by zero.
fn div(a: Int, b: Int) -> Int;
fn div_class(a: Int, b: Int) -> {"zero", "rest"} { if b == 0 { "zero" } else { "rest" } }

claim div_correct(a, b) { correct(div(a, b)) }
claim div_small(a: 0..=1, b: 1..=2) { correct(div(a, b)) }
claim div_uniform = uniform(div, div_class);
