-- The trace of one test, written by hand: one line for each call it made.
-- Rust: a.deposit(5); assert!(a.withdraw(3)); assert!(!a.withdraw(7));
@[source "test:t_seq"] evidence deposit(Account(0, true), 5) = Account(5, true) at 1
@[source "test:t_seq"] evidence withdraw(Account(5, true), 3) = (Account(2, true), true) at 1
@[source "test:t_seq"] evidence withdraw(Account(2, true), 7) = (Account(2, true), false) at 1
@[source "review"] evidence withdraw_uniform at 1
