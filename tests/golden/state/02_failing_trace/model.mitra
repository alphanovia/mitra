import std::claims::{uniform};
// `&mut self` is one more input and one more output: the state is a value.
record Account { balance: 0.., open: Bool }
subject fn deposit(a: Account, n: 0..) -> Account;
subject fn withdraw(a: Account, n: 0..) -> (Account, Bool);
fn deposit_spec(a: Account, n: 0..) -> Account {
  if a.open { Account(a.balance + n, true) } else { a } }
fn withdraw_spec(a: Account, n: 0..) -> (Account, Bool) {
  if a.open && n <= a.balance { (Account(a.balance - n, true), true) } else { (a, false) } }
claim deposit_is(a, n) { deposit(a, n) == deposit_spec(a, n) }
claim withdraw_is(a, n) { withdraw(a, n) == withdraw_spec(a, n) }
fn account_class(a: Account, n: 0..) -> {"closed", "covered", "overdraw"} {
  if !a.open { "closed" } else { if n <= a.balance { "covered" } else { "overdraw" } } }
claim withdraw_uniform = uniform(withdraw, account_class);
// An invariant, written by hand: one claim for each function.
claim withdraw_keeps_open(a, n) { withdraw(a, n).0.open == a.open }
