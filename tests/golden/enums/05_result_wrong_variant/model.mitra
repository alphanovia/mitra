enum Result(T, E) { Ok(value: T), Err(error: E) }
opaque sub(a: 0..=9, b: 0..=9) -> Result(0..=9, String)
def sub_spec(a: 0..=9, b: 0..=9) -> Result(0..=9, String) := if a < b then Err("underflow") else Ok(a - b)
def sub_class(a: 0..=9, b: 0..=9) -> Bool := a < b
claim sub_is : forall a, forall b, sub(a, b) = sub_spec(a, b)
claim sub_uniform : uniform sub by sub_class
