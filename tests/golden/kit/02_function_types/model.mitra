// A function type holds the functions declared above that fit; the name
// of a function is a value.
fn double(x: Int) -> Int { x * 2 }
fn negate(x: Int) -> Int { 0 - x }
fn shout(s: String) -> String { s }
subject fn parse(s: String) -> Int;
fn twice(f: fn(Int) -> Int, x: Int) -> Int { f(f(x)) }
fn each<T, U>(xs: List<T>, f: fn(T) -> U) -> List<U> { map(x in xs, f(x)) }
subject fn apply(f: fn(Int) -> Int, x: Int) -> Int;
subject fn retry(op: fn() -> Int, times: 1..=3) -> Int;
claim apply_is(f, x) { apply(f, x) == f(x) }
claim c() { twice(double, 3) == 12 && each([1, 2], negate) == [-1, -2] && each(["a"], shout) == ["a"] }
claim parse_each() { each(["1", "2"], parse) == [1, 2] }
