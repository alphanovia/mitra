-- A function type holds the functions declared above that fit; the name
-- of a function is a value.
def double(x: Int) -> Int := x * 2
def negate(x: Int) -> Int := 0 - x
def shout(s: String) -> String := s
opaque parse(s: String) -> Int
def twice(f: (Int) -> Int, x: Int) -> Int := f(f(x))
def each(T, U)(xs: List(T), f: (T) -> U) -> List(U) := map(x in xs, f(x))
opaque apply(f: (Int) -> Int, x: Int) -> Int
opaque retry(op: () -> Int, times: 1..=3) -> Int
claim apply_is : forall f, forall x, apply(f, x) = f(x)
claim c : twice(double, 3) == 12 && each([1, 2], negate) == [-1, -2] && each(["a"], shout) == ["a"]
claim parse_each : each(["1", "2"], parse) == [1, 2]
