import std::claims::{uniform};
// A type may contain itself, and a spec may call itself on a piece of
// its input.
enum Expr { Lit(n: Int), Add(l: Expr, r: Expr), Neg(e: Expr) }
fn value(e: Expr) -> Int {
  match e { Lit(n) => n, Add(l, r) => value(l) + value(r), Neg(x) => 0 - value(x) } }
fn shape(e: Expr) -> {"literal", "sum", "negation"} {
  match e { Lit(n) => "literal", Add(l, r) => "sum", Neg(x) => "negation" } }
subject fn eval(e: Expr) -> Int;
claim eval_is(e) { eval(e) == value(e) }
claim eval_uniform = uniform(eval, shape);
