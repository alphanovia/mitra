// `quarter` calls `half` twice: when both fail, `half` is where to look.
subject fn half(x: Int) -> Int;
subject fn quarter(x: Int) -> Int uses half;
subject fn eighth(x: Int) -> Int uses quarter;

claim half_correct(x: 0..=1) { correct(half(x)) }
claim quarter_correct(x: 0..=1) { correct(quarter(x)) }
claim eighth_correct(x: 0..=1) { correct(eighth(x)) }
