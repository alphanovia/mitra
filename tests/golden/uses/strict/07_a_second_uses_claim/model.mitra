-- Two claims on what `quarter` uses: the second, not vouched for, names
-- `eighth`, which no claim covers.
opaque half (x : Int) : Int
opaque quarter (x : Int) : Int
opaque eighth (x : Int) : Int

claim half_correct : forall x in 0..=1, correct (half x)
claim quarter_correct : forall x in 0..=1, correct (quarter x)
claim quarter_uses : only uses quarter [half]
claim quarter_also : uses quarter [eighth]

policy strict
