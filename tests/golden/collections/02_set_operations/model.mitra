-- Sets as values: no order, no repeats.
opaque tags(xs: List(String)) -> Set(String)
def tags_class(xs: List(String)) -> {"none", "some"} := if len(xs) == 0 then "none" else "some"
claim tags_uniform : uniform tags by tags_class
claim tags_small : forall xs, len(tags(xs)) <= len(xs)
claim tags_from_list : forall xs, len(xs) == 0 || xs[0] in tags(xs)
claim algebra : {1, 2} | {2, 3} == {3, 2, 1} && {1, 2} & {2, 3} == {2} && {1, 2} \ {2} == {1}
  && !(4 in {1, 2}) && 2 in [1, 2] && len({1, 1, 1}) == 1 && len({:}) == 0
