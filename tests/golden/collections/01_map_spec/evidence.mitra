evidence e { for add_stock given stock = {"nut": 2}, item = "nut", n = 3 gives {"nut": 5} }
evidence e { for add_stock given stock = {:}, item = "bolt", n = 1 gives {"bolt": 1} }
// The order written does not matter; the count of nuts is wrong.
evidence e { for add_stock given stock = {"nut": 2, "bolt": 1}, item = "bolt", n = 1 gives {"bolt": 2, "nut": 3} }
evidence e { for remove given stock = {"nut": 2, "bolt": 1}, gone = {"nut", "x"} gives {"bolt": 1} }
