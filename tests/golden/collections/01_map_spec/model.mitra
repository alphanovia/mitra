-- A stock: how many of each item. A map is a value, like a list.
opaque add_stock(stock: Map(String, 0..), item: String, n: 0..) -> Map(String, 0..)
def add_spec(stock: Map(String, 0..), item: String, n: 0..) -> Map(String, 0..) :=
  stock | {item: (if item in stock then stock[item] else 0) + n}
claim add_is : forall stock, forall item, forall n, add_stock(stock, item, n) = add_spec(stock, item, n)
claim add_keeps_items : forall stock, forall item, forall n,
  keys(add_stock(stock, item, n)) == keys(stock) | {item}
opaque remove(stock: Map(String, 0..), gone: Set(String)) -> Map(String, 0..)
claim remove_is : forall stock, forall gone, remove(stock, gone) = stock \ gone
