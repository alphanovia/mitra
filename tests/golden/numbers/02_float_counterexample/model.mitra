// Integer types and ranges, and 64-bit floats.
subject fn inc(x: Int64) -> Int64;
fn halve(x: Float64) -> Float64 { x * 0.5 }
subject fn half(x: Float64) -> Float64;

// inc is correct on every 64-bit integer: tests can't cover that.
claim inc_correct(x) { correct(inc(x)) }
// On the small ones, `0..100` leaves 100 out.
claim inc_small(x: 0..100) { correct(inc(x)) }
// half matches halve on two inputs.
claim half_spec(x: {1.0, -3.0}) { half(x) == halve(x) }
