// The dogfood store: reviews of the dogfood model (src/*.mitra; flagged
// dogfood report). A test measures and never reviews (the user's rule,
// 2026-11-24): an ensure in words is reviewed by the agent that read
// it, seeing the tests that show it; `mitra explain` runs `cargo test`
// and drops a review whose test did not pass (R008). A name two test
// files share is written with its file, `tests/model.rs::each_error_is_found`.
// A tie, and a claim shown by hand, is reviewed by the agent that
// checked it.

// Ensures, each seeing the passing tests that check it.
review num::exact holds by "agent:anthropic/opus-5.5/dogfood" seeing "test:a_sum_of_small_reals_is_exact";
review float::near holds by "agent:anthropic/opus-5.5/dogfood" seeing "test:dogfood_fused";
review location::prefix holds by "agent:anthropic/opus-5.5/dogfood" seeing "test:a_place_is_within_what_its_path_goes_on_from";
review expression::binding holds by "agent:anthropic/opus-5.5/dogfood" seeing "test:binding";
review expression::substitution holds by "agent:anthropic/opus-5.5/dogfood" seeing "test:substitution";
review simulation::exact_right holds by "agent:anthropic/opus-5.5/dogfood" seeing "test:exact_preserves_progresses_and_is_determined";
review simulation::ranges_sound holds by "agent:anthropic/opus-5.5/dogfood" seeing "test:exact_lies_in_ranges";
