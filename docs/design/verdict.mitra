// PROPOSAL, no code yet. An opinion is a logical state and a
// confidence in it. The state is found first, by logic alone, from
// the evidence taken as true. Confidence is counted after, and only
// says how much evidence stands behind a state. Pieces, evidence,
// statements, ties, voices and settings stay as in model.mitra; the
// rules below replace how an opinion is computed.

subject verdict {
    require pieces = piece::everything_is_a_piece;
    require said = evidence::evidence_is_a_piece;
    require counts = piece::opinion_is_counts;
    require whole = tie::a_tie_has_a_whole;
    require instances = claims::instance_is_a_piece;
    require through = claims::recorded_through_the_tie;

    // After Belnap, 1977, "A Useful Four-Valued Logic": the four
    // states, and that told-true and told-false together is a state
    // of its own and not an error.
    ensure a_state_is_one_of_four = "The state of a piece is one of four: unknown, nothing says anything of it; true; false; conflict, it was found both true and false.";
    ensure evidence_starts_true = "Every piece of evidence starts true: what was reported is taken as it was said, until something says otherwise. No other piece starts with a state.";
    ensure states_spread_by_six_rules = "A state spreads by these rules and no other, until none of them gives anything new. One: evidence that is true and says yes makes the piece it is about true; says no, false. Two: a whole that is true makes each of its parts true. Three: a whole whose parts are all true is true, and a whole with a false part is false. Four: a whole that is false, with every part true but one, makes that one false. Five: a claim that is true is true at every input observed, and a claim false at one input is false. Six: a claim true at one input, with its uniform true, is true. The order the rules are applied in changes nothing.";
    ensure a_test_goes_through_the_tie = "A test speaks of a whole: the tie, the claim at that input and the tie's completeness. So one passing test makes all three true by rule two, and one failing test, where the tie and its completeness are true, makes the claim false at that input by rule four and the claim false by rule five.";
    ensure the_verdict_is_read_from_the_states = "The verdict of a model is read from its statements: conflict if one is in conflict; else fails if one is false; else unknown if one is unknown, whatever the others are; else holds.";
    ensure confidence_comes_after = "Confidence is counted only for a state that was found, and it never changes a state. A report counts as far as its piece and its voice are believed, as today. Reports that lead to the same state by different ways add up. Along one way, a state is only as sure as the least sure thing it was drawn from. The confidence of a verdict that holds is that of its least sure statement.";
    // After Reiter, 1987, "A Theory of Diagnosis from First
    // Principles", and de Kleer and Williams, 1987, "Diagnosing
    // Multiple Faults": the smallest sets of assumptions to give up,
    // ranked by how likely each is wrong.
    ensure a_conflict_names_its_suspects = "Two things are marked. A piece in conflict, with every piece of evidence either state was drawn from. And a whole that is false with more than one part not known true: its parts not known true cannot all be true. For each, the smallest sets of pieces that would remove it if given up are listed, the least sure first: what stands on the least evidence is the first suspect.";

    enum State { Unknown, True, False, Conflict }
    // Would replace `piece::Opinion`: a state, and the counts that say
    // how sure it is.
    record Verdict {
        state: State,
        confidence: piece::Opinion,
    }

    // Both said of one piece: the same if they agree, the other if one
    // is unknown, conflict otherwise.
    fn joined(x: State, y: State) -> State;
    // The state of every piece once no rule gives anything new.
    fn spread(model: model::Model) -> List<(piece::Piece, State)>
        uses joined, model::parts;
    // The verdict of the model.
    fn overall(model: model::Model) -> State
        uses spread;
    // How sure the state of a piece is. Nothing for an unknown piece.
    fn confidence(model: model::Model, x: piece::Piece) -> Option<piece::Opinion>
        uses spread;
    // The sets of suspects, the least sure first.
    fn suspects(model: model::Model) -> List<List<piece::Piece>>
        uses spread, confidence;

    claim joined_keeps_what_agrees(x: State) {
        joined(x, x) == x && joined(x, Unknown) == x && joined(Unknown, x) == x
    }
    claim true_and_false_is_a_conflict() {
        joined(True, False) == Conflict && joined(False, True) == Conflict
    }
    claim a_conflict_stays(x: State) {
        joined(Conflict, x) == Conflict
    }
    claim nothing_said_is_unknown(m: model::Model) {
        m.evidence != [] || spread(m) == []
    }
}
