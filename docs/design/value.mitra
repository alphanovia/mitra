// value.mitra: the innermost part of Mitra, on the side of computing.
// A proposal to read: no code is tied to it and it is in no store.
//
// Reads: nothing. It does not know what a piece, an opinion or
// evidence is: nothing here is right or wrong, believed or signed.
//
// Three things, and nothing else:
//
//   value        what is computed: a truth, a whole number, a record
//   type         what a value can be
//   expression   what computes a value from named inputs
//
// Left out on purpose: functions and calls, sets and ranges, lists,
// enums and `match`, generics and contracts, floats, and the numbers
// of the machine (docs/design/numbers.md).

import std::core::{Option};

subject value {
    ensure one_value = "An expression has at most one value at given inputs: the same expression and inputs always give the same value, or none.";
    ensure typed = "Every value has one type, and an expression that checks gives only values of the type it checks as.";
    ensure alone = "A value comes from its expression and its inputs alone: no evidence, no voice and no setting changes it.";

    enum Type {
        OfTruth,
        OfNumber,
        OfShape(name: String, fields: List<Type>)
    }

    enum Value {
        Truth(b: Bool),
        Number(n: Int),
        Made(name: String, fields: List<Value>)
    }

    enum Expression {
        // What is written as it is: `true`, `false`, `42`.
        Yes,
        No,
        Literal(n: Int),
        // A record made of what the others give.
        Make(name: String, fields: List<Expression>),
        // A named input.
        Input(name: String),
        // A field of a record, by its place.
        Field(record: Expression, place: Nat),
        // `!`, `&&`, `==`, `<`, `+`, `-`, `*` on what the others give.
        Op(op: String, args: List<Expression>),
        If(test: Expression, yes: Expression, no: Expression)
    }

    fn type_of(v: Value) -> Type;
    // The type an expression gives when its inputs have these types.
    // `None` when it does not check.
    fn check(e: Expression, inputs: List<(String, Type)>) -> Option<Type>;
    // The value of an expression at these inputs. `None` when it has none:
    // an input not given, a field that is not there, a number too large.
    fn eval(e: Expression, inputs: List<(String, Value)>) -> Option<Value>;

    // one_value, alone
    claim same_value = deterministic(eval);
    claim literal_is_itself(n: Int) {
        eval(Literal(n), []) == Some(Number(n)) && eval(Yes, []) == Some(Truth(true)) && eval(No, []) == Some(Truth(false))
    }
    claim input_is_what_was_given(v: Value) {
        eval(Input("x"), [("x", v)]) == Some(v) && eval(Input("x"), []) == None
    }

    // typed
    claim checked_gives_its_type(e: Expression) {
        match check(e, []) {
            None => true,
            Some(t) => match eval(e, []) {
                None => true,
                Some(v) => type_of(v) == t,
            },
        }
    }
    claim truth_is_not_a_number() {
        type_of(Truth(true)) == OfTruth && type_of(Number(0)) == OfNumber && check(Op("+", [Yes, Literal(1)]), []) == None
    }
}
